{"original": "ئەگەر پلەی گەرمی تەلەکە بەرزبێتەوە تا پلەی درەوشانەوە، ئەوا رووناکیشی لێ دەردەچێت. واتە کاتێک تەزووی کارەبا بە تەلێکی گەیەنەر دادەڕوات دەبێ چاوەڕێی ئەوە بکرێت کە تەلەکە لەئەنجامی ئەم بەرکەوتنانە گەرم دەبێت و بەرگریەکەشی زیاد دەبێت.", "corrupted": "ئەگەڕ پلەی گەرمی تەڵەکە بەرزبێتەوە تا پلەی دڕەوشانەوە، ئەوا ڕووناکیشی لێ دەردەچێت. واتە کاتێک تەزووی کارەبا بە تەلێکی گەیەنەر دادەڕوات دەبێ چاوەڕێی ئەوە بکرێت کە تەلەکە ڵەئەنجامی ئەم بەرکەوتنانە گەرم دەبێت و بەرگریەکەشی زیاد دەبێت.", "source": "ئەگەڕ پلەی گەرمی تەڵەکە بەرزبێتەوە تا پلەی دڕەوشانەوە، ئەوا ڕووناکیشی لێ دەردەچێت. واتە کاتێک تەزووی کارەبا بە تەلێکی گەیەنەر دادەڕوات دەبێ چاوەڕێی ئەوە بکرێت کە تەلەکە ڵەئەنجامی ئەم بەرکەوتنانە گەرم دەبێت و بەرگریەکەشی زیاد دەبێت.", "target": "ئەگەر پلەی گەرمی تەلەکە بەرزبێتەوە تا پلەی درەوشانەوە، ئەوا رووناکیشی لێ دەردەچێت. واتە کاتێک تەزووی کارەبا بە تەلێکی گەیەنەر دادەڕوات دەبێ چاوەڕێی ئەوە بکرێت کە تەلەکە لەئەنجامی ئەم بەرکەوتنانە گەرم دەبێت و بەرگریەکەشی زیاد دەبێت.", "errors": [{"type": "spelling_confusion", "original": "لەئەنجامی", "error": "ڵەئەنجامی", "start": 169, "end": 178, "description": "spelling_confusion: 'لەئەنجامی' → 'ڵەئەنجامی'"}, {"type": "spelling_confusion", "original": "رووناکیشی", "error": "ڕووناکیشی", "start": 60, "end": 69, "description": "spelling_confusion: 'رووناکیشی' → 'ڕووناکیشی'"}, {"type": "spelling_confusion", "original": "درەوشانەوە،", "error": "دڕەوشانەوە،", "start": 43, "end": 54, "description": "spelling_confusion: 'درەوشانەوە،' → 'دڕەوشانەوە،'"}, {"type": "spelling_confusion", "original": "تەلەکە", "error": "تەڵەکە", "start": 17, "end": 23, "description": "spelling_confusion: 'تەلەکە' → 'تەڵەکە'"}, {"type": "spelling_confusion", "original": "ئەگەر", "error": "ئەگەڕ", "start": 0, "end": 5, "description": "spelling_confusion: 'ئەگەر' → 'ئەگەڕ'"}], "source_id": "1571", "category": "sciences"}
