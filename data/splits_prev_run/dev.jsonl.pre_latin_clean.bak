{"original": "تەنانەت بە بەراورد لەگەڵ ناوچەکانی تری دەوروبەر پێشکەوتنی زیاتریان بەخۆوە بینی. ئەو گەڕیدەو گەشتیارە بیانیانەی لەو سەردەمەدا بەکوردستاندا گەڕاون، تێبینی هەندێ لەو لایەنانەیان کردووە وتەنانەت هەندێ جار پێی سەرسام بوون.", "corrupted": "تەنانەت بە بەراورد لەگەڵ ناوچەکانی تری دەوروبەر پێشکەوتنی زیاتریان بەخۆوە بێنی. ئەو گەڕیدەو گەشتیارە بیانیانەی لەو سەردەمەدا بەکوردستاندا گەڕاون، تێبینی هەندێ لەو لایەنانەیان کردووە وتەنانەت هەندی جار پێی سەرسام بوون.", "source": "تەنانەت بە بەراورد لەگەڵ ناوچەکانی تری دەوروبەر پێشکەوتنی زیاتریان بەخۆوە بێنی. ئەو گەڕیدەو گەشتیارە بیانیانەی لەو سەردەمەدا بەکوردستاندا گەڕاون، تێبینی هەندێ لەو لایەنانەیان کردووە وتەنانەت هەندی جار پێی سەرسام بوون.", "target": "تەنانەت بە بەراورد لەگەڵ ناوچەکانی تری دەوروبەر پێشکەوتنی زیاتریان بەخۆوە بینی. ئەو گەڕیدەو گەشتیارە بیانیانەی لەو سەردەمەدا بەکوردستاندا گەڕاون، تێبینی هەندێ لەو لایەنانەیان کردووە وتەنانەت هەندێ جار پێی سەرسام بوون.", "errors": [{"type": "orthography", "original": "هەندێ", "error": "هەندی", "start": 191, "end": 196, "description": "orthography: 'هەندێ' → 'هەندی'"}, {"type": "orthography", "original": "بینی.", "error": "بێنی.", "start": 74, "end": 79, "description": "orthography: 'بینی.' → 'بێنی.'"}], "source_id": "8605", "category": "social_sciences"}
