{"original": "ئەوەتا لە ئەمریکای باشوردا ی پێدەڵێن کە لەوەڕگایەکی زۆر بەناوبانگە، لە باکوری ئوسترالیاشدا هەیە، بەڵام جێگایەکی کەم و تەنگی لێ داپۆشیوە.", "corrupted": "ئەوەتا لە ئەمریکای باشوردا ی پێدەڵێن کە لەوەڕگایەکی زۆر بەناوبانگە، لە باکوری ئوسترالیاشدا هەیە، بەڵام جێگایەکی کەم و طەنگی لێ ضاپۆشیوە.", "source": "ئەوەتا لە ئەمریکای باشوردا ی پێدەڵێن کە لەوەڕگایەکی زۆر بەناوبانگە، لە باکوری ئوسترالیاشدا هەیە، بەڵام جێگایەکی کەم و طەنگی لێ ضاپۆشیوە.", "target": "ئەوەتا لە ئەمریکای باشوردا ی پێدەڵێن کە لەوەڕگایەکی زۆر بەناوبانگە، لە باکوری ئوسترالیاشدا هەیە، بەڵام جێگایەکی کەم و تەنگی لێ داپۆشیوە.", "errors": [{"type": "spelling_confusion", "original": "داپۆشیوە.", "error": "ضاپۆشیوە.", "start": 127, "end": 136, "description": "spelling_confusion: 'داپۆشیوە.' → 'ضاپۆشیوە.'"}, {"type": "spelling_confusion", "original": "تەنگی", "error": "طەنگی", "start": 118, "end": 123, "description": "spelling_confusion: 'تەنگی' → 'طەنگی'"}], "source_id": "9426", "category": "social_sciences"}
{"original": "هاوێنکۆیەکە لەسەر هەڵگرێک دابنێ، ئینجا گورزەیەکی تەسک لە تیشکی تەریب و نزیک لە تەوەری بنچینەیی لەخۆرەوە یان لەەەر سەرچاوەیەکی ترەوە ئاڕاستەی هاوێنکۆیەکە بکە. ئینجا تیشکە دەرچووەکان بخەرە سەر شاشەیەک و شوێنەکەی بگۆڕە تا وێنەیەکی بچووک و بریقەدارت دەست دەکەوێت.", "corrupted": "هاوێنکۆیەکە لەسەر هەڵگرێک ضابنێ، ئینجا گورزەیەکی تەسک لە تیشکی تەریب و نزیک لە طەوەری بنچینەیی لەخۆرەوە یان لەەەر سەرچاوەیەکی طرەوە ئاڕاستەی هاوێنکۆیەکە بکە. ئینجا تیشکە دەرچووەکان بخەڕە سەڕ شاشەیەک و شوێنەکەی بگۆڕە تا وێنەیەکی بچووک و بریقەدارت دەسط دەکەوێت.", "source": "هاوێنکۆیەکە لەسەر هەڵگرێک ضابنێ، ئینجا گورزەیەکی تەسک لە تیشکی تەریب و نزیک لە طەوەری بنچینەیی لەخۆرەوە یان لەەەر سەرچاوەیەکی طرەوە ئاڕاستەی هاوێنکۆیەکە بکە. ئینجا تیشکە دەرچووەکان بخەڕە سەڕ شاشەیەک و شوێنەکەی بگۆڕە تا وێنەیەکی بچووک و بریقەدارت دەسط دەکەوێت.", "target": "هاوێنکۆیەکە لەسەر هەڵگرێک دابنێ، ئینجا گورزەیەکی تەسک لە تیشکی تەریب و نزیک لە تەوەری بنچینەیی لەخۆرەوە یان لەەەر سەرچاوەیەکی ترەوە ئاڕاستەی هاوێنکۆیەکە بکە. ئینجا تیشکە دەرچووەکان بخەرە سەر شاشەیەک و شوێنەکەی بگۆڕە تا وێنەیەکی بچووک و بریقەدارت دەست دەکەوێت.", "errors": [{"type": "spelling_confusion", "original": "دەست", "error": "دەسط", "start": 246, "end": 250, "description": "spelling_confusion: 'دەست' → 'دەسط'"}, {"type": "spelling_confusion", "original": "سەر", "error": "سەڕ", "start": 187, "end": 190, "description": "spelling_confusion: 'سەر' → 'سەڕ'"}, {"type": "spelling_confusion", "original": "بخەرە", "error": "بخەڕە", "start": 181, "end": 186, "description": "spelling_confusion: 'بخەرە' → 'بخەڕە'"}, {"type": "spelling_confusion", "original": "ترەوە", "error": "طرەوە", "start": 126, "end": 131, "description": "spelling_confusion: 'ترەوە' → 'طرەوە'"}, {"type": "spelling_confusion", "original": "تەوەری", "error": "طەوەری", "start": 79, "end": 85, "description": "spelling_confusion: 'تەوەری' → 'طەوەری'"}, {"type": "spelling_confusion", "original": "دابنێ،", "error": "ضابنێ،", "start": 26, "end": 32, "description": "spelling_confusion: 'داب