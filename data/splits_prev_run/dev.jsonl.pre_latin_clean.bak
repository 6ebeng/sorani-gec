{"original": "دەوڵەت بەکاری دێنێت بۆ بڵاوکردنەوەی فەلسەفەی رامیاری و کۆمەڵایەتییەکەی.", "corrupted": "دەوڵەت بەکاری دێنێت بۆ بڵاوکردنەوەی فەلسەفەی رامیاری و کۆمەڵایەتییەکەی.", "source": "دەوڵەت بەکاری دێنێت بۆ بڵاوکردنەوەی فەلسەفەی رامیاری و کۆمەڵایەتییەکەی.", "target": "دەوڵەت بەکاری دێنێت بۆ بڵاوکردنەوەی فەلسەفەی رامیاری و کۆمەڵایەتییەکەی.", "errors": [], "source_id": "5973", "category": "social_sciences"}
{"original": "بەڵکو زمان رابێنن بەیاد کردنی خودا و گوتنی راستی و چاکە، هەروەەا دەتوانن بیکەنە هۆکاری پێکەوە ژیان و لێک گەیشتن و خۆشەویستی و برایەتی. هەر زمانە خاوەنەکەی بۆ بەەەشت یان بۆ دۆزەخ رادەپێچێت.", "corrupted": "بەڵکو زمان رابێنن بەیاد کردنی خودا و گوتنی راستی و چاکە، هەروەەا دەتوانن بیکەنە هۆکاری پێکەوە ژیان و لێک گەیشتن و خۆشەویستی و برایەتی. هەر زمانە خاوەنەکەی بۆ بەەەشت یان بۆ دۆزەخ رادەپێچێت.", "source": "بەڵکو زمان رابێنن بەیاد کردنی خودا و گوتنی راستی و چاکە، هەروەەا دەتوانن بیکەنە هۆکاری پێکەوە ژیان و لێک گەیشتن و خۆشەویستی و برایەتی. هەر زمانە خاوەنەکەی بۆ بەەەشت یان بۆ دۆزەخ رادەپێچێت.", "target": "بەڵکو زمان رابێنن بەیاد کردنی خودا و گوتنی راستی و چاکە، هەروەەا دەتوانن بیکەنە هۆکاری پێکەوە ژیان و لێک گەیشتن و خۆشەویستی و برایەتی. هەر زمانە خاوەنەکەی بۆ بەەەشت یان بۆ دۆزەخ رادەپێچێت.", "errors": [], "source_id": "6090", "category": "islamic_studies"}
{"original": "خودای گەورە فەرمانی کردووە بە موسوڵمانان داوێنیان بپارێزن وخۆڕاگربن لە بەرشاڵاوی ئارەزوبازیدا و خۆ لەسەرەتاکانی بپارێزن.", "corrupted": "خودای گەورە فەرمانی کردووەبەموسوڵمانانن داوێنتان بپارێزن وخۆڕاگربنلە بەرشاڵاوی ئارەزوبازیدا وخۆ لەسەرەتاکانی بپارێزن.", "source": "خودای گەورە فەرمانی کردووەبەموسوڵمانانن داوێنتان بپارێزن وخۆڕاگربنلە بەرشاڵاوی ئارەزوبازیدا وخۆ لەسەرەتاکانی بپارێزن.", "target": "خودای گەورە فەرمانی کردووە بە موسوڵمانان داوێنیان بپارێزن وخۆڕاگربن لە بەرشاڵاوی ئارەزوبازیدا و خۆ لەسەرەتاکانی بپارێزن.", "errors": [{"type": "clitic_form", "original": "داوێنیان", "error": "داوێنتان", "start": 41, "end": 49, "description": "clitic_form: 'داوێنیان' → 'داوێنتان'"}, {"type": "whitespace", "original": "و خۆ", "error": "وخۆ", "start": 94, "end": 98, "description": "whitespace: 'و خۆ' → 'وخۆ'"}, {"type": "whitespace", "original": "وخۆڕاگربن لە", "error": "وخۆڕاگربنلە", "start": 58, "end": 70, "description": "whitespace: 'وخۆڕاگربن لە' → 'وخۆڕاگربنلە'"}, {"type": "whitespace", "original": "موسوڵمانان", "error": "مو سوڵمانان", "start": 30, "end": 40, "description": "whitespace: 'موسوڵمانان' → 'مو سوڵمانان'"}, {"type": "whitespace", "original": "بە موسوڵمانان", "error": "بەموسوڵمانان", "start": 27, "end": 40, "description": "whitespace: 'بە موسوڵمانان' → 'بەموسوڵمانان'"}, {"type": "whitespace", "original": "کردووە بە", "error": "کردووەبە", "start": 20, "end": 29, "description": "whitespace: 'کردووە بە' → 'کردووەبە'"}], "source_id": "5921", "category": "islamic_studies"}
{"original": "بۆ پێوانی خێرایی دەنگ، ئەوا لەدووریەکی حیساب کراوەوە لەمەدفەعێک، کاتی نێوان بریسکەی مەدفەعەکە و بیستنی دەنگەکەی بەەۆی سەعاتێکی کات ڕاگر دەپیوین. ئەو کاتەش بریتی یە لەو کاتەی دەنگەکە دەیەوێت تا لە مەدفەعەکەوە دەگاتە گوێگر.", "corrupted": "بۆ پێوانی خێرایی دەنگ، ئەوا لەدووریەکی حیساب کراوەوە لەمەدفەعێک، کاتی نێوان بریسکەی مەدفەعەکە و بیستنی دەنگەکەی بەەۆی سەعاتێکی کات ڕاگر دەپیوین. ئەو کاتەش بریتی یە لەو کاتەی دەنگەکە دەیەوێت تا لە مەدفەعەکەوە دەگاتە گوێگر.", "source": "بۆ پێوانی خێرایی دەنگ، ئەوا لەدووریەکی حیساب کراوەوە لەمەدفەعێک، کاتی نێوان بریسکەی مەدفەعەکە و بیستنی دەنگەکەی بەەۆی سەعاتێکی کات ڕاگر دەپیوین. ئەو کاتەش بریتی یە لەو کاتەی دەنگەکە دەیەوێت تا لە مەدفەعەکەوە دەگاتە گوێگر.", "target": "بۆ پێوانی خێرایی دەنگ، ئەوا لەدووریەکی حیساب کراوەوە لەمەدفەعێک، کاتی نێوان بریسکەی مەدفەعەکە و بیستنی دەنگەکەی بەەۆی سەعاتێکی کات ڕاگر دەپیوین. ئەو کاتەش بریتی یە لەو کاتەی دەنگەکە دەیەوێت تا لە مەدفەعەکەوە دەگاتە گوێگر.", "errors": [], "source_id": "3533", "category": "sciences"}
{"original": "یەکەم: گوتراوە لە مرۆڤدا، ئارەزووی چاکە و ئارەزووی خراپەش هەیە، چونکە هەر بەم شێوەیە دروست بووە.", "corrupted": "یەکەم: گوتراوە لە مرۆڤدا، ئارەزووی چاکە و ئارەزووی خراپەش هەیە، چونکە هەر بەم شێوەیە دروست بووە.", "source": "یەکەم: گوتراوە لە مرۆڤدا، ئارەزووی چاکە و ئارەزووی خراپەش هەیە، چونکە هەر بەم شێوەیە دروست بووە.", "target": "یەکەم: گوتراوە لە مرۆڤدا، ئارەزووی چاکە و ئارەزووی خراپەش هەیە، چونکە هەر بەم شێوەیە دروست بووە.", "errors": [], "source_id": "8175", "category": "social_sciences"}
{"original": "قوتابخانە لە زمانی سۆمەریدا ناوی لێنراوە، چونکە فێربوون بە ئامادەکردنی تاتە قوڕینەکان دەستی پێکرد کە پێی دەوترا لەبەر ئەوەی قوتابخانە لەەەمان کاتدا پەرتووکخانەش بوو، بۆیە زاراوەی بۆ کتێبخانەش بەکارەاتووە.", "corrupted": "قوتابخانە لە زمانی سۆمەریدا ناوی لێنراوە، چونکە فێربوون بە ئامادەکردنی تاتە قوڕینەکان دەستی پێکرد کە پێی دەوترا لەبەر ئەوەی قوتابخانە لەەەمان کاتدا پەرتووکخانەش بوو، بۆیە زاراوەی بۆ کتێبخانەش بەکارەاتووە.", "source": "قوتابخانە لە زمانی سۆمەریدا ناوی لێنراوە، چونکە فێربوون بە ئامادەکردنی تاتە قوڕینەکان دەستی پێکرد کە پێی دەوترا لەبەر ئەوەی قوتابخانە لەەەمان کاتدا پەرتووکخانەش بوو، بۆیە زاراوەی بۆ کتێبخانەش بەکارەاتووە.", "target": "قوتابخانە لە زمانی سۆمەریدا ناوی لێنراوە، چونکە فێربوون بە ئامادەکردنی تاتە قوڕینەکان دەستی پێکرد کە پێی دەوترا لەبەر ئەوەی قوتابخانە لەەەمان کاتدا پەرتووکخانەش بوو، بۆیە زاراوەی بۆ کتێبخانەش بەکارەاتووە.", "errors": [], "source_id": "5162", "category": "history"}
{"original": "لە دواوە بۆیان سووڕانەوەو هێرشێکی لە ناکاویان کردنە سەرو توانیان بە کتوپڕی ئەنجامی شەڕەکە لە بەرژەوەندی خۆیان یەک لا بکەنەوە، حەفتا کەس لە موسڵمانان شەەید بکەن کە لە نێوانیان دا حەمزەی کوڕی عەبدولموتەڵیبی مامی پێغەمبەر بوو.", "corrupted": "لە دواوە بۆیان سووڕانەوەو هێرشێکی لە ناکاویان کردنە سەرو توانیان بە کتوپڕی ئەنجامی شەڕەکە لە بەرژەوەندی خۆیان یەک لا بکەنەوە، حەفتا کەس لە موسڵمانان شەەید بکەن کە لە نێوانیان دا حەمزەی کوڕی عەبدولموتەڵیبی مامی پێغەمبەر بوو.", "source": "لە دواوە بۆیان سووڕانەوەو هێرشێکی لە ناکاویان کردنە سەرو توانیان بە کتوپڕی ئەنجامی شەڕەکە لە بەرژەوەندی خۆیان یەک لا بکەنەوە، حەفتا کەس لە موسڵمانان شەەید بکەن کە لە نێوانیان دا حەمزەی کوڕی عەبدولموتەڵیبی مامی پێغەمبەر بوو.", "target": "لە دواوە بۆیان سووڕانەوەو هێرشێکی لە ناکاویان کردنە سەرو توانیان بە کتوپڕی ئەنجامی شەڕەکە لە بەرژەوەندی خۆیان یەک لا بکەنەوە، حەفتا کەس لە موسڵمانان شەەید بکەن کە لە نێوانیان دا حەمزەی کوڕی عەبدولموتەڵیبی مامی پێغەمبەر بوو.", "errors": [], "source_id": "6488", "category": "social_sciences"}
{"original": "قورئان بەم شێوەیە باسی موسڵمانی ڕاستەقینە دەکات‌و دەیەوێت باوەڕێکی پاک‌و بێگەردی هەبێت کە لەسەر بنەمای هۆشیاری‌و تێگەیشتن بنیات نرابێت‌و ڕەوشت‌و مامەڵەی ڕۆژانەشی ببێتە واقیعی باوەڕەکەی.", "corrupted": "قورئان بەم شێوەیە باسی موسڵمانی ڕاستەقینە دەکات‌و دەیەوێت باوەڕێکی پاک‌و بێگەردی هەبێت کە لەسەر بنەمای هۆشیاری‌و تێگەیشتن بنیات نرابێت‌و ڕەوشت‌و مامەڵەی ڕۆژانەشی ببێتە واقیعی باوەڕەکەی.", "source": "قورئان بەم شێوەیە باسی موسڵمانی ڕاستەقینە دەکات‌و دەیەوێت باوەڕێکی پاک‌و بێگەردی هەبێت کە لەسەر بنەمای هۆشیاری‌و تێگەیشتن بنیات نرابێت‌و ڕەوشت‌و مامەڵەی ڕۆژانەشی ببێتە واقیعی باوەڕەکەی.", "target": "قورئان بەم شێوەیە باسی موسڵمانی ڕاستەقینە دەکات‌و دەیەوێت باوەڕێکی پاک‌و بێگەردی هەبێت کە لەسەر بنەمای هۆشیاری‌و تێگەیشتن بنیات نرابێت‌و ڕەوشت‌و مامەڵەی ڕۆژانەشی ببێتە واقیعی باوەڕەکەی.", "errors": [], "source_id": "873", "category": "islamic_studies"}
