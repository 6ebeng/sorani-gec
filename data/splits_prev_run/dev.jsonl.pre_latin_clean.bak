{"original": "لەم دوادواییەشدا پیشەسازی لە جێگەی وەەا دامەزرا کە جاران زۆر بە دوور دادەنرا لە سەرچاوەی سووتەمەنییەوە، بەڵام ئێستا بەەۆی پێشکەوتنی گواستنەوەی نەوت‌و گازی سروشتیەوە ئەو رێگا دوورە بە دوور دانانرێت.", "corrupted": "لەم دوادواییەشدا پیشەسازی لە جێگەی وەەا دامەزرا کە جاران زۆر بە دوور دادەنرا لە سەرچاوەی سووتەمەنییەوە، بەڵام ئێستا بەەۆی پێشکەوتین گواستنەوەی نەوت‌و گازی سروشتیەوە ئەو رێگا دوورە بە دوور دانانرێت.", "source": "لەم دوادواییەشدا پیشەسازی لە جێگەی وەەا دامەزرا کە جاران زۆر بە دوور دادەنرا لە سەرچاوەی سووتەمەنییەوە، بەڵام ئێستا بەەۆی پێشکەوتین گواستنەوەی نەوت‌و گازی سروشتیەوە ئەو رێگا دوورە بە دوور دانانرێت.", "target": "لەم دوادواییەشدا پیشەسازی لە جێگەی وەەا دامەزرا کە جاران زۆر بە دوور دادەنرا لە سەرچاوەی سووتەمەنییەوە، بەڵام ئێستا بەەۆی پێشکەوتنی گواستنەوەی نەوت‌و گازی سروشتیەوە ئەو رێگا دوورە بە دوور دانانرێت.", "errors": [{"type": "tense_agreement", "original": "پێشکەوتنی", "error": "پێشکەوتین", "start": 122, "end": 131, "description": "tense_agreement: 'پێشکەوتنی' → 'پێشکەوتین'"}], "source_id": "3566", "category": "social_sciences"}
{"original": "خۆسەپاندن: واتە بەکەم گرتنی رای بەرانبەرو چەوساندنەوەی، کەناچاری دەکات بەرگری لەرای خۆی بکات و بونی خۆی بسەلمێنێت، لێردا ناحەزی پەیدا دەبێت.", "corrupted": "خۆسەپاندن: واتەبەکەمگرتنیرای بەران بەرو چەوساندنەوەی، کەناچاری دە کات بەرگری لەرای خۆیبکات و بونی خۆی بسەلمێنێت، لێردا ناحەزی پەیدا دەبێت.", "source": "خۆسەپاندن: واتەبەکەمگرتنیرای بەران بەرو چەوساندنەوەی، کەناچاری دە کات بەرگری لەرای خۆیبکات و بونی خۆی بسەلمێنێت، لێردا ناحەزی پەیدا دەبێت.", "target": "خۆسەپاندن: واتە بەکەم گرتنی رای بەرانبەرو چەوساندنەوەی، کەناچاری دەکات بەرگری لەرای خۆی بکات و بونی خۆی بسەلمێنێت، لێردا ناحەزی پەیدا دەبێت.", "errors": [{"type": "whitespace", "original": "خۆی بکات", "error": "خۆیبکات", "start": 84, "end": 92, "description": "whitespace: 'خۆی بکات' → 'خۆیبکات'"}, {"type": "whitespace", "original": "دەکات", "error": "دە کات", "start": 65, "end": 70, "description": "whitespace: 'دەکات' → 'دە کات'"}, {"type": "whitespace", "original": "بەرانبەرو", "error": "بەران بەرو", "start": 32, "end": 41, "description": "whitespace: 'بەرانبەرو' → 'بەران بەرو'"}, {"type": "whitespace", "original": "گرتنی رای", "error": "گرتنیرای", "start": 22, "end": 31, "description": "whitespace: 'گرتنی رای' → 'گرتنیرای'"}, {"type": "whitespace", "original": "بەکەم گرتنی", "error": "بەکەمگرتنی", "start": 16, "end": 27, "description": "whitespace: 'بەکەم گرتنی' → 'بەکەمگرتنی'"}, {"type": "whitespace", "original": "واتە بەکەم", "error": "واتەبەکەم", "start": 11, "end": 21, "description": "whitespace: 'واتە بەکەم' → 'واتەبەکەم'"}], "source_id": "8543", "category": "islamic_studies"}
