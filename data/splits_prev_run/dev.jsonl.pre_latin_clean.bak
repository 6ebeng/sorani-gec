{"original": "ڕادەکێشرێن و ئایۆنە سالیبەکان بەرەو جەمسەرە موجەبەکە ئەنۆد ڕادەکێشرێن، لەئەنجامدا تەزووێکی کارەبا لەناو گیراوە ئەلکترۆلیتیەکەدا لە ڕۆیشتنی بارگەی موجەب و بارگەی سالیب بە ئاڕاستەی پێچەوانە دروست دەبێت.", "corrupted": "ڕادەکێشرێن و ئایۆنە سالیبەکان بەرەو جەمسەڕە موجەبەکە ئەنۆض ڕادەکێشرێن، لەئەنجامدا طەزووێکی کارەبا لەناو گیراوە ئەلکترۆلیتیەکەدا ڵە ڕۆیشتنی بارگەی موجەب و بارگەی ساڵیب بە ئاراستەی پێچەوانە دروست دەبێت.", "source": "ڕادەکێشرێن و ئایۆنە سالیبەکان بەرەو جەمسەڕە موجەبەکە ئەنۆض ڕادەکێشرێن، لەئەنجامدا طەزووێکی کارەبا لەناو گیراوە ئەلکترۆلیتیەکەدا ڵە ڕۆیشتنی بارگەی موجەب و بارگەی ساڵیب بە ئاراستەی پێچەوانە دروست دەبێت.", "target": "ڕادەکێشرێن و ئایۆنە سالیبەکان بەرەو جەمسەرە موجەبەکە ئەنۆد ڕادەکێشرێن، لەئەنجامدا تەزووێکی کارەبا لەناو گیراوە ئەلکترۆلیتیەکەدا لە ڕۆیشتنی بارگەی موجەب و بارگەی سالیب بە ئاڕاستەی پێچەوانە دروست دەبێت.", "errors": [{"type": "spelling_confusion", "original": "ئاڕاستەی", "error": "ئاراستەی", "start": 170, "end": 178, "description": "spelling_confusion: 'ئاڕاستەی' → 'ئاراستەی'"}, {"type": "spelling_confusion", "original": "سالیب", "error": "ساڵیب", "start": 161, "end": 166, "description": "spelling_confusion: 'سالیب' → 'ساڵیب'"}, {"type": "spelling_confusion", "original": "لە", "error": "ڵە", "start": 128, "end": 130, "description": "spelling_confusion: 'لە' → 'ڵە'"}, {"type": "spelling_confusion", "original": "تەزووێکی", "error": "طەزووێکی", "start": 82, "end": 90, "description": "spelling_confusion: 'تەزووێکی' → 'طەزووێکی'"}, {"type": "spelling_confusion", "original": "ئەنۆد", "error": "ئەنۆض", "start": 53, "end": 58, "description": "spelling_confusion: 'ئەنۆد' → 'ئەنۆض'"}, {"type": "spelling_confusion", "original": "جەمسەرە", "error": "جەمسەڕە", "start": 36, "end": 43, "description": "spelling_confusion: 'جەمسەرە' → 'جەمسەڕە'"}], "source_id": "412", "category": "sciences"}
