{"original": "هەموو شتی دروستکراوی مەتبەخ دەگرێتەوە وەک ئاسن و مس و ئەلەمنیۆم هەیە، هەروەەا پیشەسازی بەکارەێنانی زیو زێر و دروستکردنی مەکینەو ئامێری کشتوکاڵی و پیشەسازی ئوتومبێل، و پیشەسازی دروستکردنی دەرگا و پەنجەرە.", "corrupted": "حەموو شتێ دروستکراوی مەتبەخ دەگرێتەوە وەک ئاسن و مس و ئەلەمنیۆم هەیە، هەروەەا پیشەساژی بەکارەێنانی زیو زێر و دروستکردنی مەکینەو ئامێری کشتوکاڵی و پیشەساژی ئوتومبێل، و پێشەسازی دروستکردنی دەرگا و پەنجەرە.", "source": "حەموو شتێ دروستکراوی مەتبەخ دەگرێتەوە وەک ئاسن و مس و ئەلەمنیۆم هەیە، هەروەەا پیشەساژی بەکارەێنانی زیو زێر و دروستکردنی مەکینەو ئامێری کشتوکاڵی و پیشەساژی ئوتومبێل، و پێشەسازی دروستکردنی دەرگا و پەنجەرە.", "target": "هەموو شتی دروستکراوی مەتبەخ دەگرێتەوە وەک ئاسن و مس و ئەلەمنیۆم هەیە، هەروەەا پیشەسازی بەکارەێنانی زیو زێر و دروستکردنی مەکینەو ئامێری کشتوکاڵی و پیشەسازی ئوتومبێل، و پیشەسازی دروستکردنی دەرگا و پەنجەرە.", "errors": [{"type": "orthography", "original": "پیشەسازی", "error": "پێشەسازی", "start": 167, "end": 175, "description": "orthography: 'پیشەسازی' → 'پێشەسازی'"}, {"type": "orthography", "original": "پیشەسازی", "error": "پیشەساژی", "start": 146, "end": 154, "description": "orthography: 'پیشەسازی' → 'پیشەساژی'"}, {"type": "orthography", "original": "پیشەسازی", "error": "پیشەساژی", "start": 78, "end": 86, "description": "orthography: 'پیشەسازی' → 'پیشەساژی'"}, {"type": "orthography", "original": "شتی", "error": "شتێ", "start": 6, "end": 9, "description": "orthography: 'شتی' → 'شتێ'"}, {"type": "orthography", "original": "هەموو", "error": "حەموو", "start": 0, "end": 5, "description": "orthography: 'هەموو' → 'حەموو'"}], "source_id": "5338", "category": "social_sciences"}
{"original": "بەڵام بەرەبەرە خۆ رزگارکردن لەو کۆتانە بوو بە سیمایەکی هونەری ڕێنسانس و تابلۆی چوارچێوەدار کە بشێ هەڵبگیرێ و بگوازرێتەوە، و هەریەکە لە تابلۆکانی جۆرێک چێژ و قەشەنگی تێدابوو.", "corrupted": "بەڵام بەرەبەرە خۆ رزگارکردن لەو کۆطانە بوو بە سیمایەکی هونەڕی ڕێنسانس و تابلۆی چوارچێوەدار کە بشێ هەڵبگیرێ و بگوازرێتەوە، و هەریەکە لە تابلۆکانی جۆرێک چێز و قەشەنگی تێدابوو.", "source": "بەڵام بەرەبەرە خۆ رزگارکردن لەو کۆطانە بوو بە سیمایەکی هونەڕی ڕێنسانس و تابلۆی چوارچێوەدار کە بشێ هەڵبگیرێ و بگوازرێتەوە، و هەریەکە لە تابلۆکانی جۆرێک چێز و قەشەنگی تێدابوو.", "target": "بەڵام بەرەبەرە خۆ رزگارکردن لەو کۆتانە بوو بە سیمایەکی هونەری ڕێنسانس و تابلۆی چوارچێوەدار کە بشێ هەڵبگیرێ و بگوازرێتەوە، و هەریەکە لە تابلۆکانی جۆرێک چێژ و قەشەنگی تێدابوو.", "errors": [{"type": "spelling_confusion", "original": "چێژ", "error": "چێز", "start": 151, "end": 154, "description": "spelling_confusion: 'چێژ' → 'چێز'"}, {"type": "spelling_confusion", "original": "هونەری", "error": "هونەڕی", "start": 55, "end": 61, "description": "spelling_confusion: 'هونەری' → 'هونەڕی'"}, {"type": "spelling_confusion", "original": "کۆتانە", "error": "کۆطانە", "start": 32, "end": 38, "description": "spelling_confusion: 'کۆتانە' → 'کۆطانە'"}], "source_id": "103", "category": "history"}
