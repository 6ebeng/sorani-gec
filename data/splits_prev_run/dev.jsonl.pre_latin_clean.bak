{"original": "وەک وزەی کارەبا کە بۆ روناکی و گەرمکردن و فێنککردنەوە بەکاردێت. هەروەەا ئامێری تەلەفزیۆن و کۆمپیتەر و سودەکانیان، ئۆتۆمبیل و فرۆکە بۆ گواستنەوە. لەلایەکی ترەوە زانستی پزیشکی بۆ تەندروستی و چارەسەری نەخۆشی.", "corrupted": "وەک وزەی کارەبا کە بۆ روناکی و گەرمک ردن و فێنککردنەوە بەکاردێت. هەروەەا ئامێری تەلەفزیۆن و کۆمپیت ەر و سودەکانیان، ئۆتۆمبیل و فرۆکە بۆ گواستنەوە. لەلایەکی ترەوە زانس تی پزیشکیبۆ تەندروستی و چارەسەری نەخۆشی.", "source": "وەک وزەی کارەبا کە بۆ روناکی و گەرمک ردن و فێنککردنەوە بەکاردێت. هەروەەا ئامێری تەلەفزیۆن و کۆمپیت ەر و سودەکانیان، ئۆتۆمبیل و فرۆکە بۆ گواستنەوە. لەلایەکی ترەوە زانس تی پزیشکیبۆ تەندروستی و چارەسەری نەخۆشی.", "target": "وەک وزەی کارەبا کە بۆ روناکی و گەرمکردن و فێنککردنەوە بەکاردێت. هەروەەا ئامێری تەلەفزیۆن و کۆمپیتەر و سودەکانیان، ئۆتۆمبیل و فرۆکە بۆ گواستنەوە. لەلایەکی ترەوە زانستی پزیشکی بۆ تەندروستی و چارەسەری نەخۆشی.", "errors": [{"type": "whitespace", "original": "پزیشکی بۆ", "error": "پزیشکیبۆ", "start": 167, "end": 176, "description": "whitespace: 'پزیشکی بۆ' → 'پزیشکیبۆ'"}, {"type": "whitespace", "original": "زانستی", "error": "زانس تی", "start": 160, "end": 166, "description": "whitespace: 'زانستی' → 'زانس تی'"}, {"type": "whitespace", "original": "کۆمپیتەر", "error": "کۆمپیت ەر", "start": 91, "end": 99, "description": "whitespace: 'کۆمپیتەر' → 'کۆمپیت ەر'"}, {"type": "whitespace", "original": "گەرمکردن", "error": "گەرمک ردن", "start": 31, "end": 39, "description": "whitespace: 'گەرمکردن' → 'گەرمک ردن'"}], "source_id": "6101", "category": "islamic_studies"}
