{"original": "پشدەری، ساڵح حسێن ، کورتەیەک لە ڕێزمانی کورد و لێکۆڵینەوەیەکی، بەغدا: چاپخانەی بەغدا.", "corrupted": "پشدەڕی، سالح حسێن، کورتەیەک لە ڕێزمانی کورد و لێکۆلینەوەیەکی، بەغدا: چاپخانەی بەغدا.", "source": "پشدەڕی، سالح حسێن، کورتەیەک لە ڕێزمانی کورد و لێکۆلینەوەیەکی، بەغدا: چاپخانەی بەغدا.", "target": "پشدەری، ساڵح حسێن ، کورتەیەک لە ڕێزمانی کورد و لێکۆڵینەوەیەکی، بەغدا: چاپخانەی بەغدا.", "errors": [{"type": "spelling_confusion", "original": "لێکۆڵینەوەیەکی،", "error": "لێکۆلینەوەیەکی،", "start": 47, "end": 62, "description": "spelling_confusion: 'لێکۆڵینەوەیەکی،' → 'لێکۆلینەوەیەکی،'"}, {"type": "spelling_confusion", "original": "ساڵح", "error": "سالح", "start": 8, "end": 12, "description": "spelling_confusion: 'ساڵح' → 'سالح'"}, {"type": "spelling_confusion", "original": "پشدەری،", "error": "پشدەڕی،", "start": 0, "end": 7, "description": "spelling_confusion: 'پشدەری،' → 'پشدەڕی،'"}], "source_id": "9699", "category": "linguistics"}
{"original": "بەڵام ئەو ماڵ وکاڵایەی قەرزە لای کەسێکی وا ناتوانێ بیداتەوە یان ستەمکارەو داگیری کردوەو بەتەمای نیە، زەکاتی لەسەر نیە، مەگەر دوای وەرگرتنەوەی. هەروەەا ئەو ماڵەی لەسەرخۆی قەرز بێت یان بەپێشینە وەری گرێت وبیداتە قەرز زەکاتی لێنادرێت تا نەبێتە ماڵی خۆی.", "corrupted": "بەڵام ئەو ماڵ وکاڵایەی قەرزە لای کەسێکی وا ناتوانێ بیداتەوە یان ستەمکارەو داگیری کردوەو بەطەمای نیە، زەکاطی لەسەر نیە، مەگەر دوای وەرگرتنەوەی. هەڕوەەا ئەو ماڵەی لەسەڕخۆی قەرز بێط یان بەپێشینە وەری گرێت وبیداتە قەرز زەکاتی لێنادرێت تا نەبێطە مالی خۆی.", "source": "بەڵام ئەو ماڵ وکاڵایەی قەرزە لای کەسێکی وا ناتوانێ بیداتەوە یان ستەمکارەو داگیری کردوەو بەطەمای نیە، زەکاطی لەسەر نیە، مەگەر دوای وەرگرتنەوەی. هەڕوەەا ئەو ماڵەی لەسەڕخۆی قەرز بێط یان بەپێشینە وەری گرێت وبیداتە قەرز زەکاتی لێنادرێت تا نەبێطە مالی خۆی.", "target": "بەڵام ئەو ماڵ وکاڵایەی قەرزە لای کەسێکی وا ناتوانێ بیداتەوە یان ستەمکارەو داگیری کردوەو بەتەمای نیە، زەکاتی لەسەر نیە، مەگەر دوای وەرگرتنەوەی. هەروەەا ئەو ماڵەی لەسەرخۆی قەرز بێت یان بەپێشینە وەری گرێت وبیداتە قەرز زەکاتی لێنادرێت تا نەبێتە ماڵی خۆی.", "errors": [{"type": "spelling_confusion", "original": "ماڵی", "error": "مالی", "start": 241, "end": 245, "description": "spelling_confusion: 'ماڵی' → 'مالی'"}, {"type": "spelling_confusion", "original": "نەبێتە", "error": "نەبێطە", "start": 234, "end": 240, "description": "spelling_confusion: 'نەبێتە' → 'نەبێطە'"}, {"type": "spelling_confusion", "original": "بێت", "error": "بێط", "start": 175, "end": 178, "description": "spelling_confusion: 'بێت' → 'بێط'"}, {"type": "spelling_confusion", "original": "لەسەرخۆی", "error": "لەسەڕخۆی", "start": 161, "end": 169, "description": "spelling_confusion: 'لەسەرخۆی' → 'لەسەڕخۆی'"}, {"type": "spelling_confusion", "original": "هەروەەا", "error": "هەڕوەەا", "start": 143, "end": 150, "description": "spelling_confusion: 'هەروەەا' → 'هەڕوەەا'"}, {"type": "spelling_confusion", "original": "زەکاتی", "error": "زەکاطی", "start": 101, "end": 107, "description": "spelling_confusion: 'زەکاتی' → 'زەکا