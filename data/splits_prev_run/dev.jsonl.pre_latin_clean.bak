{"original": "ئەگەرچی هەندێ بەڵگەی ئەوتۆمان هەیە لە ڕێیانەوە چاوگ بە سەرچاوەی کردار دابنێین، بەڵام لەبەر ئەوەی چەند لایەنێکی مێژوویی نائاشکرامان بۆ ڕوون نەبووەتەوە، بۆیە لە نووسینی ئەم کتێبەدا هەرسی و و (چاوگ)مان کردووەتە کەرەستە.", "corrupted": "ئەگەرچی هەندێ بەڵگەی ئەوتۆمان هەیە لە ڕێیانەوە چاوگ بە سەرچاوەی کردار دابنێین، بەڵام دەلەبەر ئەوەی چەند لایەنێکی مێژوویی نائاشکرامان بۆ ڕوون نەبووەتەوە، بۆیە لە نووسینی ئەم کتێبەدا هەرسی و و دە(چاوگ)مان کردووەتە کەرەستە.", "source": "ئەگەرچی هەندێ بەڵگەی ئەوتۆمان هەیە لە ڕێیانەوە چاوگ بە سەرچاوەی کردار دابنێین، بەڵام دەلەبەر ئەوەی چەند لایەنێکی مێژوویی نائاشکرامان بۆ ڕوون نەبووەتەوە، بۆیە لە نووسینی ئەم کتێبەدا هەرسی و و دە(چاوگ)مان کردووەتە کەرەستە.", "target": "ئەگەرچی هەندێ بەڵگەی ئەوتۆمان هەیە لە ڕێیانەوە چاوگ بە سەرچاوەی کردار دابنێین، بەڵام لەبەر ئەوەی چەند لایەنێکی مێژوویی نائاشکرامان بۆ ڕوون نەبووەتەوە، بۆیە لە نووسینی ئەم کتێبەدا هەرسی و و (چاوگ)مان کردووەتە کەرەستە.", "errors": [{"type": "cross_clause_agreement", "original": "(چاوگ)مان", "error": "دە(چاوگ)مان", "start": 189, "end": 198, "description": "cross_clause_agreement: '(چاوگ)مان' → 'دە(چاوگ)مان'"}, {"type": "cross_clause_agreement", "original": "لەبەر", "error": "دەلەبەر", "start": 85, "end": 90, "description": "cross_clause_agreement: 'لەبەر' → 'دەلەبەر'"}], "source_id": "1334", "category": "linguistics"}
