{"original": "ئەم بەشە لە بوارەکانی و بابەتە سەرەکییەکانی کۆمەڵناسی و پەیوەندییەکانی بە زانیارییەکانی دیکەوە دەکۆڵێتەوە.", "corrupted": "ئەم بەشە لە بوارەکانی و بابەتە سەرەکییەکانی کۆمەڵناسی و پەیوەندییەکانی بە زانیارییەکانی دیکەوە دەکۆڵێتەوە.", "source": "ئەم بەشە لە بوارەکانی و بابەتە سەرەکییەکانی کۆمەڵناسی و پەیوەندییەکانی بە زانیارییەکانی دیکەوە دەکۆڵێتەوە.", "target": "ئەم بەشە لە بوارەکانی و بابەتە سەرەکییەکانی کۆمەڵناسی و پەیوەندییەکانی بە زانیارییەکانی دیکەوە دەکۆڵێتەوە.", "errors": [], "source_id": "2055", "category": "social_sciences"}
{"original": "بابا ئەردەڵان پیاوێکی وردو لێەاتوو بووە، و ئازاو بەجەرگ و نەترس و بە دەست و برد بووە و لەماوەیەکی کەمدا میرنشینەکەی فراوان کردووەو بەردەوام برەوی بە قەڵەمڕەوی خۆی داوەو هەتا لەژیاندا بووە بە سەربەستی و بە سەربەخۆیی و سەرداری ژیاوە.", "corrupted": "بابا ئەردەڵان پیاوێکی وردو لێەاتوو بووە، و ئازاو بەجەرگ و نەترس و بە دەست و برد بووە و لەماوەیەکەکەی کەمدا میرنشینەکەی فراوان کردووەو بەردەوام بڕەوی بە قەڵەمڕەوی خۆی داوەو هەتا لەژیاندا بووە بە سەربەستی ۆ بە سەربەخۆیی و سەردارەکەی ژیاوە.", "source": "بابا ئەردەڵان پیاوێکی وردو لێەاتوو بووە، و ئازاو بەجەرگ و نەترس و بە دەست و برد بووە و لەماوەیەکەکەی کەمدا میرنشینەکەی فراوان کردووەو بەردەوام بڕەوی بە قەڵەمڕەوی خۆی داوەو هەتا لەژیاندا بووە بە سەربەستی ۆ بە سەربەخۆیی و سەردارەکەی ژیاوە.", "target": "بابا ئەردەڵان پیاوێکی وردو لێەاتوو بووە، و ئازاو بەجەرگ و نەترس و بە دەست و برد بووە و لەماوەیەکی کەمدا میرنشینەکەی فراوان کردووەو بەردەوام برەوی بە قەڵەمڕەوی خۆی داوەو هەتا لەژیاندا بووە بە سەربەستی و بە سەربەخۆیی و سەرداری ژیاوە.", "errors": [{"type": "noun_adjective_agreement", "original": "سەرداری ژیاوە.", "error": "سەردارەکەی ژیاوە.", "start": 217, "end": 231, "description": "noun_adjective_agreement: 'سەرداری ژیاوە.' → 'سەردارەکەی ژیاوە.'"}, {"type": "noun_adjective_agreement", "original": "لەماوەیەکی کەمدا", "error": "لەماوەیەکەکەی کەمدا", "start": 87, "end": 103, "description": "noun_adjective_agreement: 'لەماوەیەکی کەمدا' → 'لەماوەیەکەکەی کەمدا'"}, {"type": "orthography", "original": "و", "error": "ۆ", "start": 203, "end": 204, "description": "orthography: 'و' → 'ۆ'"}, {"type": "orthography", "original": "برەوی", "error": "بڕەوی", "start": 143, "end": 148, "description": "orthography: 'برەوی' → 'بڕەوی'"}], "source_id": "2864", "category": "history"}
{"original": "وە هاوکۆلکەی یۆنگ لەم بوارەدا لەلایەن هەموو قوتابیانی زانست و ئەندازە دا ناسراوە. لەکۆتایی ژیانی دا لەخەستەخانەی سانت جۆرج ئیشی دەکرد. لە ۱۰/۵/۱۸۲۹ لە لەندەن کۆچی دوایی کرد.", "corrupted": "وە هاوکۆلکەی یۆنگ لەم بوارەدا لەلایەن هەموو قوتابیانی زانست و ئەندازە دا ناسراوە. لەکۆتایی ژیانی دا لەخەستەخانەی سانت جۆرج ئیشی دەکرد. لە ۱۰/۵/۱۸۲۹ لە لەندەن کۆچی دوایی کرد.", "source": "وە هاوکۆلکەی یۆنگ لەم بوارەدا لەلایەن هەموو قوتابیانی زانست و ئەندازە دا ناسراوە. لەکۆتایی ژیانی دا لەخەستەخانەی سانت جۆرج ئیشی دەکرد. لە ۱۰/۵/۱۸۲۹ لە لەندەن کۆچی دوایی کرد.", "target": "وە هاوکۆلکەی یۆنگ لەم بوارەدا لەلایەن هەموو قوتابیانی زانست و ئەندازە دا ناسراوە. لەکۆتایی ژیانی دا لەخەستەخانەی سانت جۆرج ئیشی دەکرد. لە ۱۰/۵/۱۸۲۹ لە لەندەن کۆچی دوایی کرد.", "errors": [], "source_id": "5977", "category": "sciences"}
