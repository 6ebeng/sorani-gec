{"original": "چەندین جار لە زێدی باب و باپیرانیان راگوێزراون و تاڵانکراون. هەر لە سەرەتای سییەکانی سەدەی رابردوو کەوتنە بەر پەلاماری لەشکری پیادەی عێراق، بە پاڵپشتی فڕۆکە جەنگیەکانی ئینگلیز، چەندین گوندیان وێرانکرد و دانیشتوانەکەیان بەرەو تورکیا رایانکردوە.", "corrupted": "چەندین جار لە زێدی باب و باپیرانیان راگوێزراون و تاڵانکراون. هەر ڵە سەرەطای سییەکانی سەضەی رابردوو کەوتنە بەر پەلاماری ڵەشکری پیادەی عێراق، بە پاڵپشطی فڕۆکە جەنگیەکانی ئینگلیز، چەندین گوندیان وێرانکرد و دانیشتوانەکەیان بەرەو تورکیا رایانکردوە.", "source": "چەندین جار لە زێدی باب و باپیرانیان راگوێزراون و تاڵانکراون. هەر ڵە سەرەطای سییەکانی سەضەی رابردوو کەوتنە بەر پەلاماری ڵەشکری پیادەی عێراق، بە پاڵپشطی فڕۆکە جەنگیەکانی ئینگلیز، چەندین گوندیان وێرانکرد و دانیشتوانەکەیان بەرەو تورکیا رایانکردوە.", "target": "چەندین جار لە زێدی باب و باپیرانیان راگوێزراون و تاڵانکراون. هەر لە سەرەتای سییەکانی سەدەی رابردوو کەوتنە بەر پەلاماری لەشکری پیادەی عێراق، بە پاڵپشتی فڕۆکە جەنگیەکانی ئینگلیز، چەندین گوندیان وێرانکرد و دانیشتوانەکەیان بەرەو تورکیا رایانکردوە.", "errors": [{"type": "spelling_confusion", "original": "پاڵپشتی", "error": "پاڵپشطی", "start": 143, "end": 150, "description": "spelling_confusion: 'پاڵپشتی' → 'پاڵپشطی'"}, {"type": "spelling_confusion", "original": "لەشکری", "error": "ڵەشکری", "start": 119, "end": 125, "description": "spelling_confusion: 'لەشکری' → 'ڵەشکری'"}, {"type": "spelling_confusion", "original": "سەدەی", "error": "سەضەی", "start": 85, "end": 90, "description": "spelling_confusion: 'سەدەی' → 'سەضەی'"}, {"type": "spelling_confusion", "original": "سەرەتای", "error": "سەرەطای", "start": 68, "end": 75, "description": "spelling_confusion: 'سەرەتای' → 'سەرەطای'"}, {"type": "spelling_confusion", "original": "لە", "error": "ڵە", "start": 65, "end": 67, "description": "spelling_confusion: 'لە' → 'ڵە'"}], "source_id": "22", "category": "history"}
