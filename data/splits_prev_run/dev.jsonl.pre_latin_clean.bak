{"original": "ژێ یە لەراوەکە لەشەپۆلی وەستاودا لەباری زرنگانەوە دادەبێت لەگەلأ سەرچاوەکە.", "corrupted": "ژێ یە لەراوەکان لەشەپۆلەکەی وەستاودا لەبار زرنگانەوە دادەبێت لەگەلأ سەرچاوەکە.", "source": "ژێ یە لەراوەکان لەشەپۆلەکەی وەستاودا لەبار زرنگانەوە دادەبێت لەگەلأ سەرچاوەکە.", "target": "ژێ یە لەراوەکە لەشەپۆلی وەستاودا لەباری زرنگانەوە دادەبێت لەگەلأ سەرچاوەکە.", "errors": [{"type": "noun_adjective_agreement", "original": "لەباری زرنگانەوە", "error": "لەبار زرنگانەوە", "start": 33, "end": 49, "description": "noun_adjective_agreement: 'لەباری زرنگانەوە' → 'لەبار زرنگانەوە'"}, {"type": "noun_adjective_agreement", "original": "لەشەپۆلی وەستاودا", "error": "لەشەپۆلەکەی وەستاودا", "start": 15, "end": 32, "description": "noun_adjective_agreement: 'لەشەپۆلی وەستاودا' → 'لەشەپۆلەکەی وەستاودا'"}, {"type": "noun_adjective_agreement", "original": "لەراوەکە", "error": "لەراوەکان", "start": 6, "end": 14, "description": "noun_adjective_agreement: 'لەراوەکە' → 'لەراوەکان'"}], "source_id": "5564", "category": "sciences"}
{"original": "مەبەست لە چەمکی خەلافە لە مێژووی ئیسلامیدا، ئەو قەوارەی سیاسییەیە کە جێگرانی پێغەمبەر فەرمانڕەوایی دەکەن و بەڕێوەی دەبەن و دەستوور و شەرعیەتی ئیسلام پەیڕەو دەکەن.", "corrupted": "مەبەست لە چەمکی خەلافە لە مێژووی ئیسلامیدا، ئەو قەوارەەکەی سیاسییەیە کە جێگرانی پێغەمبەر فەرمانڕەواییی دەکەن و بەڕێوەیی دەبەن و دەستوور و شەرعیەتی ئیسلام پەیڕەو دەکەن.", "source": "مەبەست لە چەمکی خەلافە لە مێژووی ئیسلامیدا، ئەو قەوارەەکەی سیاسییەیە کە جێگرانی پێغەمبەر فەرمانڕەواییی دەکەن و بەڕێوەیی دەبەن و دەستوور و شەرعیەتی ئیسلام پەیڕەو دەکەن.", "target": "مەبەست لە چەمکی خەلافە لە مێژووی ئیسلامیدا، ئەو قەوارەی سیاسییەیە کە جێگرانی پێغەمبەر فەرمانڕەوایی دەکەن و بەڕێوەی دەبەن و دەستوور و شەرعیەتی ئیسلام پەیڕەو دەکەن.", "errors": [{"type": "noun_adjective_agreement", "original": "بەڕێوەی دەبەن", "error": "بەڕێوەیی دەبەن", "start": 107, "end": 120, "description": "noun_adjective_agreement: 'بەڕێوەی دەبەن' → 'بەڕێوەیی دەبەن'"}, {"type": "noun_adjective_agreement", "original": "فەرمانڕەوایی دەکەن", "error": "فەرمانڕەواییی دەکەن", "start": 86, "end": 104, "description": "noun_adjective_agreement: 'فەرمانڕەوایی دەکەن' → 'فەرمانڕەواییی دەکەن'"}, {"type": "noun_adjective_agreement", "original": "قەوارەی سیاسییەیە", "error": "قەوارەەکەی سیاسییەیە", "start": 48, "end": 65, "description": "noun_adjective_agreement: 'قەوارەی سیاسییەیە' → 'قەوارەەکەی سیاسییەیە'"}], "source_id": "349", "category": "history"}
{"original": "ئەوا هێزێکی تر دیاردەکەوێت ئەویش هێزی دوورکەوتنەوەیە ئەم هێزە دورکەوتنەوەش بەخێرایی زیاد دەکات چەند گەردەکان لەیەکتری نزیک ببنەوە.", "corrupted": "ئەوا هێزێکی تر دیاردەکەوێت ئەویشهێزی دوورکەوتنەوەیە ئەم هێزە دورکەوتنەوەش بەخێرایی زیاد دەکاتچەند گەردەک ان لەیەکتری نزیک ببنەوە.", "source": "ئەوا هێزێکی تر دیاردەکەوێت ئەویشهێزی دوورکەوتنەوەیە ئەم هێزە دورکەوتنەوەش بەخێرایی زیاد دەکاتچەند گەردەک ان لەیەکتری نزیک ببنەوە.", "target": "ئەوا هێزێکی تر دیاردەکەوێت ئەویش هێزی دوورکەوتنەوەیە ئەم هێزە دورکەوتنەوەش بەخێرایی زیاد دەکات چەند گەردەکان لەیەکتری نزیک ببنەوە.", "errors": [{"type": "whitespace", "original": "گەردەکان", "error": "گەردەک ان", "start": 100, "end": 108, "description": "whitespace: 'گەردەکان' → 'گەردەک ان'"}, {"type": "whitespace", "original": "دەکات چەند", "error": "دەکاتچەند", "start": 89, "end": 99, "description": "whitespace: 'دەکات چەند' → 'دەکاتچەند'"}, {"type": "whitespace", "original": "ئەویش هێزی", "error": "ئەویشهێزی", "start": 27, "end": 37, "description": "whitespace: 'ئەویش هێزی' → 'ئەویشهێزی'"}], "source_id": "1150", "category": "sciences"}
{"original": "ئەوا پێویستە ئەمیتەرەکە بەرێگای دوای یەک بە تەلەکە ببەستڕێت بۆ ئەوەی هەمان ئەو تەزووەی دەمانەوێت بیپێوین بە ئەمیتەرەکە دابڕوات.", "corrupted": "ئەوا پێویستە ئەمیتەرەکە بەرێگای دوای یەک بە تەلەکە ببەستڕێت بۆ ئەوەی هەمان ئەو تەزووەی دەمانەوێت بیپێوین بە ئەمیتەرەکە دابڕوات.", "source": "ئەوا پێویستە ئەمیتەرەکە بەرێگای دوای یەک بە تەلەکە ببەستڕێت بۆ ئەوەی هەمان ئەو تەزووەی دەمانەوێت بیپێوین بە ئەمیتەرەکە دابڕوات.", "target": "ئەوا پێویستە ئەمیتەرەکە بەرێگای دوای یەک بە تەلەکە ببەستڕێت بۆ ئەوەی هەمان ئەو تەزووەی دەمانەوێت بیپێوین بە ئەمیتەرەکە دابڕوات.", "errors": [], "source_id": "4467", "category": "sciences"}
{"original": "ئاینی ئیسلام بایەخ دەدات بەکاری بە کۆمەڵ، و دژ بە دووبەرەکی، چ لە رووی پەرستش یان مامەڵە و کاروباری رۆژانە. خودای پەروەردگار هەرکارێکی هەرەوەز بە پیرۆز ناوزەددەکات بە مەرجێک سود بەخش بێت و لە چوار چێوەی رەزامەندی دابێت.", "corrupted": "ئاینی ئیسلام بایەخ دەدات بەکاری بە کۆمەڵ، و دژ بە دووبەرەکی، چ لە رووی پەرستش یان مامەڵە و کاروباری رۆژانە. خودای پەروەردگار هەرکارێکی هەرەوەز بە پیرۆز ناوزەددەکات بە مەرجێک سود بەخش بێت و لە چوار چێوەی رەزامەندی دابێت.", "source": "ئاینی ئیسلام بایەخ دەدات بەکاری بە کۆمەڵ، و دژ بە دووبەرەکی، چ لە رووی پەرستش یان مامەڵە و کاروباری رۆژانە. خودای پەروەردگار هەرکارێکی هەرەوەز بە پیرۆز ناوزەددەکات بە مەرجێک سود بەخش بێت و لە چوار چێوەی رەزامەندی دابێت.", "target": "ئاینی ئیسلام بایەخ دەدات بەکاری بە کۆمەڵ، و دژ بە دووبەرەکی، چ لە رووی پەرستش یان مامەڵە و کاروباری رۆژانە. خودای پەروەردگار هەرکارێکی هەرەوەز بە پیرۆز ناوزەددەکات بە مەرجێک سود بەخش بێت و لە چوار چێوەی رەزامەندی دابێت.", "errors": [], "source_id": "9656", "category": "islamic_studies"}
{"original": "هەژار و دەوڵەمەندێک سپی پێست‌و رەش پێستێک، کورد و عەرەب و هەر نەتەوەیەکی دیکە، لەبەردەم یاسای خودادا یەکسانن، پێویستە ئەم هەست بە یەکسانی کردنەش لە ناخی هەر یەکەماندا بە قوڵی بچەسپێت.", "corrupted": "هەژار و دەوڵەمەندێک سپی پێست‌و رەش پێستێک، کورد و عەرەب و هەر نەتەوەیەکی دیکە، لەبەردەم یاسای خودادا یەکسانن، پێویستە ئەم هەست بە یەکسانی کردنەش لە ناخی هەر یەکەماندا بە قوڵی بچەسپێت.", "source": "هەژار و دەوڵەمەندێک سپی پێست‌و رەش پێستێک، کورد و عەرەب و هەر نەتەوەیەکی دیکە، لەبەردەم یاسای خودادا یەکسانن، پێویستە ئەم هەست بە یەکسانی کردنەش لە ناخی هەر یەکەماندا بە قوڵی بچەسپێت.", "target": "هەژار و دەوڵەمەندێک سپی پێست‌و رەش پێستێک، کورد و عەرەب و هەر نەتەوەیەکی دیکە، لەبەردەم یاسای خودادا یەکسانن، پێویستە ئەم هەست بە یەکسانی کردنەش لە ناخی هەر یەکەماندا بە قوڵی بچەسپێت.", "errors": [], "source_id": "8283", "category": "islamic_studies"}
{"original": "لەئەنجامی ئەمانەو زۆر هۆکاری تریش هێزەکانی ئێران لە ۱۷ کانوونی یەکەم ساڵی ۱۹۴۶ پەلاماری شاری(مەەاباد)پایتەختی کۆماری کوردستانیان داو داگیریان کردەوە.", "corrupted": "لەئەنجامی ئەمانەو زۆر هۆکاری تریش هێزەکانی ئێران لە ۱۷ کانوونی یەکەم ساڵی ۱۹۴۶ پەلاماری شاری(مەەاباد)پایتەختی کۆمار کوردستانیان داو داگیرمان کردەوە.", "source": "لەئەنجامی ئەمانەو زۆر هۆکاری تریش هێزەکانی ئێران لە ۱۷ کانوونی یەکەم ساڵی ۱۹۴۶ پەلاماری شاری(مەەاباد)پایتەختی کۆمار کوردستانیان داو داگیرمان کردەوە.", "target": "لەئەنجامی ئەمانەو زۆر هۆکاری تریش هێزەکانی ئێران لە ۱۷ کانوونی یەکەم ساڵی ۱۹۴۶ پەلاماری شاری(مەەاباد)پایتەختی کۆماری کوردستانیان داو داگیریان کردەوە.", "errors": [{"type": "clitic_form", "original": "داگیریان", "error": "داگیرمان", "start": 133, "end": 141, "description": "clitic_form: 'داگیریان' → 'داگیرمان'"}, {"type": "noun_adjective_agreement", "original": "کۆماری کوردستانیان", "error": "کۆمار کوردستانیان", "start": 110, "end": 128, "description": "noun_adjective_agreement: 'کۆماری کوردستانیان' → 'کۆمار کوردستانیان'"}], "source_id": "1025", "category": "history"}
{"original": "لە ئیسلامدا خێزانەکان‌و دایک‌و باوکان دەبێت بە ئاەەنگ‌و خۆشییەوە پێشوازی لە هاتنە دونیای منداڵ بکەن‌و بە هێمای خێرو خۆشی بزانن.", "corrupted": "لە ئیسلامدا خێزانەکان‌و دایک‌و باوکان دەبێت بە ئاەەنگ‌و خۆشییەوە پێشوازی لە هاتنە دونیای منداڵ بکەن‌و بە هێمای خێرو خۆشی بزانن.", "source": "لە ئیسلامدا خێزانەکان‌و دایک‌و باوکان دەبێت بە ئاەەنگ‌و خۆشییەوە پێشوازی لە هاتنە دونیای منداڵ بکەن‌و بە هێمای خێرو خۆشی بزانن.", "target": "لە ئیسلامدا خێزانەکان‌و دایک‌و باوکان دەبێت بە ئاەەنگ‌و خۆشییەوە پێشوازی لە هاتنە دونیای منداڵ بکەن‌و بە هێمای خێرو خۆشی بزانن.", "errors": [], "source_id": "7075", "category": "islamic_studies"}
{"original": "چونکە خێزان و ژیانی نێو خێزان وەک دۆزەخیان لێدێت بەەۆی زۆری کێشە و ناتەبایی و نەمانی دڵسۆزی لە خێزان دوورەپەرێز دەبن و نەوجەوان لە ماڵەوە دەردەچێت و لە هاوشێوەی خۆی دەگەڕێت و تووشی کاری خراپ دێ.", "corrupted": "چونکە خێزان و ژیانی نێو خێزان وەک دۆزەخیان لێدێت بەەۆ زۆری کێشە و ناتەبایی و نەمانی دڵسۆزی لە خێزان دوورەپەرێز دەبن و نەوجەوان لە ماڵەوە دەردەچێت و لە هاوشێوەیی خۆی دەگەڕێت و تووشی کاری خراپ دێ.", "source": "چونکە خێزان و ژیانی نێو خێزان وەک دۆزەخیان لێدێت بەەۆ زۆری کێشە و ناتەبایی و نەمانی دڵسۆزی لە خێزان دوورەپەرێز دەبن و نەوجەوان لە ماڵەوە دەردەچێت و لە هاوشێوەیی خۆی دەگەڕێت و تووشی کاری خراپ دێ.", "target": "چونکە خێزان و ژیانی نێو خێزان وەک دۆزەخیان لێدێت بەەۆی زۆری کێشە و ناتەبایی و نەمانی دڵسۆزی لە خێزان دوورەپەرێز دەبن و نەوجەوان لە ماڵەوە دەردەچێت و لە هاوشێوەی خۆی دەگەڕێت و تووشی کاری خراپ دێ.", "errors": [{"type": "noun_adjective_agreement", "original": "هاوشێوەی خۆی", "error": "هاوشێوەیی خۆی", "start": 152, "end": 164, "description": "noun_adjective_agreement: 'هاوشێوەی خۆی' → 'هاوشێوەیی خۆی'"}, {"type": "noun_adjective_agreement", "original": "بەەۆی زۆری", "error": "بەەۆ زۆری", "start": 49, "end": 59, "description": "noun_adjective_agreement: 'بەەۆی زۆری' → 'بەەۆ زۆری'"}], "source_id": "4705", "category": "social_sciences"}
