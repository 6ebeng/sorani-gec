{"original": "لەەەمان کاتدا ئەو ناوچەیە بەپێی ڕێکەوتننامەی سایکس بیکۆ بۆ فەرەنسا دانرابوو، بۆیە ئەمانە لەنێوان بەریتانیا و عوسمانییەکان، دواتریش لەنێوان عێراق و تورکیا کێشەیەکیان دروست کرد کە لە مێژوودا بەکێشەی موسڵ ناسراوە.", "corrupted": "لەەەمان کاتدا ئەو ناوچەیە بەپێەکەی ڕێکەوتننامەی سایکس بیکۆ بۆ فەرەنسا دانرابوو، بۆیە ئەمانە لەنێوان بەریتانیا و عوسمانییەکان، دواتریش لەنێوان عێراقین و تورکیا کێشەیەکیان دروست کرد کە لە مێژوودا بەکێشەی موسڵ ناسراوە.", "source": "لەەەمان کاتدا ئەو ناوچەیە بەپێەکەی ڕێکەوتننامەی سایکس بیکۆ بۆ فەرەنسا دانرابوو، بۆیە ئەمانە لەنێوان بەریتانیا و عوسمانییەکان، دواتریش لەنێوان عێراقین و تورکیا کێشەیەکیان دروست کرد کە لە مێژوودا بەکێشەی موسڵ ناسراوە.", "target": "لەەەمان کاتدا ئەو ناوچەیە بەپێی ڕێکەوتننامەی سایکس بیکۆ بۆ فەرەنسا دانرابوو، بۆیە ئەمانە لەنێوان بەریتانیا و عوسمانییەکان، دواتریش لەنێوان عێراق و تورکیا کێشەیەکیان دروست کرد کە لە مێژوودا بەکێشەی موسڵ ناسراوە.", "errors": [{"type": "noun_adjective_agreement", "original": "عێراق", "error": "عێراقین", "start": 139, "end": 144, "description": "noun_adjective_agreement: 'عێراق' → 'عێراقین'"}, {"type": "noun_adjective_agreement", "original": "بەپێی ڕێکەوتننامەی", "error": "بەپێەکەی ڕێکەوتننامەی", "start": 26, "end": 44, "description": "noun_adjective_agreement: 'بەپێی ڕێکەوتننامەی' → 'بەپێەکەی ڕێکەوتننامەی'"}], "source_id": "631", "category": "history"}
