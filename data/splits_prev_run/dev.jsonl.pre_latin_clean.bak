{"original": "جووڵەی ئەو تەنەیە کاتێک هەموو ئەو تەوەرانەی لەسەر تەنەکە چەسپ دەکرێت بەدرێژایی جوولەکەی هاورێک دەبن. جا ئەگەر تەنەکە لەسەر هێڵی ڕاست بجوڵێت ئەوە جوولەکەی بە هێڵە وەئەگەر جوولەکەی لەسەر ڕێڕەوێکی بازنەیی بێت ئەوە جوولەکە بازنەییە.", "corrupted": "جووڵەی ئەۆ تەنەیە کاتیک هەموو ئەو تەوەڕانەی لەسەر تەنەکە چەسپ دەکرێت بەدڕێژایی جوولەکەی هاۆرێک دەبن. جا ئەگەر تەنەکە لەسەر هێڵی راست بجوڵێت ئەوە جوولەکەی بە هێڵە وەئەگەر جوولەکەی لەسەر ڕێڕەوێکی بازنەیی بیت ئەوە جوولەکە باژنەییە.", "source": "جووڵەی ئەۆ تەنەیە کاتیک هەموو ئەو تەوەڕانەی لەسەر تەنەکە چەسپ دەکرێت بەدڕێژایی جوولەکەی هاۆرێک دەبن. جا ئەگەر تەنەکە لەسەر هێڵی راست بجوڵێت ئەوە جوولەکەی بە هێڵە وەئەگەر جوولەکەی لەسەر ڕێڕەوێکی بازنەیی بیت ئەوە جوولەکە باژنەییە.", "target": "جووڵەی ئەو تەنەیە کاتێک هەموو ئەو تەوەرانەی لەسەر تەنەکە چەسپ دەکرێت بەدرێژایی جوولەکەی هاورێک دەبن. جا ئەگەر تەنەکە لەسەر هێڵی ڕاست بجوڵێت ئەوە جوولەکەی بە هێڵە وەئەگەر جوولەکەی لەسەر ڕێڕەوێکی بازنەیی بێت ئەوە جوولەکە بازنەییە.", "errors": [{"type": "orthography", "original": "بازنەییە.", "error": "باژنەییە.", "start": 219, "end": 228, "description": "orthography: 'بازنەییە.' → 'باژنەییە.'"}, {"type": "orthography", "original": "بێت", "error": "بیت", "start": 202, "end": 205, "description": "orthography: 'بێت' → 'بیت'"}, {"type": "orthography", "original": "ڕاست", "error": "راست", "start": 128, "end": 132, "description": "orthography: 'ڕاست' → 'راست'"}, {"type": "orthography", "original": "هاورێک", "error": "هاۆرێک", "start": 88, "end": 94, "description": "orthography: 'هاورێک' → 'هاۆرێک'"}, {"type": "orthography", "original": "بەدرێژایی", "error": "بەدڕێژایی", "start": 69, "end": 78, "description": "orthography: 'بەدرێژایی' → 'بەدڕێژایی'"}, {"type": "orthography", "original": "تەوەرانەی", "error": "تەوەڕانەی", "start": 34, "end": 43, "description": "orthography: 'تەوەرانەی' → 'تەوەڕانەی'"}, {"type": "orthography", "original": "کاتێک", "error": "کاتیک", "start": 18, "end": 23, "description": "orthography: 'کاتێک' → 'کاتیک'"}, {"type": "