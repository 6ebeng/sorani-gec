{"original": "ئەییوبی پێشەنگی ئارامگران ئەمەی ئەنجامداو خودا کردیە شیفای، لێرە بەدواوە رەوشەکە گۆڕا، تەندروستی ئەییوب بەرەو باشی دەرۆیشت سەرزەویەکان بوژانەوە، بەروبوم جارێکی دیکە دەرکەوت، سامان‌و دارایی گەشەی کردەوە.", "corrupted": "ئەییوبی پێشەنگی ئارامگران ئەمەی ئەنجامداو خودا کردیە شیفای،لێرە بەدواوە رەوشەکە گۆڕ ا، تەندروستی ئەییوب بەرەوباشی دەرۆیشت سەرزەویەکان بوژانەوە، بەر وبوم جارێکی دیکە دەرکەوت، سامان‌و دارایی گەشەی کردەوە.", "source": "ئەییوبی پێشەنگی ئارامگران ئەمەی ئەنجامداو خودا کردیە شیفای،لێرە بەدواوە رەوشەکە گۆڕ ا، تەندروستی ئەییوب بەرەوباشی دەرۆیشت سەرزەویەکان بوژانەوە، بەر وبوم جارێکی دیکە دەرکەوت، سامان‌و دارایی گەشەی کردەوە.", "target": "ئەییوبی پێشەنگی ئارامگران ئەمەی ئەنجامداو خودا کردیە شیفای، لێرە بەدواوە رەوشەکە گۆڕا، تەندروستی ئەییوب بەرەو باشی دەرۆیشت سەرزەویەکان بوژانەوە، بەروبوم جارێکی دیکە دەرکەوت، سامان‌و دارایی گەشەی کردەوە.", "errors": [{"type": "whitespace", "original": "بەروبوم", "error": "بەر وبوم", "start": 145, "end": 152, "description": "whitespace: 'بەروبوم' → 'بەر وبوم'"}, {"type": "whitespace", "original": "بەرەو باشی", "error": "بەرەوباشی", "start": 104, "end": 114, "description": "whitespace: 'بەرەو باشی' → 'بەرەوباشی'"}, {"type": "whitespace", "original": "گۆڕا،", "error": "گۆڕ ا،", "start": 81, "end": 86, "description": "whitespace: 'گۆڕا،' → 'گۆڕ ا،'"}, {"type": "whitespace", "original": "شیفای، لێرە", "error": "شیفای،لێرە", "start": 53, "end": 64, "description": "whitespace: 'شیفای، لێرە' → 'شیفای،لێرە'"}], "source_id": "7633", "category": "islamic_studies"}
