{"original": "مرۆڤێک بوو لەبەرخودا کەسێکی دەویست و هەر لەبەر خوداش پشتی لێ هەڵئەکرد، ئەوا ئەو مرۆڤە کەسێکی بە رەوشتە.", "corrupted": "مرۆڤێک بوو لەبەرغودا کەسێکێ دەویست و هەڕ ڵەبەر خۆداش پشتی لی هەڵئەکرد، ئەوا ئەو مرۆڤە کەسێکێ بە رەوشتە.", "source": "مرۆڤێک بوو لەبەرغودا کەسێکێ دەویست و هەڕ ڵەبەر خۆداش پشتی لی هەڵئەکرد، ئەوا ئەو مرۆڤە کەسێکێ بە رەوشتە.", "target": "مرۆڤێک بوو لەبەرخودا کەسێکی دەویست و هەر لەبەر خوداش پشتی لێ هەڵئەکرد، ئەوا ئەو مرۆڤە کەسێکی بە رەوشتە.", "errors": [{"type": "orthography", "original": "کەسێکی", "error": "کەسێکێ", "start": 86, "end": 92, "description": "orthography: 'کەسێکی' → 'کەسێکێ'"}, {"type": "orthography", "original": "لێ", "error": "لی", "start": 58, "end": 60, "description": "orthography: 'لێ' → 'لی'"}, {"type": "orthography", "original": "خوداش", "error": "خۆداش", "start": 47, "end": 52, "description": "orthography: 'خوداش' → 'خۆداش'"}, {"type": "orthography", "original": "لەبەر", "error": "ڵەبەر", "start": 41, "end": 46, "description": "orthography: 'لەبەر' → 'ڵەبەر'"}, {"type": "orthography", "original": "هەر", "error": "هەڕ", "start": 37, "end": 40, "description": "orthography: 'هەر' → 'هەڕ'"}, {"type": "orthography", "original": "کەسێکی", "error": "کەسێکێ", "start": 21, "end": 27, "description": "orthography: 'کەسێکی' → 'کەسێکێ'"}, {"type": "orthography", "original": "لەبەرخودا", "error": "لەبەرغودا", "start": 11, "end": 20, "description": "orthography: 'لەبەرخودا' → 'لەبەرغودا'"}], "source_id": "5072", "category": "islamic_studies"}
{"original": "شێخ: ئەوانیش ڕێبەری ئاینیین، و لە سێ بنەمالەی سەرەکی پێک دێن کە ئەمانەن و هەریەکەیان تایبەتمەندی خۆی هەیە لە ڕووی پلە و پایەی ئایینییەوە. و ژن و ژنخوازی لە نێوان ئەم سێ بنەمالەشدا گوناحە.", "corrupted": "شێخ: ئەوانیش ڕێبەری ئاینیین، و لە سێ بنەمالەی سەرەکی پێک دێن کە ئەمانەن و هەریەکەیان تایبەتمەندی خۆی هەیە لە ڕووی پلە و پایەی ئایینییەوە. و ژن و ژنخوازی لە نێوان ئەم سێ بنەمالەشدا گوناحە.", "source": "شێخ: ئەوانیش ڕێبەری ئاینیین، و لە سێ بنەمالەی سەرەکی پێک دێن کە ئەمانەن و هەریەکەیان تایبەتمەندی خۆی هەیە لە ڕووی پلە و پایەی ئایینییەوە. و ژن و ژنخوازی لە نێوان ئەم سێ بنەمالەشدا گوناحە.", "target": "شێخ: ئەوانیش ڕێبەری ئاینیین، و لە سێ بنەمالەی سەرەکی پێک دێن کە ئەمانەن و هەریەکەیان تایبەتمەندی خۆی هەیە لە ڕووی پلە و پایەی ئایینییەوە. و ژن و ژنخوازی لە نێوان ئەم سێ بنەمالەشدا گوناحە.", "errors": [], "source_id": "3432", "category": "islamic_studies"}
