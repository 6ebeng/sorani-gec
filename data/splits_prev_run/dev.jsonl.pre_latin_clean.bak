{"original": "عەباسییەکان دوای چارەکە سەدەیەک خەباتی نەێنی و رێکخراوەیی لە ساڵی ۱۳۲ کۆچی / ۷۴۹ زایینی و بە پشتیوانی مەوالییەکان توانیان دەوڵەتی ئومەری لە ناوببەن و دەسەڵات بگرنە دەست و بۆماوەی پتر لە پێنج سەدە خەلافەیان بە دەستەوە بوو.", "corrupted": "عەباسییەکان دوای چارەکە سەدەیەک خەباتی نەێنی و ڕێکخراوەیی لە سالی ۱۳۲ کۆچی / ۷۴۹ ژایینی و بە پشتیوانی مەوالییەکان توانیان دەوڵەتی ئومەری لە ناوببەن و دەسەڵات بگرنە دەست و بۆماوەی پتر لە پێنج سەدە خەلافەیان بە دەستەوە بوو.", "source": "عەباسییەکان دوای چارەکە سەدەیەک خەباتی نەێنی و ڕێکخراوەیی لە سالی ۱۳۲ کۆچی / ۷۴۹ ژایینی و بە پشتیوانی مەوالییەکان توانیان دەوڵەتی ئومەری لە ناوببەن و دەسەڵات بگرنە دەست و بۆماوەی پتر لە پێنج سەدە خەلافەیان بە دەستەوە بوو.", "target": "عەباسییەکان دوای چارەکە سەدەیەک خەباتی نەێنی و رێکخراوەیی لە ساڵی ۱۳۲ کۆچی / ۷۴۹ زایینی و بە پشتیوانی مەوالییەکان توانیان دەوڵەتی ئومەری لە ناوببەن و دەسەڵات بگرنە دەست و بۆماوەی پتر لە پێنج سەدە خەلافەیان بە دەستەوە بوو.", "errors": [{"type": "spelling_confusion", "original": "زایینی", "error": "ژایینی", "start": 81, "end": 87, "description": "spelling_confusion: 'زایینی' → 'ژایینی'"}, {"type": "spelling_confusion", "original": "ساڵی", "error": "سالی", "start": 61, "end": 65, "description": "spelling_confusion: 'ساڵی' → 'سالی'"}, {"type": "spelling_confusion", "original": "رێکخراوەیی", "error": "ڕێکخراوەیی", "start": 47, "end": 57, "description": "spelling_confusion: 'رێکخراوەیی' → 'ڕێکخراوەیی'"}], "source_id": "2590", "category": "history"}
{"original": "هەڵگیرساندنی جەنگی جیەانی یەکەم لە سەدەی بیستەمدا. هەر لەبەر ئەو هۆیانەش دەوڵەتان بیریان لەوە کردەوە کە رژێمێکی نویی دەوڵەتی بەێننە کایەوە کە لە کۆمەڵەی گەلان بوو.", "corrupted": "هەڵگیرساندنی جەنگی جیەانی یەکەم لە سەدەی بیستەمدا. هەر لەبەر ئەو هۆیانەش دەوڵەتان بیریان لەوە کردەوە کە رژێمێکی نویی دەوڵەتی بەێننە کایەوە کە لە کۆمەڵەی گەلان بوو.", "source": "هەڵگیرساندنی جەنگی جیەانی یەکەم لە سەدەی بیستەمدا. هەر لەبەر ئەو هۆیانەش دەوڵەتان بیریان لەوە کردەوە کە رژێمێکی نویی دەوڵەتی بەێننە کایەوە کە لە کۆمەڵەی گەلان بوو.", "target": "هەڵگیرساندنی جەنگی جیەانی یەکەم لە سەدەی بیستەمدا. هەر لەبەر ئەو هۆیانەش دەوڵەتان بیریان لەوە کردەوە کە رژێمێکی نویی دەوڵەتی بەێننە کایەوە کە لە کۆمەڵەی گەلان بوو.", "errors": [], "source_id": "571", "category": "social_sciences"}
