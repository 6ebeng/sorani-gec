{"original": "هێز دەتوانرێت بپێورێت بە پێی بڕی ئەو شێوانەی توشی سپرینگێکی لە سەرێکیەوە هەڵواسراو دەبێت کاتێک هێزەکە کار لە سەرەکەی تری سپرینگەکە دەکات، بەم جۆرە سپرینگە دەووترێت قەپانی سپرینگی کە بەکاردێت بۆ پێوانی بڕی هێز.", "corrupted": "هێز دەتوانرێت بپێورێی بە پێی بڕی ئەو شێوانەی توشی سپرینگێکی لە سەرێکیەوە هەڵواسراو دەبێت کاتێک هێزەکە کار لە سەرەکەی تری سپرینگەکە دەکات، بەم جۆرە سپڕینگە دەووترێت قەپانی سپرینگی کە بەکاردێت بۆ پێوانی بری هێز.", "source": "هێز دەتوانرێت بپێورێی بە پێی بڕی ئەو شێوانەی توشی سپرینگێکی لە سەرێکیەوە هەڵواسراو دەبێت کاتێک هێزەکە کار لە سەرەکەی تری سپرینگەکە دەکات، بەم جۆرە سپڕینگە دەووترێت قەپانی سپرینگی کە بەکاردێت بۆ پێوانی بری هێز.", "target": "هێز دەتوانرێت بپێورێت بە پێی بڕی ئەو شێوانەی توشی سپرینگێکی لە سەرێکیەوە هەڵواسراو دەبێت کاتێک هێزەکە کار لە سەرەکەی تری سپرینگەکە دەکات، بەم جۆرە سپرینگە دەووترێت قەپانی سپرینگی کە بەکاردێت بۆ پێوانی بڕی هێز.", "errors": [{"type": "spelling_confusion", "original": "بڕی", "error": "بری", "start": 201, "end": 204, "description": "spelling_confusion: 'بڕی' → 'بری'"}, {"type": "spelling_confusion", "original": "سپرینگە", "error": "سپڕینگە", "start": 147, "end": 154, "description": "spelling_confusion: 'سپرینگە' → 'سپڕینگە'"}, {"type": "clitic_form", "original": "بپێورێت", "error": "بپێورێی", "start": 14, "end": 21, "description": "clitic_form: 'بپێورێت' → 'بپێورێی'"}], "source_id": "6880", "category": "sciences"}
