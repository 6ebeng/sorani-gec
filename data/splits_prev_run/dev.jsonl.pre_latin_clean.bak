{"original": "وێرای ئەوە ژمارە لە ڕووی پێکەاتنەوە خاوەنی تایبەتییەکی دیاری کراوی وەەایە، کە لەبەشە ئاخاوتنەکانی دی جیادەکاتەوە.", "corrupted": "وێرای ئەوە ژمارە لە ڕووی پێکەاتنەوە خاوەنی تایبەتییەکی دیاری کراوی وەەایە، کە لەبەشە ئاخاوتنەکانی دی جیادەکاتەوە.", "source": "وێرای ئەوە ژمارە لە ڕووی پێکەاتنەوە خاوەنی تایبەتییەکی دیاری کراوی وەەایە، کە لەبەشە ئاخاوتنەکانی دی جیادەکاتەوە.", "target": "وێرای ئەوە ژمارە لە ڕووی پێکەاتنەوە خاوەنی تایبەتییەکی دیاری کراوی وەەایە، کە لەبەشە ئاخاوتنەکانی دی جیادەکاتەوە.", "errors": [], "source_id": "7658", "category": "linguistics"}
{"original": "خۆکوشتنی بێئومێدی: واتە ئەو کەسەی لە هەموو ژیان بێئومێد دەبێ دونیای لەلا رەش دەبێ و ئەم رێگەیە بە باشترین رێگە دەزانێ و هیچ رێگەچارەیەکی دیکە بەدی ناکات.", "corrupted": "خۆکوشتنی بێئومێدی: واتە ئەو کەسەی لە هەموو ژیان بێئومێد دەبێ دونیای لەلا رەش دەبێ و ئەم رێگەیە بە باشترین رێگە دەزانێ و هیچ رێگەچارەیەکی دیکە بەدی ناکات.", "source": "خۆکوشتنی بێئومێدی: واتە ئەو کەسەی لە هەموو ژیان بێئومێد دەبێ دونیای لەلا رەش دەبێ و ئەم رێگەیە بە باشترین رێگە دەزانێ و هیچ رێگەچارەیەکی دیکە بەدی ناکات.", "target": "خۆکوشتنی بێئومێدی: واتە ئەو کەسەی لە هەموو ژیان بێئومێد دەبێ دونیای لەلا رەش دەبێ و ئەم رێگەیە بە باشترین رێگە دەزانێ و هیچ رێگەچارەیەکی دیکە بەدی ناکات.", "errors": [], "source_id": "5076", "category": "social_sciences"}
{"original": "خزمەتی فرە مەزنی نەتەوەکەی کردووە، چونکە بەردەوام خامە ڕەنگینەکەی بۆ مەبەستی وشیارکردنەوەی میللەتەکەی خستۆتە کار، لەم بوارەدا یەکێکە لەو نووسەرانەی کە بەەۆی بەرەەمەکانییەوە وای کردووە بچێتە ڕیزی پێشەنگانی ئەو نووسەرانەی کە بەرەەمیان زۆرە.", "corrupted": "خزمەتی فرە مەزنی نەتەوەکەی کردووە، چونکە بەردەوام خامە ڕەنگینەکەی بۆ مەبەستی وشیارکردنەوەی میللەتەکەی خستۆتە کار، لەم بوارەدا یەکێکە لەو نووسەرانەی کە بەەۆی بەرەەمەکانییەوە وای کردووە بچێتن ڕیزی پێشەنگانی ئەو نووسەرانەی کە بەرەەمیان زۆرە.", "source": "خزمەتی فرە مەزنی نەتەوەکەی کردووە، چونکە بەردەوام خامە ڕەنگینەکەی بۆ مەبەستی وشیارکردنەوەی میللەتەکەی خستۆتە کار، لەم بوارەدا یەکێکە لەو نووسەرانەی کە بەەۆی بەرەەمەکانییەوە وای کردووە بچێتن ڕیزی پێشەنگانی ئەو نووسەرانەی کە بەرەەمیان زۆرە.", "target": "خزمەتی فرە مەزنی نەتەوەکەی کردووە، چونکە بەردەوام خامە ڕەنگینەکەی بۆ مەبەستی وشیارکردنەوەی میللەتەکەی خستۆتە کار، لەم بوارەدا یەکێکە لەو نووسەرانەی کە بەەۆی بەرەەمەکانییەوە وای کردووە بچێتە ڕیزی پێشەنگانی ئەو نووسەرانەی کە بەرەەمیان زۆرە.", "errors": [{"type": "subject_verb_number", "original": "بچێتە", "error": "بچێتن", "start": 184, "end": 189, "description": "subject_verb_number: 'بچێتە' → 'بچێتن'"}], "source_id": "9305", "category": "linguistics"}
