{"original": "ئەو کارانەی کە معاویە دەستی پێکردبوون عەبدولمەلیک تەواوی کردن وەک ڕێکخستنی دیوانی، زەویانە بوو، پاش ئارام بوونەوەی بارودۆخی دەوڵەت دەستیان کرد بە سەرژمێرکردنی جولەکەو مەسیحی، بۆ دانانی سەرانە لە سەریان.", "corrupted": "ئەو کارانەی کە معاویە دەستن پێکردبوون عەبدولمەلیک تەواوی کردن وەک ڕێکخستنی دیوانی، زەویانە بوو، پاش ئارام بوونەوەی بارودۆخی دەوڵەت دەستیان کرد بە سەرژمێرکردنی جولەکەو مەسیحی، بۆ دانانی سەرانە لە سەریان.", "source": "ئەو کارانەی کە معاویە دەستن پێکردبوون عەبدولمەلیک تەواوی کردن وەک ڕێکخستنی دیوانی، زەویانە بوو، پاش ئارام بوونەوەی بارودۆخی دەوڵەت دەستیان کرد بە سەرژمێرکردنی جولەکەو مەسیحی، بۆ دانانی سەرانە لە سەریان.", "target": "ئەو کارانەی کە معاویە دەستی پێکردبوون عەبدولمەلیک تەواوی کردن وەک ڕێکخستنی دیوانی، زەویانە بوو، پاش ئارام بوونەوەی بارودۆخی دەوڵەت دەستیان کرد بە سەرژمێرکردنی جولەکەو مەسیحی، بۆ دانانی سەرانە لە سەریان.", "errors": [{"type": "subject_verb_number", "original": "دەستی", "error": "دەستن", "start": 22, "end": 27, "description": "subject_verb_number: 'دەستی' → 'دەستن'"}], "source_id": "4816", "category": "social_sciences"}
{"original": "ئەم جۆرە جوگرافیایە لە دیاردەی سروشتی و مرۆیی ڕابردوو دەکۆڵێتەوە، وەک دیاردەی بەرز و نزمی ڕووی زەوی، دەریا، زەریاکان، بارودۆخی ئاووەەوا و ڕووەکی سروشتی و گیانلەبەران، هەروەەا لە جیاوازی وێکنەچوونی چالاکییە ئابووریەکانی مرۆیی هەر سەدەیەکی مێژووی دەکۆڵێتەوە.", "corrupted": "ئەم جۆرە جوگرافیایە لە دیاردەی سروشتی و مرۆیی ڕابردوو دەکۆڵێتەوە، وەک دیاردەی بەرز و نزمی ڕووی زەوی، دەریا، زەریاکان، بارودۆخی ئاووەەوا و ڕووەکی سروشتی و گیانلەبەران، هەروەەا لە جیاوازی وێکنەچوونی چالاکییە ئابووریەکانی مرۆیی هەر سەدەیەکی مێژووی دەکۆڵێتەوە.", "source": "ئەم جۆرە جوگرافیایە لە دیاردەی سروشتی و مرۆیی ڕابردوو دەکۆڵێتەوە، وەک دیاردەی بەرز و نزمی ڕووی زەوی، دەریا، زەریاکان، بارودۆخی ئاووەەوا و ڕووەکی سروشتی و گیانلەبەران، هەروەەا لە جیاوازی وێکنەچوونی چالاکییە ئابووریەکانی مرۆیی هەر سەدەیەکی مێژووی دەکۆڵێتەوە.", "target": "ئەم جۆرە جوگرافیایە لە دیاردەی سروشتی و مرۆیی ڕابردوو دەکۆڵێتەوە، وەک دیاردەی بەرز و نزمی ڕووی زەوی، دەریا، زەریاکان، بارودۆخی ئاووەەوا و ڕووەکی سروشتی و گیانلەبەران، هەروەەا لە جیاوازی وێکنەچوونی چالاکییە ئابووریەکانی مرۆیی هەر سەدەیەکی مێژووی دەکۆڵێتەوە.", "errors": [], "source_id": "8022", "category": "social_sciences"}
