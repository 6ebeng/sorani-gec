{"original": "لە تورکیا کوردەکان لە ناو و ناونیشانی خۆیان بێبەشکران، بەسەردا چەسپاندن. لە ئێران کورد بە هۆزێکی ئێرانی کۆن دانراوە و زمانی کوردیش بە دیالێکتێکی زمانی فارسی دانراوە.", "corrupted": "لە تورکیا کوردەکان لە ناو و ناونیشانی خۆیان بێبەشکران، بەسەردا چەسپاندن. لە ئێران کورد بە هۆزێکی ئێرانی کۆن دانراوە و زمانی کوردیش بە دیالێکتێکی زمانی فارسی دانراوە.", "source": "لە تورکیا کوردەکان لە ناو و ناونیشانی خۆیان بێبەشکران، بەسەردا چەسپاندن. لە ئێران کورد بە هۆزێکی ئێرانی کۆن دانراوە و زمانی کوردیش بە دیالێکتێکی زمانی فارسی دانراوە.", "target": "لە تورکیا کوردەکان لە ناو و ناونیشانی خۆیان بێبەشکران، بەسەردا چەسپاندن. لە ئێران کورد بە هۆزێکی ئێرانی کۆن دانراوە و زمانی کوردیش بە دیالێکتێکی زمانی فارسی دانراوە.", "errors": [], "source_id": "5128", "category": "history"}
{"original": "خاوەنی هەمان تافی گراماتیکیین، بەڵام لە خستنەتەکیەکی ڕستە هاوتافەکاندا بە پێی جێکەوتەی ڕستەکە پلەی ڕوودانی تافەکە دەگۆڕێت، لە (۱۰)دا بە نموونەوە ڕووندەکرێتەوە.", "corrupted": "خاوەنەکەی هەمان تافی گراماتیکیین، بەڵام لە خستنەتەکیەکی ڕستە هاوتافەکاندا بە پێی جێکەوتەی ڕستەکە پلەی ڕوودانی تافەکان دەگۆڕێت، لە (۱۰)دا بە نموونەوە ڕووندەکرێتەوە.", "source": "خاوەنەکەی هەمان تافی گراماتیکیین، بەڵام لە خستنەتەکیەکی ڕستە هاوتافەکاندا بە پێی جێکەوتەی ڕستەکە پلەی ڕوودانی تافەکان دەگۆڕێت، لە (۱۰)دا بە نموونەوە ڕووندەکرێتەوە.", "target": "خاوەنی هەمان تافی گراماتیکیین، بەڵام لە خستنەتەکیەکی ڕستە هاوتافەکاندا بە پێی جێکەوتەی ڕستەکە پلەی ڕوودانی تافەکە دەگۆڕێت، لە (۱۰)دا بە نموونەوە ڕووندەکرێتەوە.", "errors": [{"type": "noun_adjective_agreement", "original": "تافەکە", "error": "تافەکان", "start": 107, "end": 113, "description": "noun_adjective_agreement: 'تافەکە' → 'تافەکان'"}, {"type": "noun_adjective_agreement", "original": "خاوەنی هەمان", "error": "خاوەنەکەی هەمان", "start": 0, "end": 12, "description": "noun_adjective_agreement: 'خاوەنی هەمان' → 'خاوەنەکەی هەمان'"}], "source_id": "5711", "category": "linguistics"}
{"original": "کۆیلە بە موڵکی خاوەنەکەی دادەنرا، نیشانەی کۆیلەیی لە دەست یان لە لەشی دەدرا، ئاغاکەی بۆی هەبوو بیفرۆشێ یان بە خەڵات بیدا بەم و ئەم، وێرای ئەوەش کۆیلە هەندێک مافی هەبوو وەکو ژنەێنان و خاوەنداری.", "corrupted": "کۆیلە بە موڵکی خاوەنەکەی دادەنرا، نیشانەی کۆیلەیی لە دەسم یان لە لەشت دەدرا، ئاغاکەی بۆی هەبوو بیفرۆشێ یان بە خەڵات بیدا بە ئەم و ئەم، وێرای ئەوەش کۆیلە هەندێک مافی هەبوو وەکو ژنەێنان و خاوەنداری.", "source": "کۆیلە بە موڵکی خاوەنەکەی دادەنرا، نیشانەی کۆیلەیی لە دەسم یان لە لەشت دەدرا، ئاغاکەی بۆی هەبوو بیفرۆشێ یان بە خەڵات بیدا بە ئەم و ئەم، وێرای ئەوەش کۆیلە هەندێک مافی هەبوو وەکو ژنەێنان و خاوەنداری.", "target": "کۆیلە بە موڵکی خاوەنەکەی دادەنرا، نیشانەی کۆیلەیی لە دەست یان لە لەشی دەدرا، ئاغاکەی بۆی هەبوو بیفرۆشێ یان بە خەڵات بیدا بەم و ئەم، وێرای ئەوەش کۆیلە هەندێک مافی هەبوو وەکو ژنەێنان و خاوەنداری.", "errors": [{"type": "clitic_form", "original": "لەشی", "error": "لەشت", "start": 65, "end": 69, "description": "clitic_form: 'لەشی' → 'لەشت'"}, {"type": "clitic_form", "original": "دەست", "error": "دەسم", "start": 53, "end": 57, "description": "clitic_form: 'دەست' → 'دەسم'"}, {"type": "demonstrative_contraction", "original": "بەم", "error": "بە ئەم", "start": 121, "end": 124, "description": "demonstrative_contraction: 'بەم' → 'بە ئەم'"}], "source_id": "5621", "category": "history"}
