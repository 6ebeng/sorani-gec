{"original": "لە دوای شەڕی جیەانی دووەم لە ئەورووپا پشت بەستن بە کانی خەڵوز بۆ پیشەسازی کەمتر بووەو، ئەمەش بەەۆی هێنانی نەوت لە بەکارەێنانی لە جیاتی خەڵوز لە بواری پیشەسازییەوە.", "corrupted": "لە دوای شەڕی جیەانی دووەم لە ئەورووپا پشت بەستن بە کانی خەڵوز بۆ پیشەسازی کەمتر بووەو، ئەمەش بەەۆی هێنانی نەوت لە بەکارەێنانی لە جیاتی خەڵوز لە بواری پیشەسازییەوە.", "source": "لە دوای شەڕی جیەانی دووەم لە ئەورووپا پشت بەستن بە کانی خەڵوز بۆ پیشەسازی کەمتر بووەو، ئەمەش بەەۆی هێنانی نەوت لە بەکارەێنانی لە جیاتی خەڵوز لە بواری پیشەسازییەوە.", "target": "لە دوای شەڕی جیەانی دووەم لە ئەورووپا پشت بەستن بە کانی خەڵوز بۆ پیشەسازی کەمتر بووەو، ئەمەش بەەۆی هێنانی نەوت لە بەکارەێنانی لە جیاتی خەڵوز لە بواری پیشەسازییەوە.", "errors": [], "source_id": "1190", "category": "social_sciences"}
{"original": "شێخ ئەحمەد هەمیشە لەگەڵ بەرپرسە بەریتانییەکاندا جەختی لەسەر ئەوە دەکردەوە کەپارەو سامان و شۆێنی بەرزی ناوێ، بەڵکو دەیەوێ لەسەر زێدی باب و باپیرانی خۆیان بەئازادی بژین، بەڵام ئینگلیزەکان بەردەوام مەترسی دەست پێکردنی شۆڕشیان هەبوو لەناوچەکە.", "corrupted": "شێخ ئەحمەد هەمیشە لەگەڵ بەرپرسە بەریتانییەکاندا جەختی لەسەر ئەوە دەکردەوە کەپارەو سامان و شۆێنی بەرزی ناوێ، بەڵکو دەیەوێ لەسەر زێدی باب و باپیرانی خۆیان بەئازادی بژین، بەڵام ئینگلیزەکان بەردەوام مەترسی دەست پێکردنی شۆڕشیان هەبوو لەناوچەکە.", "source": "شێخ ئەحمەد هەمیشە لەگەڵ بەرپرسە بەریتانییەکاندا جەختی لەسەر ئەوە دەکردەوە کەپارەو سامان و شۆێنی بەرزی ناوێ، بەڵکو دەیەوێ لەسەر زێدی باب و باپیرانی خۆیان بەئازادی بژین، بەڵام ئینگلیزەکان بەردەوام مەترسی دەست پێکردنی شۆڕشیان هەبوو لەناوچەکە.", "target": "شێخ ئەحمەد هەمیشە لەگەڵ بەرپرسە بەریتانییەکاندا جەختی لەسەر ئەوە دەکردەوە کەپارەو سامان و شۆێنی بەرزی ناوێ، بەڵکو دەیەوێ لەسەر زێدی باب و باپیرانی خۆیان بەئازادی بژین، بەڵام ئینگلیزەکان بەردەوام مەترسی دەست پێکردنی شۆڕشیان هەبوو لەناوچەکە.", "errors": [], "source_id": "4709", "category": "history"}
