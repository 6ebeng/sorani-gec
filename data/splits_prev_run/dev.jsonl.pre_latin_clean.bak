{"original": "داتەپاندنی ژێرخانی ئابووری کوردستان، لە رێگای وێرانکردنی گوندەکان و کێلگە کشتوکاڵیەکان، کە بووە هۆی لەناوبردنی رێژەی هەرە زۆری سامانی ئاژەڵی ناوچەکانی کوردستان، لەگەڵ بەتاڵان بردنی ماڵ و سامانی گوندنشینەکان.", "corrupted": "داتەپاندنی ژێرخانی ئابووری کوردستان، لە ڕێگای ووێرانکردنی گوندەکان و کێلگە کشتوکاڵیەکان، کە بووە هۆی لەناوبردنی رێژەی هەڕە زۆری سامانی ئاژەلی ناوچەکانی کۆردستان، لەگەڵ بەتاڵان بردنی ماڵ وو سامانی گوندنشینەکان.", "source": "داتەپاندنی ژێرخانی ئابووری کوردستان، لە ڕێگای ووێرانکردنی گوندەکان و کێلگە کشتوکاڵیەکان، کە بووە هۆی لەناوبردنی رێژەی هەڕە زۆری سامانی ئاژەلی ناوچەکانی کۆردستان، لەگەڵ بەتاڵان بردنی ماڵ وو سامانی گوندنشینەکان.", "target": "داتەپاندنی ژێرخانی ئابووری کوردستان، لە رێگای وێرانکردنی گوندەکان و کێلگە کشتوکاڵیەکان، کە بووە هۆی لەناوبردنی رێژەی هەرە زۆری سامانی ئاژەڵی ناوچەکانی کوردستان، لەگەڵ بەتاڵان بردنی ماڵ و سامانی گوندنشینەکان.", "errors": [{"type": "orthography", "original": "و", "error": "وو", "start": 185, "end": 186, "description": "orthography: 'و' → 'وو'"}, {"type": "orthography", "original": "کوردستان،", "error": "کۆردستان،", "start": 151, "end": 160, "description": "orthography: 'کوردستان،' → 'کۆردستان،'"}, {"type": "orthography", "original": "ئاژەڵی", "error": "ئاژەلی", "start": 134, "end": 140, "description": "orthography: 'ئاژەڵی' → 'ئاژەلی'"}, {"type": "orthography", "original": "هەرە", "error": "هەڕە", "start": 117, "end": 121, "description": "orthography: 'هەرە' → 'هەڕە'"}, {"type": "orthography", "original": "وێرانکردنی", "error": "ووێرانکردنی", "start": 46, "end": 56, "description": "orthography: 'وێرانکردنی' → 'ووێرانکردنی'"}, {"type": "orthography", "original": "رێگای", "error": "ڕێگای", "start": 40, "end": 45, "description": "orthography: 'رێگای' → 'ڕێگای'"}], "source_id": "4375", "category": "history"}
{"original": "لەم ڕۆژە گەلی کوردستان بەجۆش و خرۆشەوە چونە سەر سندوقی دەنگدان لە پرۆسەیەکی دیموکراسی دا زیاتر۹۲% دەنگیان بە بەلێ دا بۆ سەربەخۆیی کوردستان.", "corrupted": "لەم ڕۆژە گەلی کوردستان بەجۆش و خرۆشەوە چونە سەر سندوقی دەنگدان لە پرۆسەیەکی دیموکراسی دا زیاتر۹۲% دەنگیان بە بەلێ دا بۆ سەربەخۆیم کوردستان.", "source": "لەم ڕۆژە گەلی کوردستان بەجۆش و خرۆشەوە چونە سەر سندوقی دەنگدان لە پرۆسەیەکی دیموکراسی دا زیاتر۹۲% دەنگیان بە بەلێ دا بۆ سەربەخۆیم کوردستان.", "target": "لەم ڕۆژە گەلی کوردستان بەجۆش و خرۆشەوە چونە سەر سندوقی دەنگدان لە پرۆسەیەکی دیموکراسی دا زیاتر۹۲% دەنگیان بە بەلێ دا بۆ سەربەخۆیی کوردستان.", "errors": [{"type": "possessive_clitic", "original": "سەربەخۆیی", "error": "سەربەخۆیم", "start": 120, "end": 129, "description": "possessive_clitic: 'سەربەخۆیی' → 'سەربەخۆیم'"}], "source_id": "981", "category": "law"}
{"original": "دەتوانرێت هەزاران لەپێکەێنەرەکانی سووڕە کارەباییەکان لەسەر تەبەقێکی تەنک دروست بکرێت کە ڕووبەرەکەی لە کەمتر بێت. هەرزانی ترانزستەر و دایۆد لەوە دایە کە دەتوانرێت لەەەمان ساتدا ژمارەیەکی زۆریان لێ دروست بکرێت.", "corrupted": "دەتوانرێت هەزاران لەپێکەێنەرەکانی سووڕە کارەباییەکان لەسەر تەبەقێکی تەنک دروست بکرێت کە ڕووبەرەکەی لە کەمتر بێت. هەرزانی ترانزستەر و دایۆد لەوە دایە کە دەتوانرێت لەەەمان ساتدا ژمارەیەکی زۆریان لێ دروست بکرێت.", "source": "دەتوانرێت هەزاران لەپێکەێنەرەکانی سووڕە کارەباییەکان لەسەر تەبەقێکی تەنک دروست بکرێت کە ڕووبەرەکەی لە کەمتر بێت. هەرزانی ترانزستەر و دایۆد لەوە دایە کە دەتوانرێت لەەەمان ساتدا ژمارەیەکی زۆریان لێ دروست بکرێت.", "target": "دەتوانرێت هەزاران لەپێکەێنەرەکانی سووڕە کارەباییەکان لەسەر تەبەقێکی تەنک دروست بکرێت کە ڕووبەرەکەی لە کەمتر بێت. هەرزانی ترانزستەر و دایۆد لەوە دایە کە دەتوانرێت لەەەمان ساتدا ژمارەیەکی زۆریان لێ دروست بکرێت.", "errors": [], "source_id": "1916", "category": "sciences"}
