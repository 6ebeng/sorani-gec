{"original": "ڕووبارەکە ڕێرەوی خۆی بەئاراستەی باشووری ڕۆژئاوا دەگۆڕێت و لە نزیک شوێنەوارەکانی نەمرود دەڕژێتە دیجلەوە. درێژی زێی گەورە ۳۹۲کم. داەاتی ئاوی ساڵانەی دەگاتە ۱۳.۲۹ملیار /م۳ ئەم ڕووبارە بە ڕێژەی ۳۳% بەشداری لەکۆی ساڵانەی ئاوی دیجلە دەکات.", "corrupted": "ڕووبارەکە ڕێرەوی خۆی بەئاراستەی باشووری ڕۆژئاوا دەگۆڕێت و لە نزیک شوێنەوارەکانی نەمرود دەڕژێتە دیجلەوە. درێژی زێی گەورە ۳۹۲کم. داەاتی ئاوی ساڵانەی دەگاتە ۱۳.۲۹ملیار /م۳ ئەم ڕووبارە بە ڕێژەی ۳۳% بەشداری لەکۆی ساڵانەی ئاوی دیجلە دەکات.", "source": "ڕووبارەکە ڕێرەوی خۆی بەئاراستەی باشووری ڕۆژئاوا دەگۆڕێت و لە نزیک شوێنەوارەکانی نەمرود دەڕژێتە دیجلەوە. درێژی زێی گەورە ۳۹۲کم. داەاتی ئاوی ساڵانەی دەگاتە ۱۳.۲۹ملیار /م۳ ئەم ڕووبارە بە ڕێژەی ۳۳% بەشداری لەکۆی ساڵانەی ئاوی دیجلە دەکات.", "target": "ڕووبارەکە ڕێرەوی خۆی بەئاراستەی باشووری ڕۆژئاوا دەگۆڕێت و لە نزیک شوێنەوارەکانی نەمرود دەڕژێتە دیجلەوە. درێژی زێی گەورە ۳۹۲کم. داەاتی ئاوی ساڵانەی دەگاتە ۱۳.۲۹ملیار /م۳ ئەم ڕووبارە بە ڕێژەی ۳۳% بەشداری لەکۆی ساڵانەی ئاوی دیجلە دەکات.", "errors": [], "source_id": "7322", "category": "social_sciences"}
{"original": "واتە: بێگومان خودای پەروەردگار خاوەن سۆزو ئەو خەسڵەتەشی خۆشدەوێ، لەەەر کەسێشدا سۆزو میەرەبانی هەبێت خودای گەورە پاداشتی ئەوتۆی دەکات کە بەمرۆڤی رەق وتوند رەفتاری نادات.", "corrupted": "واتە: بێگومان خودای پەروەردگار خاوەن سۆزو ئەو خەسڵەتەشی خۆشدەوێ، لەەەر کەسێشدا سۆزو میەرەبانی هەبێت خودای گەورە پاداشتی ئەوتۆی دەکات کە بەمرۆڤی رەق وتوند رەفتاری نادات.", "source": "واتە: بێگومان خودای پەروەردگار خاوەن سۆزو ئەو خەسڵەتەشی خۆشدەوێ، لەەەر کەسێشدا سۆزو میەرەبانی هەبێت خودای گەورە پاداشتی ئەوتۆی دەکات کە بەمرۆڤی رەق وتوند رەفتاری نادات.", "target": "واتە: بێگومان خودای پەروەردگار خاوەن سۆزو ئەو خەسڵەتەشی خۆشدەوێ، لەەەر کەسێشدا سۆزو میەرەبانی هەبێت خودای گەورە پاداشتی ئەوتۆی دەکات کە بەمرۆڤی رەق وتوند رەفتاری نادات.", "errors": [], "source_id": "4763", "category": "islamic_studies"}
{"original": "لەگەلأ ئەوەشدا بەرزبوونەوە و نزمبوونەوەی پلەکانی گەرمی ڕۆژ و شەو کاریان لێ دەکات و لێکیان دەترازێنێت و بەرەبەرە دەیانکات بە تۆپەڵ ی بچووک بچوک و وورد دەبن تا دەبن بە رەگەزە کانزای جیاواز.", "corrupted": "لەگەلأ ئەوەشدا بەرزبوونەوە و نزمبوونەوەی پلەکانی گەرمی ڕۆژ و شەو کاریان لێ دەکات و لێکیان دەترازێنێت و بەرەبەرە دەیانکات بە تۆپەڵ ی بچووک بچوک و وورد دەبن تا دەبن بە رەگەزە کانزای جیاواز.", "source": "لەگەلأ ئەوەشدا بەرزبوونەوە و نزمبوونەوەی پلەکانی گەرمی ڕۆژ و شەو کاریان لێ دەکات و لێکیان دەترازێنێت و بەرەبەرە دەیانکات بە تۆپەڵ ی بچووک بچوک و وورد دەبن تا دەبن بە رەگەزە کانزای جیاواز.", "target": "لەگەلأ ئەوەشدا بەرزبوونەوە و نزمبوونەوەی پلەکانی گەرمی ڕۆژ و شەو کاریان لێ دەکات و لێکیان دەترازێنێت و بەرەبەرە دەیانکات بە تۆپەڵ ی بچووک بچوک و وورد دەبن تا دەبن بە رەگەزە کانزای جیاواز.", "errors": [], "source_id": "8901", "category": "social_sciences"}
