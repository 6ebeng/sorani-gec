{"original": "سەرەرای ئەوانەش هەواکەی ناویشی کپەو گەلێ مێروو جڕو جانەوەریش اە ناو دارستانەکاندا بڵاو بوونەتەوە، لە لایەکی تریشەوە ئاوەرۆیەکی زۆریش بەسەر زەوی ئەو دارستانانەدا دەڕوات، کە لەوانەیە گیانلەبەری دارستانەکە وەکو باڵندە و خشۆک بە تایبەتیش مار دەچنە ناویانەوە.", "corrupted": "سەرەرا ئەوانەش هەواکەی ناویشی کپەو گەلێ مێروو جڕو جانەوەریش اە ناو دارستانەکاندا بڵاو بوونەتەوە، لە لایەکی تریشەوە ئاوەرۆیەک زۆریش بەسەر زەوی ئەو دارستانانەدا دەڕوات، کە لەوانەیە گیانلەبەری دارستانەکە وەکو باڵندە و خشۆک بە تایبەتیش مار دەچنە ناویانەوە.", "source": "سەرەرا ئەوانەش هەواکەی ناویشی کپەو گەلێ مێروو جڕو جانەوەریش اە ناو دارستانەکاندا بڵاو بوونەتەوە، لە لایەکی تریشەوە ئاوەرۆیەک زۆریش بەسەر زەوی ئەو دارستانانەدا دەڕوات، کە لەوانەیە گیانلەبەری دارستانەکە وەکو باڵندە و خشۆک بە تایبەتیش مار دەچنە ناویانەوە.", "target": "سەرەرای ئەوانەش هەواکەی ناویشی کپەو گەلێ مێروو جڕو جانەوەریش اە ناو دارستانەکاندا بڵاو بوونەتەوە، لە لایەکی تریشەوە ئاوەرۆیەکی زۆریش بەسەر زەوی ئەو دارستانانەدا دەڕوات، کە لەوانەیە گیانلەبەری دارستانەکە وەکو باڵندە و خشۆک بە تایبەتیش مار دەچنە ناویانەوە.", "errors": [{"type": "noun_adjective_agreement", "original": "ئاوەرۆیەکی زۆریش", "error": "ئاوەرۆیەک زۆریش", "start": 116, "end": 132, "description": "noun_adjective_agreement: 'ئاوەرۆیەکی زۆریش' → 'ئاوەرۆیەک زۆریش'"}, {"type": "noun_adjective_agreement", "original": "سەرەرای ئەوانەش", "error": "سەرەرا ئەوانەش", "start": 0, "end": 15, "description": "noun_adjective_agreement: 'سەرەرای ئەوانەش' → 'سەرەرا ئەوانەش'"}], "source_id": "2095", "category": "social_sciences"}
