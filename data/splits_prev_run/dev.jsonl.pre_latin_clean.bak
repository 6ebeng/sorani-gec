{"original": "ئەم ئەرکە پێویستی بەکاری زیاتر هەیە لەبواری زانست و زانیاری وشارەزایی دا، ئەمەیان پسپۆرێتی فەیلەسووفە کە لە هەموو ڕووداوو دیاردەیەکدا، چ لە بواری سروشتدا بێت، یاخود لەبواری ڕەوشت وبەەاکاندا بێت، ئەوپەڕی بنەماو ڕەگەز و سەرچاوەکانی دەپشکنێت و هەڵیان دەسەنگێنێت.", "corrupted": "ئەمئەرکە پێویستی بەک اری زیاتر هەیە لەبواری زانست و زانیاری وشارەزایی دا، ئە مەیان پسپۆرێتی فەیلەسووفە کە لە هەموو ڕووداوو دیاردەیەکدا، چ لەبواریسروشتدابێت، یاخود لەبواری ڕەوشت وبەەاکاندا بێت، ئەوپەڕی بنە ماو ڕەگەز و سەرچاوەکانی دەپش کنێت و هەڵیان دەسەنگێنێت.", "source": "ئەمئەرکە پێویستی بەک اری زیاتر هەیە لەبواری زانست و زانیاری وشارەزایی دا، ئە مەیان پسپۆرێتی فەیلەسووفە کە لە هەموو ڕووداوو دیاردەیەکدا، چ لەبواریسروشتدابێت، یاخود لەبواری ڕەوشت وبەەاکاندا بێت، ئەوپەڕی بنە ماو ڕەگەز و سەرچاوەکانی دەپش کنێت و هەڵیان دەسەنگێنێت.", "target": "ئەم ئەرکە پێویستی بەکاری زیاتر هەیە لەبواری زانست و زانیاری وشارەزایی دا، ئەمەیان پسپۆرێتی فەیلەسووفە کە لە هەموو ڕووداوو دیاردەیەکدا، چ لە بواری سروشتدا بێت، یاخود لەبواری ڕەوشت وبەەاکاندا بێت، ئەوپەڕی بنەماو ڕەگەز و سەرچاوەکانی دەپشکنێت و هەڵیان دەسەنگێنێت.", "errors": [{"type": "whitespace", "original": "دەپشکنێت", "error": "دەپش کنێت", "start": 230, "end": 238, "description": "whitespace: 'دەپشکنێت' → 'دەپش کنێت'"}, {"type": "whitespace", "original": "بنەماو", "error": "بنە ماو", "start": 203, "end": 209, "description": "whitespace: 'بنەماو' → 'بنە ماو'"}, {"type": "whitespace", "original": "سروشتدا بێت،", "error": "سروشتدابێت،", "start": 146, "end": 158, "description": "whitespace: 'سروشتدا بێت،' → 'سروشتدابێت،'"}, {"type": "whitespace", "original": "بواری سروشتدا", "error": "بواریسروشتدا", "start": 140, "end": 153, "description": "whitespace: 'بواری سروشتدا' → 'بواریسروشتدا'"}, {"type": "whitespace", "original": "لە بواری", "error": "لەبواری", "start": 137, "end": 145, "description": "whitespace: 'لە بواری' → 'لەبواری'"}, {"type": "whitespace", "original": "ئەمەیان", "error": "ئە مەیان", "start": 74, "end": 81, "description": "whitespace: '