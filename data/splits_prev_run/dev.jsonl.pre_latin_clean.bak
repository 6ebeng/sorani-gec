{"original": "لەوانەیە ترس یان برسێتی یان مسۆگەرکردنی ئارامی و سەلامەتی خاوخێزان ناچاریکردبن کۆچ بکەن، رەنگە هەر بۆخۆشیش وڵاتەکەیان جێبێڵن. لەوانەشە تێکەڵەیەک لەو هۆکارانە پاڵی پێوەنابن. بەوجۆرە کەسانە دەوترێ کۆچبەر.", "corrupted": "لەوانەیە ترس یان برسێتی یان مسۆگەرکردنی ئاڕامی و سەلامەتی خاوخێزان ناچاریکردبن کۆچ بکەن، رەنگە هەر بۆخۆشیش وڵاتەکەیان جێبێڵن. ڵەوانەشە تێکەڵەیەک لەو هۆکاڕانە پاڵی پێوەنابن. بەوجۆڕە کەسانە دەوتڕێ کۆچبەر.", "source": "لەوانەیە ترس یان برسێتی یان مسۆگەرکردنی ئاڕامی و سەلامەتی خاوخێزان ناچاریکردبن کۆچ بکەن، رەنگە هەر بۆخۆشیش وڵاتەکەیان جێبێڵن. ڵەوانەشە تێکەڵەیەک لەو هۆکاڕانە پاڵی پێوەنابن. بەوجۆڕە کەسانە دەوتڕێ کۆچبەر.", "target": "لەوانەیە ترس یان برسێتی یان مسۆگەرکردنی ئارامی و سەلامەتی خاوخێزان ناچاریکردبن کۆچ بکەن، رەنگە هەر بۆخۆشیش وڵاتەکەیان جێبێڵن. لەوانەشە تێکەڵەیەک لەو هۆکارانە پاڵی پێوەنابن. بەوجۆرە کەسانە دەوترێ کۆچبەر.", "errors": [{"type": "spelling_confusion", "original": "دەوترێ", "error": "دەوتڕێ", "start": 188, "end": 194, "description": "spelling_confusion: 'دەوترێ' → 'دەوتڕێ'"}, {"type": "spelling_confusion", "original": "بەوجۆرە", "error": "بەوجۆڕە", "start": 173, "end": 180, "description": "spelling_confusion: 'بەوجۆرە' → 'بەوجۆڕە'"}, {"type": "spelling_confusion", "original": "هۆکارانە", "error": "هۆکاڕانە", "start": 149, "end": 157, "description": "spelling_confusion: 'هۆکارانە' → 'هۆکاڕانە'"}, {"type": "spelling_confusion", "original": "لەوانەشە", "error": "ڵەوانەشە", "start": 126, "end": 134, "description": "spelling_confusion: 'لەوانەشە' → 'ڵەوانەشە'"}, {"type": "spelling_confusion", "original": "ئارامی", "error": "ئاڕامی", "start": 40, "end": 46, "description": "spelling_confusion: 'ئارامی' → 'ئاڕامی'"}], "source_id": "417", "category": "law"}
{"original": "بەەۆی ئەو ڤۆڵتیەی دەخرێتە سەر تۆڕە دەتوانرێت دەست بەسەر ژمارەی ئەو ئەلکترۆنانە دابگیرێت کە لە کاسۆدەوە دەردەچن و بەرەو ئەنۆد دەڕۆن، وە لەئەنجامدا دەست بەسەر تەزووی ئەنۆد دابگیرێت هەر لەبەر ئەوەشە پێی دەگوترێ .", "corrupted": "بەەۆی ئەو ڤۆڵتیەی دەخرێتە سەر تۆڕە دەتوانڕێت دەست بەسەڕ ژمارەی ئەوو ئەڵکترۆنانە دابگیرێت کە لە کاسۆدەوە دەڕدەچن و بەرەو ئەنۆد دەڕۆن، وە لەئەنجامدا دەست بەسەر تەزووی ئەنۆض دابگیرێت هەڕ لەبەر ئەوەشە پێی دەگوتری.", "source": "بەەۆی ئەو ڤۆڵتیەی دەخرێتە سەر تۆڕە دەتوانڕێت دەست بەسەڕ ژمارەی ئەوو ئەڵکترۆنانە دابگیرێت کە لە کاسۆدەوە دەڕدەچن و بەرەو ئەنۆد دەڕۆن، وە لەئەنجامدا دەست بەسەر تەزووی ئەنۆض دابگیرێت هەڕ لەبەر ئەوەشە پێی دەگوتری.", "target": "بەەۆی ئەو ڤۆڵتیەی دەخرێتە سەر تۆڕە دەتوانرێت دەست بەسەر ژمارەی ئەو ئەلکترۆنانە دابگیرێت کە لە کاسۆدەوە دەردەچن و بەرەو ئەنۆد دەڕۆن، وە لەئەنجامدا دەست بەسەر تەزووی ئەنۆد دابگیرێت هەر لەبەر ئەوەشە پێی دەگوترێ .", "errors": [{"type": "orthography", "original": "دەگوترێ", "error": "دەگوتری", "start": 200, "end": 207, "description": "orthography: 'دەگوترێ' → 'دەگوتری'"}, {"type": "orthography", "original": "هەر", "error": "هەڕ", "start": 179, "end": 182, "description": "orthography: 'هەر' → 'هەڕ'"}, {"type": "orthography", "original": "ئەو", "error": "ئەوو", "start": 63, "end": 66, "description": "orthography: 'ئەو' → 'ئەوو'"}, {"type": "orthography", "original": "بەسەر", "error": "بەسەڕ", "start": 50, "end": 55, "description": "orthography: 'بەسەر' → 'بەسەڕ'"}, {"type": "spelling_confusion", "original": "ئەنۆد", "error": "ئەنۆض", "start": 165, "end": 170, "description": "spelling_confusion: 'ئەنۆد' → 'ئەنۆض'"}, {"type": "spelling_confusion", "original": "دەردەچن", "error": "دەڕدەچن", "start": 104, "end": 111, "description": "spelling_confusion: 'دەردەچن' → 'دەڕدەچن'"}, {"type": "spelling_confusion", "original": "ئەلکترۆنانە", "error": "ئەڵکترۆنانە", "start": 68, "end": 79, "description": "spelling_confusion: 'ئەلکترۆنانە' → 'ئەڵکترۆنانە'"}, {"type": "spelling_confusion", "original": "دەتوانرێت", 