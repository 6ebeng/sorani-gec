{"original": "وتار خوێن دوای وتارەکەی لەسەر دوانگە دێتە خوارێ و پێشنوێژی دەکات بۆ ئامادەبووان، نوێژی هەینی، دوو رکاتە و پێشنوێژ بە دەنگی بیستراو قورئانەکەی تیا دەخوێنێت.", "corrupted": "وتارخوێن دوای وتارەکەی لەس ەردوانگە دێتەخوارێ و پێشنوێژی دەکات بۆ ئامادەبووان، نوێژی هەینی، دوو رکاتە و پێشنو ێژ بە دەنگی بیستراو قورئانەکەی تیا دەخوێنێت.", "source": "وتارخوێن دوای وتارەکەی لەس ەردوانگە دێتەخوارێ و پێشنوێژی دەکات بۆ ئامادەبووان، نوێژی هەینی، دوو رکاتە و پێشنو ێژ بە دەنگی بیستراو قورئانەکەی تیا دەخوێنێت.", "target": "وتار خوێن دوای وتارەکەی لەسەر دوانگە دێتە خوارێ و پێشنوێژی دەکات بۆ ئامادەبووان، نوێژی هەینی، دوو رکاتە و پێشنوێژ بە دەنگی بیستراو قورئانەکەی تیا دەخوێنێت.", "errors": [{"type": "whitespace", "original": "پێشنوێژ", "error": "پێشنو ێژ", "start": 106, "end": 113, "description": "whitespace: 'پێشنوێژ' → 'پێشنو ێژ'"}, {"type": "whitespace", "original": "دێتە خوارێ", "error": "دێتەخوارێ", "start": 37, "end": 47, "description": "whitespace: 'دێتە خوارێ' → 'دێتەخوارێ'"}, {"type": "whitespace", "original": "لەسەر دوانگە", "error": "لەسەردوانگە", "start": 24, "end": 36, "description": "whitespace: 'لەسەر دوانگە' → 'لەسەردوانگە'"}, {"type": "whitespace", "original": "لەسەر", "error": "لەس ەر", "start": 24, "end": 29, "description": "whitespace: 'لەسەر' → 'لەس ەر'"}, {"type": "whitespace", "original": "وتار خوێن", "error": "وتارخوێن", "start": 0, "end": 9, "description": "whitespace: 'وتار خوێن' → 'وتارخوێن'"}], "source_id": "7176", "category": "islamic_studies"}
