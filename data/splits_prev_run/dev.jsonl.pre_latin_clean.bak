{"original": "هەرچی پەیوەندی بە شایەتیدانیشەوە هەیە، وەک زانایان فەرمویانە دۆخێکی مێژویی (تحکم)ی لەسەر مەسەلەکەدا کردووە‌و ئەوەی لە ئایەتەکەی سورەتی بەقەرەو یاسای ئیسلامیشدا گرنگە نەفەوتانی مافی لایەنەکانی مامەڵە ئابورییەکەیە.", "corrupted": "هەرچی پەیوەندی بە شایەتیدانیشەوە هەیە، ووەک زانایان فەرموویانە دۆخێکی مێژویی (تحکم)ی لەسەر مەسەلەکەدا کردووە‌و ئەوەن لە یایەتەکەی سورەتی بەقەرەو یاسای ئیسڵامیشدا گرنگە نەفەوتانی مافێ لایەنەکانی مامەڵە ئابورییەکەیە.", "source": "هەرچی پەیوەندی بە شایەتیدانیشەوە هەیە، ووەک زانایان فەرموویانە دۆخێکی مێژویی (تحکم)ی لەسەر مەسەلەکەدا کردووە‌و ئەوەن لە یایەتەکەی سورەتی بەقەرەو یاسای ئیسڵامیشدا گرنگە نەفەوتانی مافێ لایەنەکانی مامەڵە ئابورییەکەیە.", "target": "هەرچی پەیوەندی بە شایەتیدانیشەوە هەیە، وەک زانایان فەرمویانە دۆخێکی مێژویی (تحکم)ی لەسەر مەسەلەکەدا کردووە‌و ئەوەی لە ئایەتەکەی سورەتی بەقەرەو یاسای ئیسلامیشدا گرنگە نەفەوتانی مافی لایەنەکانی مامەڵە ئابورییەکەیە.", "errors": [{"type": "subject_verb_number", "original": "ئەوەی", "error": "ئەوەن", "start": 109, "end": 114, "description": "subject_verb_number: 'ئەوەی' → 'ئەوەن'"}, {"type": "orthography", "original": "مافی", "error": "مافێ", "start": 176, "end": 180, "description": "orthography: 'مافی' → 'مافێ'"}, {"type": "orthography", "original": "ئیسلامیشدا", "error": "ئیسڵامیشدا", "start": 149, "end": 159, "description": "orthography: 'ئیسلامیشدا' → 'ئیسڵامیشدا'"}, {"type": "orthography", "original": "ئایەتەکەی", "error": "یایەتەکەی", "start": 118, "end": 127, "description": "orthography: 'ئایەتەکەی' → 'یایەتەکەی'"}, {"type": "orthography", "original": "فەرمویانە", "error": "فەرموویانە", "start": 51, "end": 60, "description": "orthography: 'فەرمویانە' → 'فەرموویانە'"}, {"type": "orthography", "original": "وەک", "error": "ووەک", "start": 39, "end": 42, "description": "orthography: 'وەک' → 'ووەک'"}], "source_id": "3988", "category": "islamic_studies"}
