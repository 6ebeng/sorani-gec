{"original": "ئەمەش بووە هۆی زیادبوونی خەرجی گشتی لە بەرژەوەندی تاکەکانی کۆمەڵگەدا بەتایبەتی چینی هەژار لەپێناو بەرزکردنەوەی ئاستی داەات و کەمکردنەوەیی جیاوازی داەاتەکانیان و قەرەبووکردنەوەی ئەو تاکانەی کە لەئەنجامی بڕیارێکی دادوەریی بەر تاک یاخود کۆمەڵێ کەس دەکەوێت.", "corrupted": "ئەمەش بووە هۆی زیادبوونی خەرجی گشتی لە بەرژەوەندی تاکەکانی کۆمەڵگەدا بەتایبەتی چینی هەژار لەپێناو بەرزکردنەوەی ئاستی داەات و کەمکردنەوەیی جیاوازی داەاتەکانیان و قەرەبووکردنەوەی ئەو تاکانەی کە لەئەنجامی بڕیارێکی دادوەریی بەر تاک یاخود کۆمەڵێ کەس دەکەوێت.", "source": "ئەمەش بووە هۆی زیادبوونی خەرجی گشتی لە بەرژەوەندی تاکەکانی کۆمەڵگەدا بەتایبەتی چینی هەژار لەپێناو بەرزکردنەوەی ئاستی داەات و کەمکردنەوەیی جیاوازی داەاتەکانیان و قەرەبووکردنەوەی ئەو تاکانەی کە لەئەنجامی بڕیارێکی دادوەریی بەر تاک یاخود کۆمەڵێ کەس دەکەوێت.", "target": "ئەمەش بووە هۆی زیادبوونی خەرجی گشتی لە بەرژەوەندی تاکەکانی کۆمەڵگەدا بەتایبەتی چینی هەژار لەپێناو بەرزکردنەوەی ئاستی داەات و کەمکردنەوەیی جیاوازی داەاتەکانیان و قەرەبووکردنەوەی ئەو تاکانەی کە لەئەنجامی بڕیارێکی دادوەریی بەر تاک یاخود کۆمەڵێ کەس دەکەوێت.", "errors": [], "source_id": "2505", "category": "economics"}
{"original": "نەبوونی وشەی تر ڕێککەوت لەگەڵ ئەم کۆمەڵە ئەو نیشانە دەدات کە فۆنیمەکانی زمانی کوردی هەر ئەم حەوتەن.", "corrupted": "نەبوونی وشەی تر ڕێککەوت لەگەڵ ئەم کۆمەڵە ئەو نیشانە دەدات کە فۆنیمەکانی زمانی کوردی هەر ئەم حەوتەن.", "source": "نەبوونی وشەی تر ڕێککەوت لەگەڵ ئەم کۆمەڵە ئەو نیشانە دەدات کە فۆنیمەکانی زمانی کوردی هەر ئەم حەوتەن.", "target": "نەبوونی وشەی تر ڕێککەوت لەگەڵ ئەم کۆمەڵە ئەو نیشانە دەدات کە فۆنیمەکانی زمانی کوردی هەر ئەم حەوتەن.", "errors": [], "source_id": "5469", "category": "linguistics"}
{"original": "ئەو لێکخشاندنەیە لە نێوان دوو ڕوو پەیدا دەبێت کاتێک یەکێکیان لەسەر ئەوی تریان دەخلیسکێت و لەباری جوولە دادەبێت بە خێراییەکی نەگۆر.", "corrupted": "ئەو لێکخشاندنەیە لە نێوان دوو ڕوو پەیدا دەبێت کاتێک یەکێکیان لەسەر ئەوی تریان دەخلیسکێت و لەباری جوولە دادەبێت بە خێراییەکی نەگۆر.", "source": "ئەو لێکخشاندنەیە لە نێوان دوو ڕوو پەیدا دەبێت کاتێک یەکێکیان لەسەر ئەوی تریان دەخلیسکێت و لەباری جوولە دادەبێت بە خێراییەکی نەگۆر.", "target": "ئەو لێکخشاندنەیە لە نێوان دوو ڕوو پەیدا دەبێت کاتێک یەکێکیان لەسەر ئەوی تریان دەخلیسکێت و لەباری جوولە دادەبێت بە خێراییەکی نەگۆر.", "errors": [], "source_id": "7441", "category": "sciences"}
{"original": "تۆمارە و یەکان لە دا ئاماژەیان بە دانیشتوانی کۆنی کوردستان کردووە، کوردستان لەو سەردەمە ناوی ی لێنراوە، بە دانیشتوانەکەشیان وتووە و هەروەەا وەک و بۆ دانیشتوانی کوردستان بەکارەاتووە.", "corrupted": "تۆمارە و یەکان لە دا ئاماژەیان بە دانیشتوانی کۆنی کوردستان کردووە، کوردستان لەو سەردەمە ناوی ی لێنراوە، بە دانیشتوانەکەشیان وتووە و هەروەەا وەک و بۆ دانیشتوانی کوردستان بەکارەاتووە.", "source": "تۆمارە و یەکان لە دا ئاماژەیان بە دانیشتوانی کۆنی کوردستان کردووە، کوردستان لەو سەردەمە ناوی ی لێنراوە، بە دانیشتوانەکەشیان وتووە و هەروەەا وەک و بۆ دانیشتوانی کوردستان بەکارەاتووە.", "target": "تۆمارە و یەکان لە دا ئاماژەیان بە دانیشتوانی کۆنی کوردستان کردووە، کوردستان لەو سەردەمە ناوی ی لێنراوە، بە دانیشتوانەکەشیان وتووە و هەروەەا وەک و بۆ دانیشتوانی کوردستان بەکارەاتووە.", "errors": [], "source_id": "2623", "category": "history"}
{"original": "ئەو مافەی بەشێوەیەکی راستەقینە بە کورد نەبەخشی و ئەو دەسەڵاتەی کە دەمەزرا لە ئەنجوومەنی یاسادانان و ئەنجومەنی راپەراندن تەنەا دوو دەزگای رووکەش بوون، ئەگینا دەسەڵات و بڕیارەکان هەر لە حکومەتی مەرکەزیەوە دەردەچوون.", "corrupted": "ئەو ماڤەی بەشێوەیەکی راستەقینە بە کوڕد نەبەخشی و ئەو دەسەڵاتەی کە دەمەزرا لە یەنجوومەنی یاسادانان و یەنجومەنی راپەراندن تەنەا دوو دەزگای رووکەش بون، ئەگینا دەسەلات و بڕیارەکان هەر ڵە حکومەتی مەرکەزیەوە دەردەچون.", "source": "ئەو ماڤەی بەشێوەیەکی راستەقینە بە کوڕد نەبەخشی و ئەو دەسەڵاتەی کە دەمەزرا لە یەنجوومەنی یاسادانان و یەنجومەنی راپەراندن تەنەا دوو دەزگای رووکەش بون، ئەگینا دەسەلات و بڕیارەکان هەر ڵە حکومەتی مەرکەزیەوە دەردەچون.", "target": "ئەو مافەی بەشێوەیەکی راستەقینە بە کورد نەبەخشی و ئەو دەسەڵاتەی کە دەمەزرا لە ئەنجوومەنی یاسادانان و ئەنجومەنی راپەراندن تەنەا دوو دەزگای رووکەش بوون، ئەگینا دەسەڵات و بڕیارەکان هەر لە حکومەتی مەرکەزیەوە دەردەچوون.", "errors": [{"type": "orthography", "original": "دەردەچوون.", "error": "دەردەچون.", "start": 203, "end": 213, "description": "orthography: 'دەردەچوون.' → 'دەردەچون.'"}, {"type": "orthography", "original": "لە", "error": "ڵە", "start": 181, "end": 183, "description": "orthography: 'لە' → 'ڵە'"}, {"type": "orthography", "original": "دەسەڵات", "error": "دەسەلات", "start": 157, "end": 164, "description": "orthography: 'دەسەڵات' → 'دەسەلات'"}, {"type": "orthography", "original": "بوون،", "error": "بون،", "start": 144, "end": 149, "description": "orthography: 'بوون،' → 'بون،'"}, {"type": "orthography", "original": "ئەنجومەنی", "error": "یەنجومەنی", "start": 100, "end": 109, "description": "orthography: 'ئەنجومەنی' → 'یەنجومەنی'"}, {"type": "orthography", "original": "ئەنجوومەنی", "error": "یەنجوومەنی", "start": 77, "end": 87, "description": "orthography: 'ئەنجوومەنی' → 'یەنجوومەنی'"}, {"type": "orthography", "original": "کورد", "error": "کوڕد", "start": 34, "end": 38, "description": "orthography: 'کورد' → 'کوڕد'"}, {"type": "orthography", "original": "مافەی", "error": "ماڤەی", "st