{"original": "ڕووبەری چاندراو بەو جۆرە سەوزانە لە ناوچەیەکەوە بۆ ناوچەیەکی تر جیاوازی هەیە، پارێزگای هەولێر لە ڕیزی پێشەوە دێت بە پێی ئامارەکانی ساڵی ۱۹۹۰ز بە ڕووبەری دۆنمەوە بەڵام ئەو ڕووبەری تەنەا دۆنم بووە لە پارێزگای سلێمانی دا.", "corrupted": "ڕووبەری چاندراو بەو جۆرە سەوزانە لە ناوچەیەکەوە بۆ ناوچەیەکی تر جیاوازی هەیە، پارێزگای هەولێر لە ڕیزی پێشەوە دێت بە پێی ئامارەکانی ساڵی ۱۹۹۰ز بە ڕووبەرەکەی دۆنمەوە بەڵام ئەو ڕووبەری تەنەا دۆنم بووە لە پارێزگای سلێمانی دا.", "source": "ڕووبەری چاندراو بەو جۆرە سەوزانە لە ناوچەیەکەوە بۆ ناوچەیەکی تر جیاوازی هەیە، پارێزگای هەولێر لە ڕیزی پێشەوە دێت بە پێی ئامارەکانی ساڵی ۱۹۹۰ز بە ڕووبەرەکەی دۆنمەوە بەڵام ئەو ڕووبەری تەنەا دۆنم بووە لە پارێزگای سلێمانی دا.", "target": "ڕووبەری چاندراو بەو جۆرە سەوزانە لە ناوچەیەکەوە بۆ ناوچەیەکی تر جیاوازی هەیە، پارێزگای هەولێر لە ڕیزی پێشەوە دێت بە پێی ئامارەکانی ساڵی ۱۹۹۰ز بە ڕووبەری دۆنمەوە بەڵام ئەو ڕووبەری تەنەا دۆنم بووە لە پارێزگای سلێمانی دا.", "errors": [{"type": "noun_adjective_agreement", "original": "ڕووبەری دۆنمەوە", "error": "ڕووبەرەکەی دۆنمەوە", "start": 145, "end": 160, "description": "noun_adjective_agreement: 'ڕووبەری دۆنمەوە' → 'ڕووبەرەکەی دۆنمەوە'"}], "source_id": "9716", "category": "social_sciences"}
{"original": "کۆمەڵناسی پەیوەندییەکی بەەێزی بە زانیارییە کۆمەڵایەتییەکانی دیکەوە هەیە وەک ئابووری و مێژوویی و جوگرافیا و زمان و وێژە و پەروەردە و دەروونناسی، بۆیەش گرنگە قوتابی لە قۆناغی ئامادەییدا لە هەموو بەشەکانی ئەم بابەتە بگات.", "corrupted": "کۆمەڵناسی پەیوەندییەکی بەەێزی بە زانیارییە کۆ مەڵایەتییەکانی دیکەوە هەیە وەک ئا بووری و مێژووییو جوگرافیا و زمان و وێژە و پەروەردە و دەروونناسی، بۆیەش گرنگە قوتابی لە قۆناغی ئامادەییدا لە هەموو بەشەکانی ئەم بابەتە بگات.", "source": "کۆمەڵناسی پەیوەندییەکی بەەێزی بە زانیارییە کۆ مەڵایەتییەکانی دیکەوە هەیە وەک ئا بووری و مێژووییو جوگرافیا و زمان و وێژە و پەروەردە و دەروونناسی، بۆیەش گرنگە قوتابی لە قۆناغی ئامادەییدا لە هەموو بەشەکانی ئەم بابەتە بگات.", "target": "کۆمەڵناسی پەیوەندییەکی بەەێزی بە زانیارییە کۆمەڵایەتییەکانی دیکەوە هەیە وەک ئابووری و مێژوویی و جوگرافیا و زمان و وێژە و پەروەردە و دەروونناسی، بۆیەش گرنگە قوتابی لە قۆناغی ئامادەییدا لە هەموو بەشەکانی ئەم بابەتە بگات.", "errors": [{"type": "whitespace", "original": "مێژوویی و", "error": "مێژووییو", "start": 86, "end": 95, "description": "whitespace: 'مێژوویی و' → 'مێژووییو'"}, {"type": "whitespace", "original": "ئابووری", "error": "ئا بووری", "start": 76, "end": 83, "description": "whitespace: 'ئابووری' → 'ئا بووری'"}, {"type": "whitespace", "original": "کۆمەڵایەتییەکانی", "error": "کۆ مەڵایەتییەکانی", "start": 43, "end": 59, "description": "whitespace: 'کۆمەڵایەتییەکانی' → 'کۆ مەڵایەتییەکانی'"}], "source_id": "5450", "category": "social_sciences"}
{"original": "فەرماندان: لەم بەشەدا، کەسی یەکەم ، ڕاستەوخۆ داوا لە کەسی دووەم دەکا، کە کارێکی لە کاتی ئێستادا بۆ جێبەجێ بکا.", "corrupted": "فەرماندان: لەم بەشەدا، کەسم یەکەم، ڕاستەوخۆ داوا لە کەسی دووەم دەکا، کە کارێکی لە کاتی ئێستادا بۆ جێبەجێ بکا.", "source": "فەرماندان: لەم بەشەدا، کەسم یەکەم، ڕاستەوخۆ داوا لە کەسی دووەم دەکا، کە کارێکی لە کاتی ئێستادا بۆ جێبەجێ بکا.", "target": "فەرماندان: لەم بەشەدا، کەسی یەکەم ، ڕاستەوخۆ داوا لە کەسی دووەم دەکا، کە کارێکی لە کاتی ئێستادا بۆ جێبەجێ بکا.", "errors": [{"type": "possessive_clitic", "original": "کەسی", "error": "کەسم", "start": 23, "end": 27, "description": "possessive_clitic: 'کەسی' → 'کەسم'"}], "source_id": "6510", "category": "linguistics"}
{"original": "بەڵام لە ساڵی ۱۹۸۸ لەمیانەی شاڵاوەکانی ئەنفال، رژێم بێگوێدانە هیچ یاسا و رێسایەک، هەرچی ژێرخانی ئابووری کوردستان هەبوو بەتەواوی وێرانکرد، بەجۆرێک ئەگەر چەندین ساڵ بنیاتنانەوەی بۆ بکرێت، نەگەڕێتەوە ئاستی پێشوو.", "corrupted": "بەڵام لە ساڵی ۱۹۸۸ لەمیانەی شاڵاوەکانی ئەنفال، رژێم بێگوێدانە هیچ یاسا و رێسایەک، هەرچی ژێرخانی ئابووری کوردستان هەبوو بەتەواوی وێرانکرد، بەجۆرێک ئەگەر چەندین ساڵ بنیاتنانەوەی بۆ بکرێت، نەگەڕێتەوە ئاستی پێشوو.", "source": "بەڵام لە ساڵی ۱۹۸۸ لەمیانەی شاڵاوەکانی ئەنفال، رژێم بێگوێدانە هیچ یاسا و رێسایەک، هەرچی ژێرخانی ئابووری کوردستان هەبوو بەتەواوی وێرانکرد، بەجۆرێک ئەگەر چەندین ساڵ بنیاتنانەوەی بۆ بکرێت، نەگەڕێتەوە ئاستی پێشوو.", "target": "بەڵام لە ساڵی ۱۹۸۸ لەمیانەی شاڵاوەکانی ئەنفال، رژێم بێگوێدانە هیچ یاسا و رێسایەک، هەرچی ژێرخانی ئابووری کوردستان هەبوو بەتەواوی وێرانکرد، بەجۆرێک ئەگەر چەندین ساڵ بنیاتنانەوەی بۆ بکرێت، نەگەڕێتەوە ئاستی پێشوو.", "errors": [], "source_id": "1538", "category": "history"}
{"original": "و دەبێت نەوە دوای نەوە موعجیزەکانی خودای گەورە بگوێزرێنەوە بۆ ئەوەی گەورەیی خودا لەیاد نەکەین.", "corrupted": "ودەبێتت نەوە دوای نەوە موعجیزەکانی خودای گەو رە بگوێزرێنەوە بۆ ئەوەی گەورەیی خودا لەیاد نەکەین.", "source": "ودەبێتت نەوە دوای نەوە موعجیزەکانی خودای گەو رە بگوێزرێنەوە بۆ ئەوەی گەورەیی خودا لەیاد نەکەین.", "target": "و دەبێت نەوە دوای نەوە موعجیزەکانی خودای گەورە بگوێزرێنەوە بۆ ئەوەی گەورەیی خودا لەیاد نەکەین.", "errors": [{"type": "whitespace", "original": "گەورە", "error": "گەو رە", "start": 41, "end": 46, "description": "whitespace: 'گەورە' → 'گەو رە'"}, {"type": "whitespace", "original": "دەبێت", "error": "دەب ێت", "start": 2, "end": 7, "description": "whitespace: 'دەبێت' → 'دەب ێت'"}, {"type": "whitespace", "original": "و دەبێت", "error": "ودەبێت", "start": 0, "end": 7, "description": "whitespace: 'و دەبێت' → 'ودەبێت'"}], "source_id": "4175", "category": "islamic_studies"}
{"original": "بارزان ناوچەیەکی شاخاوییە، دەکەوێتە نزیک سێگۆشەی سنووری، ، لە پارێزگای هەولێر. دانیشتوانەکەی لە رووی دیمۆگرافیەوە بە سەر نزیکەی چوار سەد گوند دابەش دەبن.", "corrupted": "بارزان ناوچەیەکی شاخاوییە، دەکەوێتە نزیک سێگۆشەی سنووری، ، لە پارێزگای هەولێر. دانیشتوانەکەی لە رووی دیمۆگرافیەوە بە سەر نزیکەی چوار سەد گوند دابەش دەبن.", "source": "بارزان ناوچەیەکی شاخاوییە، دەکەوێتە نزیک سێگۆشەی سنووری، ، لە پارێزگای هەولێر. دانیشتوانەکەی لە رووی دیمۆگرافیەوە بە سەر نزیکەی چوار سەد گوند دابەش دەبن.", "target": "بارزان ناوچەیەکی شاخاوییە، دەکەوێتە نزیک سێگۆشەی سنووری، ، لە پارێزگای هەولێر. دانیشتوانەکەی لە رووی دیمۆگرافیەوە بە سەر نزیکەی چوار سەد گوند دابەش دەبن.", "errors": [], "source_id": "332", "category": "history"}
{"original": "ئەوە بوو بڕیاریان دا کە لە هەر هۆزێک لاوێکی بوێرو چاونەترس دیاری بکرێت ‌و بە هەموویان بچنە سەر پێغەمبەرو لە شەوێکی تاریک دا بیکوژن ‌و خوێنەکەشی ون بێت لەنێو هۆزەکان.", "corrupted": "ئەوە بوو بڕیاریان دا کە لە هەر هۆزێک لاوێکی بووێرو چاۆنەترس دیاری بکرێت ‌و بە هەموویان بچنە سەر پێغەمبەرو ڵە شەوێکی تاڕیک دا بیکوژن ‌و خوێنەکەشی ون بێت لەنێو حۆزەکان.", "source": "ئەوە بوو بڕیاریان دا کە لە هەر هۆزێک لاوێکی بووێرو چاۆنەترس دیاری بکرێت ‌و بە هەموویان بچنە سەر پێغەمبەرو ڵە شەوێکی تاڕیک دا بیکوژن ‌و خوێنەکەشی ون بێت لەنێو حۆزەکان.", "target": "ئەوە بوو بڕیاریان دا کە لە هەر هۆزێک لاوێکی بوێرو چاونەترس دیاری بکرێت ‌و بە هەموویان بچنە سەر پێغەمبەرو لە شەوێکی تاریک دا بیکوژن ‌و خوێنەکەشی ون بێت لەنێو هۆزەکان.", "errors": [{"type": "orthography", "original": "هۆزەکان.", "error": "حۆزەکان.", "start": 157, "end": 165, "description": "orthography: 'هۆزەکان.' → 'حۆزەکان.'"}, {"type": "orthography", "original": "تاریک", "error": "تاڕیک", "start": 115, "end": 120, "description": "orthography: 'تاریک' → 'تاڕیک'"}, {"type": "orthography", "original": "لە", "error": "ڵە", "start": 105, "end": 107, "description": "orthography: 'لە' → 'ڵە'"}, {"type": "orthography", "original": "چاونەترس", "error": "چاۆنەترس", "start": 50, "end": 58, "description": "orthography: 'چاونەترس' → 'چاۆنەترس'"}, {"type": "orthography", "original": "بوێرو", "error": "بووێرو", "start": 44, "end": 49, "description": "orthography: 'بوێرو' → 'بووێرو'"}], "source_id": "7544", "category": "social_sciences"}
