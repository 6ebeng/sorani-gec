{"original": "زۆرتریش لەسەر ئەم جۆرە بانانە چیای گڕکانی هەیە کە بەەۆی چالاکی ناوبەناوی گڕکانەکانەوە دروست بووە.", "corrupted": "ژۆرتریش لەسەر یەم جۆرە بانانە چیای گڕکانی هەێە کە بەەۆێ چاڵاکی ناوبەناوی گڕکانەکانەوە دروست بووە.", "source": "ژۆرتریش لەسەر یەم جۆرە بانانە چیای گڕکانی هەێە کە بەەۆێ چاڵاکی ناوبەناوی گڕکانەکانەوە دروست بووە.", "target": "زۆرتریش لەسەر ئەم جۆرە بانانە چیای گڕکانی هەیە کە بەەۆی چالاکی ناوبەناوی گڕکانەکانەوە دروست بووە.", "errors": [{"type": "orthography", "original": "چالاکی", "error": "چاڵاکی", "start": 56, "end": 62, "description": "orthography: 'چالاکی' → 'چاڵاکی'"}, {"type": "orthography", "original": "بەەۆی", "error": "بەەۆێ", "start": 50, "end": 55, "description": "orthography: 'بەەۆی' → 'بەەۆێ'"}, {"type": "orthography", "original": "هەیە", "error": "هەێە", "start": 42, "end": 46, "description": "orthography: 'هەیە' → 'هەێە'"}, {"type": "orthography", "original": "ئەم", "error": "یەم", "start": 14, "end": 17, "description": "orthography: 'ئەم' → 'یەم'"}, {"type": "orthography", "original": "زۆرتریش", "error": "ژۆرتریش", "start": 0, "end": 7, "description": "orthography: 'زۆرتریش' → 'ژۆرتریش'"}], "source_id": "5774", "category": "social_sciences"}
