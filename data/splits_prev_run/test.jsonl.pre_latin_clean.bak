{"original": "گڵۆپێک وەاندەرەیەک دوای یەک بە سەرچاوەیەکی ڤۆڵتیەی نۆرەکی لەرەلەر گۆڕاو بەستران. چی بەسەر گەشەی گڵۆپەکە دێت کاتێک لەرەلەر زیاد دەکرێت؟ بۆچی؟", "corrupted": "گلۆپێک وەاندەرەیەک دوای یەک بە سەرچاوەیەکی ڤۆڵتیەی نۆڕەکی لەرەلەر گۆڕاو بەستڕان. چی بەسەر گەشەی گلۆپەکە دێت کاتیک لەرەلەر زیاد دەکڕێت؟ بۆچی؟", "source": "گلۆپێک وەاندەرەیەک دوای یەک بە سەرچاوەیەکی ڤۆڵتیەی نۆڕەکی لەرەلەر گۆڕاو بەستڕان. چی بەسەر گەشەی گلۆپەکە دێت کاتیک لەرەلەر زیاد دەکڕێت؟ بۆچی؟", "target": "گڵۆپێک وەاندەرەیەک دوای یەک بە سەرچاوەیەکی ڤۆڵتیەی نۆرەکی لەرەلەر گۆڕاو بەستران. چی بەسەر گەشەی گڵۆپەکە دێت کاتێک لەرەلەر زیاد دەکرێت؟ بۆچی؟", "errors": [{"type": "orthography", "original": "دەکرێت؟", "error": "دەکڕێت؟", "start": 127, "end": 134, "description": "orthography: 'دەکرێت؟' → 'دەکڕێت؟'"}, {"type": "orthography", "original": "کاتێک", "error": "کاتیک", "start": 108, "end": 113, "description": "orthography: 'کاتێک' → 'کاتیک'"}, {"type": "orthography", "original": "گڵۆپەکە", "error": "گلۆپەکە", "start": 96, "end": 103, "description": "orthography: 'گڵۆپەکە' → 'گلۆپەکە'"}, {"type": "orthography", "original": "بەستران.", "error": "بەستڕان.", "start": 72, "end": 80, "description": "orthography: 'بەستران.' → 'بەستڕان.'"}, {"type": "orthography", "original": "نۆرەکی", "error": "نۆڕەکی", "start": 51, "end": 57, "description": "orthography: 'نۆرەکی' → 'نۆڕەکی'"}, {"type": "orthography", "original": "گڵۆپێک", "error": "گلۆپێک", "start": 0, "end": 6, "description": "orthography: 'گڵۆپێک' → 'گلۆپێک'"}], "source_id": "4633", "category": "sciences"}
{"original": "بۆ ئەوەی مرۆڤیش بەرگەی ئەم ئازار‌و ناڕەحەتیانە بگرێت‌و لەبەر دەمیاندا هەرەس نەەێنێ، دەبێت مانایان پێ بدرێت ‌و لێکبدرێنەوە، مانادان بە ئازارەکانمان لە دۆخێکی نەرێنییەوە دەمانگوێزێتەوە بۆ دۆخێکی ئەرێنی، ئەم ئەرکەش ئەرکی باوەڕ‌و ئاینە بە گشتی.", "corrupted": "بۆ ئەوەی مرۆڤیش بەرگەی ئەم ئازار‌و ناڕەحەتیانە بگرێت‌و لەبەر دەمیاندا هەرەس نەەێنێ، دەبێت مانایان پێ بدرێت ‌و لێکبدرێنەوە، مانادان بە ئازارەکانمان لە دۆخێکی نەرێنییەوە دەمانگوێزێتەوە بۆ دۆخێکی ئەرێنی، ئەم ئەرکەش ئەرکی باوەڕ‌و ئاینە بە گشتی.", "source": "بۆ ئەوەی مرۆڤیش بەرگەی ئەم ئازار‌و ناڕەحەتیانە بگرێت‌و لەبەر دەمیاندا هەرەس نەەێنێ، دەبێت مانایان پێ بدرێت ‌و لێکبدرێنەوە، مانادان بە ئازارەکانمان لە دۆخێکی نەرێنییەوە دەمانگوێزێتەوە بۆ دۆخێکی ئەرێنی، ئەم ئەرکەش ئەرکی باوەڕ‌و ئاینە بە گشتی.", "target": "بۆ ئەوەی مرۆڤیش بەرگەی ئەم ئازار‌و ناڕەحەتیانە بگرێت‌و لەبەر دەمیاندا هەرەس نەەێنێ، دەبێت مانایان پێ بدرێت ‌و لێکبدرێنەوە، مانادان بە ئازارەکانمان لە دۆخێکی نەرێنییەوە دەمانگوێزێتەوە بۆ دۆخێکی ئەرێنی، ئەم ئەرکەش ئەرکی باوەڕ‌و ئاینە بە گشتی.", "errors": [], "source_id": "5783", "category": "islamic_studies"}
{"original": "خۆی بەخت کردووە بۆ پارێزگاری کردن لە پەیوەست بوونی گەل بە ئاینی ئیسلامەوە و، بەرەنگار بوونەوەی گشت ئەو هەوڵانەی نیازی لە ناوبردنی ئەم ئاینەیان هەبووە.", "corrupted": "خۆی بەخت کردووە بۆ پارێزگاری کردن لە پەیوەست بوونی گەل بە ئاینی ئیسلامەوە و، بەرەنگار بوونەوەی گشت ئەو هەوڵانەی نیازی لە ناوبردنی ئەم ئاینەیان هەبووە.", "source": "خۆی بەخت کردووە بۆ پارێزگاری کردن لە پەیوەست بوونی گەل بە ئاینی ئیسلامەوە و، بەرەنگار بوونەوەی گشت ئەو هەوڵانەی نیازی لە ناوبردنی ئەم ئاینەیان هەبووە.", "target": "خۆی بەخت کردووە بۆ پارێزگاری کردن لە پەیوەست بوونی گەل بە ئاینی ئیسلامەوە و، بەرەنگار بوونەوەی گشت ئەو هەوڵانەی نیازی لە ناوبردنی ئەم ئاینەیان هەبووە.", "errors": [], "source_id": "9364", "category": "islamic_studies"}
