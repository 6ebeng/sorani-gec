{"original": "تا سەرەنجام دوای ئەوەی دەیان کەمین یان بڕی وبارزانی و هەڤاڵەکانی ڕۆژی ۱۸حوزەیرانی ۱۹۴۷لەئاوی ئاراس پەڕینەوە وپەنایان بردە بەرخاکی یەکێتی سۆڤیەت و تا هەڵگیرسانی شۆڕشی ۱۴تەموزی ۱۹۵۸لەم وڵاتە مانەوەو ئەودەمە گەڕانەوە بۆ نیشتمان.", "corrupted": "تا سەرەنجام دوای ئەوەی دەیان کەمین یان بڕی وبارزانی و هەڤاڵەکانی ڕۆژی ۱۸حوزەیرانی ۱۹۴۷لەئاوی ئاراس پەڕینەوە وپەنایان بردە بەرخاکی یەکێتی سۆڤیەت و تا هەڵگیرسانی شۆڕشی ۱۴تەموزی ۱۹۵۸لەم وڵاتە مانەوەو ئەودەمە گەڕانەوە بۆ نیشتمان.", "source": "تا سەرەنجام دوای ئەوەی دەیان کەمین یان بڕی وبارزانی و هەڤاڵەکانی ڕۆژی ۱۸حوزەیرانی ۱۹۴۷لەئاوی ئاراس پەڕینەوە وپەنایان بردە بەرخاکی یەکێتی سۆڤیەت و تا هەڵگیرسانی شۆڕشی ۱۴تەموزی ۱۹۵۸لەم وڵاتە مانەوەو ئەودەمە گەڕانەوە بۆ نیشتمان.", "target": "تا سەرەنجام دوای ئەوەی دەیان کەمین یان بڕی وبارزانی و هەڤاڵەکانی ڕۆژی ۱۸حوزەیرانی ۱۹۴۷لەئاوی ئاراس پەڕینەوە وپەنایان بردە بەرخاکی یەکێتی سۆڤیەت و تا هەڵگیرسانی شۆڕشی ۱۴تەموزی ۱۹۵۸لەم وڵاتە مانەوەو ئەودەمە گەڕانەوە بۆ نیشتمان.", "errors": [], "source_id": "5716", "category": "history"}
{"original": "ئەم هزرە کلاسیکیەش بڵاوبوونەوەیەکی گەورەی بەخۆیەوە بینی لەکاتی شۆڕشی پیشەسازی لە ئەوروپادا لەبارودۆخێکدا کە سەپاندنی ئەم هزرەی تێدا هاتەدی‌و شانبەشانی ئەم گۆڕانکاریانە دەڕۆیشت کە لەگەڵ واقعی ئابووری ئەوێ دا روویاندا.", "corrupted": "ئەم هزرە کلاسیکیەش بڵاوبوونەوەیەکی گەورەی بەخۆیەوە بینی لەکاتی شۆڕشی پیشەسازی لە ئەوروپادا لەبارودۆخێکدا کە سەپاندنی ئەم هزرەی تێدا هاتەدی‌و شانبەشانی ئەم گۆڕانکاریانە دەڕۆیشت کە لەگەڵ واقعی ئابووری ئەوێ دا روویاندا.", "source": "ئەم هزرە کلاسیکیەش بڵاوبوونەوەیەکی گەورەی بەخۆیەوە بینی لەکاتی شۆڕشی پیشەسازی لە ئەوروپادا لەبارودۆخێکدا کە سەپاندنی ئەم هزرەی تێدا هاتەدی‌و شانبەشانی ئەم گۆڕانکاریانە دەڕۆیشت کە لەگەڵ واقعی ئابووری ئەوێ دا روویاندا.", "target": "ئەم هزرە کلاسیکیەش بڵاوبوونەوەیەکی گەورەی بەخۆیەوە بینی لەکاتی شۆڕشی پیشەسازی لە ئەوروپادا لەبارودۆخێکدا کە سەپاندنی ئەم هزرەی تێدا هاتەدی‌و شانبەشانی ئەم گۆڕانکاریانە دەڕۆیشت کە لەگەڵ واقعی ئابووری ئەوێ دا روویاندا.", "errors": [], "source_id": "487", "category": "economics"}
{"original": "ئاینی ئیسلام گرینگی داوە بەخێزان چونکە خێزان بناغەی دروست بوون ویەکبوونی کۆمەڵگایە. وسەرۆکایتی خێزانی بەخشیوە بەپیاو وبەرپرسێتی خستۆتە ئەستۆی لە دابین کردنی پێویستی ژیان وپەروەردەکردنیان لەسەر رەوشتی جوان و زانست بەدەستەێنان.", "corrupted": "ئاینی ئیسڵام گرینگی داوە بەخێزان چونکە خێزان بناغەی دروست بوون ویەکبوونی کۆمەلگایە. وسەرۆکایتی خێزانی بەخشیوە بەپیاو وبەرپرسێتی خستۆتە ئەستۆی لە دابین کردنی پێویستی ژیان وپەروەردەکردنیان لەسەر رەوشتی جوان و زانسط بەدەستەێنان.", "source": "ئاینی ئیسڵام گرینگی داوە بەخێزان چونکە خێزان بناغەی دروست بوون ویەکبوونی کۆمەلگایە. وسەرۆکایتی خێزانی بەخشیوە بەپیاو وبەرپرسێتی خستۆتە ئەستۆی لە دابین کردنی پێویستی ژیان وپەروەردەکردنیان لەسەر رەوشتی جوان و زانسط بەدەستەێنان.", "target": "ئاینی ئیسلام گرینگی داوە بەخێزان چونکە خێزان بناغەی دروست بوون ویەکبوونی کۆمەڵگایە. وسەرۆکایتی خێزانی بەخشیوە بەپیاو وبەرپرسێتی خستۆتە ئەستۆی لە دابین کردنی پێویستی ژیان وپەروەردەکردنیان لەسەر رەوشتی جوان و زانست بەدەستەێنان.", "errors": [{"type": "spelling_confusion", "original": "زانست", "error": "زانسط", "start": 207, "end": 212, "description": "spelling_confusion: 'زانست' → 'زانسط'"}, {"type": "spelling_confusion", "original": "کۆمەڵگایە.", "error": "کۆمەلگایە.", "start": 73, "end": 83, "description": "spelling_confusion: 'کۆمەڵگایە.' → 'کۆمەلگایە.'"}, {"type": "spelling_confusion", "original": "ئیسلام", "error": "ئیسڵام", "start": 6, "end": 12, "description": "spelling_confusion: 'ئیسلام' → 'ئیسڵام'"}], "source_id": "6931", "category": "islamic_studies"}
