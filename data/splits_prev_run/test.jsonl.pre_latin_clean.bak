{"original": "وەبەرەێنان لەسەرمایەی مرۆڤدا بۆی هەیە ببێتە چاکترکردنی هەڵسوڕاندنی کارگێڕی بەرەەمی هێزی کارگەر، دەتوانێ هەمان کاریگەری یاخود زیاتریش ببینێ ئەگەر ژمارەیەکی تری زۆرتری ئاسایی تاکەکان بەکار بەێنرێن لە کرداری بەرەەمەێناندا.", "corrupted": "وەبەرەێنان لەسەرمایەی مڕۆڤدا بۆی هەێە ببێتە چاکتڕکردنی هەڵسوڕاندنی کارگێڕی بەرەەمی هێزی کارگەر، دەتوانی هەمان کاڕیگەری یاخود زیاتریش ببینێ ئەگەر ژمارەیەکی تری زۆرتری یاسایی تاکەکان بەکار بەێنرێن لە کڕداری بەرەەمەیناندا.", "source": "وەبەرەێنان لەسەرمایەی مڕۆڤدا بۆی هەێە ببێتە چاکتڕکردنی هەڵسوڕاندنی کارگێڕی بەرەەمی هێزی کارگەر، دەتوانی هەمان کاڕیگەری یاخود زیاتریش ببینێ ئەگەر ژمارەیەکی تری زۆرتری یاسایی تاکەکان بەکار بەێنرێن لە کڕداری بەرەەمەیناندا.", "target": "وەبەرەێنان لەسەرمایەی مرۆڤدا بۆی هەیە ببێتە چاکترکردنی هەڵسوڕاندنی کارگێڕی بەرەەمی هێزی کارگەر، دەتوانێ هەمان کاریگەری یاخود زیاتریش ببینێ ئەگەر ژمارەیەکی تری زۆرتری ئاسایی تاکەکان بەکار بەێنرێن لە کرداری بەرەەمەێناندا.", "errors": [{"type": "orthography", "original": "بەرەەمەێناندا.", "error": "بەرەەمەیناندا.", "start": 205, "end": 219, "description": "orthography: 'بەرەەمەێناندا.' → 'بەرەەمەیناندا.'"}, {"type": "orthography", "original": "ئاسایی", "error": "یاسایی", "start": 166, "end": 172, "description": "orthography: 'ئاسایی' → 'یاسایی'"}, {"type": "orthography", "original": "دەتوانێ", "error": "دەتوانی", "start": 96, "end": 103, "description": "orthography: 'دەتوانێ' → 'دەتوانی'"}, {"type": "orthography", "original": "چاکترکردنی", "error": "چاکتڕکردنی", "start": 44, "end": 54, "description": "orthography: 'چاکترکردنی' → 'چاکتڕکردنی'"}, {"type": "orthography", "original": "هەیە", "error": "هەێە", "start": 33, "end": 37, "description": "orthography: 'هەیە' → 'هەێە'"}, {"type": "spelling_confusion", "original": "کرداری", "error": "کڕداری", "start": 198, "end": 204, "description": "spelling_confusion: 'کرداری' → 'کڕداری'"}, {"type": "spelling_confusion", "original": "کاریگەری", "error": "کاڕیگەری", "start": 110, "end": 118, "description": "spelling_confusion: 'ک