{"original": "(ن)ی چاوگ مۆرفیمێکی کۆی بێ لایەنە و ئەنجامدانی کارەکە ناداتە پاڵ هیچ توخمێکی دەستنیشانکراو، بۆیە ڕۆڵی مۆرفیمی کات نامێنێ و کپ دەبێ ۲۶۶.", "corrupted": "(ن)ی چاوگ مۆڕفیمێکی کۆی بێ ڵایەنە و ئەنجامدانی کارەکە ناداتە پاڵ هیچ طوخمێکی دەستنیشانکراو، بۆیە ڕۆڵی مۆرفیمی کات نامێنێ و کپ دەبێ ۲۶۶.", "source": "(ن)ی چاوگ مۆڕفیمێکی کۆی بێ ڵایەنە و ئەنجامدانی کارەکە ناداتە پاڵ هیچ طوخمێکی دەستنیشانکراو، بۆیە ڕۆڵی مۆرفیمی کات نامێنێ و کپ دەبێ ۲۶۶.", "target": "(ن)ی چاوگ مۆرفیمێکی کۆی بێ لایەنە و ئەنجامدانی کارەکە ناداتە پاڵ هیچ توخمێکی دەستنیشانکراو، بۆیە ڕۆڵی مۆرفیمی کات نامێنێ و کپ دەبێ ۲۶۶.", "errors": [{"type": "spelling_confusion", "original": "توخمێکی", "error": "طوخمێکی", "start": 69, "end": 76, "description": "spelling_confusion: 'توخمێکی' → 'طوخمێکی'"}, {"type": "spelling_confusion", "original": "لایەنە", "error": "ڵایەنە", "start": 27, "end": 33, "description": "spelling_confusion: 'لایەنە' → 'ڵایەنە'"}, {"type": "spelling_confusion", "original": "مۆرفیمێکی", "error": "مۆڕفیمێکی", "start": 10, "end": 19, "description": "spelling_confusion: 'مۆرفیمێکی' → 'مۆڕفیمێکی'"}], "source_id": "1671", "category": "linguistics"}
