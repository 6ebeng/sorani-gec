{"original": "بۆیە لە هاوینی ساڵی ۱۹۴۳ز مستەفا بارزانی و دووکەس لە هەڤاڵانی بەیارمەتی حیزبی هیواو چەند کەسێکی نیشتمانپەروەری کورد لەسلێمانی دەرباز بوو بەخاکی ئێراندا گەڕایەوە ناوچەی بارزان و سەر لەنوێ دژی حکومەتی عێراقی و ئینگلیز دەستی بەشۆڕش کردەوە.", "corrupted": "بۆیە ڵە هاوینی سالی ۱۹۴۳ز مستەفا بارزانی و دووکەس ڵە هەڤاڵانی بەیاڕمەتی حیزبی هیواو چەند کەسێکی نیشتمانپەروەری کورد لەسلێمانی دەرباز بوو بەخاکی ئێراندا گەرایەوە ناوچەی بارزان و سەر ڵەنوێ دژی حکومەتی عێراقی و ئینگلیز دەستی بەشۆڕش کردەوە.", "source": "بۆیە ڵە هاوینی سالی ۱۹۴۳ز مستەفا بارزانی و دووکەس ڵە هەڤاڵانی بەیاڕمەتی حیزبی هیواو چەند کەسێکی نیشتمانپەروەری کورد لەسلێمانی دەرباز بوو بەخاکی ئێراندا گەرایەوە ناوچەی بارزان و سەر ڵەنوێ دژی حکومەتی عێراقی و ئینگلیز دەستی بەشۆڕش کردەوە.", "target": "بۆیە لە هاوینی ساڵی ۱۹۴۳ز مستەفا بارزانی و دووکەس لە هەڤاڵانی بەیارمەتی حیزبی هیواو چەند کەسێکی نیشتمانپەروەری کورد لەسلێمانی دەرباز بوو بەخاکی ئێراندا گەڕایەوە ناوچەی بارزان و سەر لەنوێ دژی حکومەتی عێراقی و ئینگلیز دەستی بەشۆڕش کردەوە.", "errors": [{"type": "spelling_confusion", "original": "لەنوێ", "error": "ڵەنوێ", "start": 181, "end": 186, "description": "spelling_confusion: 'لەنوێ' → 'ڵەنوێ'"}, {"type": "spelling_confusion", "original": "گەڕایەوە", "error": "گەرایەوە", "start": 152, "end": 160, "description": "spelling_confusion: 'گەڕایەوە' → 'گەرایەوە'"}, {"type": "spelling_confusion", "original": "بەیارمەتی", "error": "بەیاڕمەتی", "start": 62, "end": 71, "description": "spelling_confusion: 'بەیارمەتی' → 'بەیاڕمەتی'"}, {"type": "spelling_confusion", "original": "لە", "error": "ڵە", "start": 50, "end": 52, "description": "spelling_confusion: 'لە' → 'ڵە'"}, {"type": "spelling_confusion", "original": "ساڵی", "error": "سالی", "start": 15, "end": 19, "description": "spelling_confusion: 'ساڵی' → 'سالی'"}, {"type": "spelling_confusion", "original": "لە", "error": "ڵە", "start": 5, "end": 7, "description": "spelling_confusion: 'لە' → 'ڵە'"}], "source_id": "919", "category": "history"}
