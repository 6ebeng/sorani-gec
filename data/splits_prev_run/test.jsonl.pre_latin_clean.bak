{"original": "بەڵام مۆرکی رەسەنی خۆماڵیان پێوە لکابوو و جۆرێک لە تایبەتمەندی پێبەخشیبوو و دەکرێت لەسەر بناغەو پاشماوەی ئەم مزگەوت و دامەزراوانە لە مێژووی گەشەکردنی هونەری بیناسازی بکۆڵینەوە.", "corrupted": "بەڵام مۆرکی رەسەنی خۆماڵیان پێوە لکابوو و جۆرێک لە تایبەتمەندی پێبەخشیبوو و دەکرێت لەسەر بناغەو پاشماوەی ئەم مزگەوت و دامەزراوانە لە مێژووی گەشەکردنی هونەری بیناسازی بکۆڵینەوە.", "source": "بەڵام مۆرکی رەسەنی خۆماڵیان پێوە لکابوو و جۆرێک لە تایبەتمەندی پێبەخشیبوو و دەکرێت لەسەر بناغەو پاشماوەی ئەم مزگەوت و دامەزراوانە لە مێژووی گەشەکردنی هونەری بیناسازی بکۆڵینەوە.", "target": "بەڵام مۆرکی رەسەنی خۆماڵیان پێوە لکابوو و جۆرێک لە تایبەتمەندی پێبەخشیبوو و دەکرێت لەسەر بناغەو پاشماوەی ئەم مزگەوت و دامەزراوانە لە مێژووی گەشەکردنی هونەری بیناسازی بکۆڵینەوە.", "errors": [], "source_id": "4439", "category": "history"}
{"original": "وەک پێشتر باسکرابوو بەەۆی هەڵگیرسانی شۆڕشی شێخ سەعیدی پیران وشۆڕشی ئاگری داغ و دواتریش ڕاپەڕینی دەرسیم بەڕێبەرایەتی سەید ڕەزای دەرسیم.", "corrupted": "وەک پێشتر باسکرابوو بەەۆی هەڵگیرسانی شۆڕشی شێخ سەعیدی پیران وشۆڕشەکەی ئاگری داغ و دواتریش ڕاپەڕینی دەرسیم بەڕێبەرایەتی سەید ڕەزای دەرسیم.", "source": "وەک پێشتر باسکرابوو بەەۆی هەڵگیرسانی شۆڕشی شێخ سەعیدی پیران وشۆڕشەکەی ئاگری داغ و دواتریش ڕاپەڕینی دەرسیم بەڕێبەرایەتی سەید ڕەزای دەرسیم.", "target": "وەک پێشتر باسکرابوو بەەۆی هەڵگیرسانی شۆڕشی شێخ سەعیدی پیران وشۆڕشی ئاگری داغ و دواتریش ڕاپەڕینی دەرسیم بەڕێبەرایەتی سەید ڕەزای دەرسیم.", "errors": [{"type": "noun_adjective_agreement", "original": "وشۆڕشی ئاگری", "error": "وشۆڕشەکەی ئاگری", "start": 60, "end": 72, "description": "noun_adjective_agreement: 'وشۆڕشی ئاگری' → 'وشۆڕشەکەی ئاگری'"}], "source_id": "2333", "category": "history"}
{"original": "أ – دوو کەس یان زیاتر کار لە یەکتری دەکەن و ئەو رەفتار و رووداوانە دێتە کایەوە کە بۆ تۆژینەوە و لێکۆڵینەوە پێویستە.", "corrupted": "أ – دوو کەس ئان زیاتر کار لە یەکتری دەکەن وو ئەو رەفتار وو رووداوانە دێتە کایەوە کە بو تۆژینەوە ۆ لێکۆڵینەوە پێویستە.", "source": "أ – دوو کەس ئان زیاتر کار لە یەکتری دەکەن وو ئەو رەفتار وو رووداوانە دێتە کایەوە کە بو تۆژینەوە ۆ لێکۆڵینەوە پێویستە.", "target": "أ – دوو کەس یان زیاتر کار لە یەکتری دەکەن و ئەو رەفتار و رووداوانە دێتە کایەوە کە بۆ تۆژینەوە و لێکۆڵینەوە پێویستە.", "errors": [{"type": "orthography", "original": "و", "error": "ۆ", "start": 94, "end": 95, "description": "orthography: 'و' → 'ۆ'"}, {"type": "orthography", "original": "بۆ", "error": "بو", "start": 82, "end": 84, "description": "orthography: 'بۆ' → 'بو'"}, {"type": "orthography", "original": "و", "error": "وو", "start": 55, "end": 56, "description": "orthography: 'و' → 'وو'"}, {"type": "orthography", "original": "و", "error": "وو", "start": 42, "end": 43, "description": "orthography: 'و' → 'وو'"}, {"type": "orthography", "original": "یان", "error": "ئان", "start": 12, "end": 15, "description": "orthography: 'یان' → 'ئان'"}], "source_id": "1510", "category": "social_sciences"}
