{"original": "لە دەوروبەری ساڵی وەکو هێزێکی کارای سەربازی و سیاسی دەرکەوتن، کاتێ کە سەرکردەی بەناوبانگیان توانی هەموو هۆزەکانی مەغۆل یەکبخات و پاشان وڵاتانی چین و بلاد ما ورا‌و النەر و خوراسان و فارس و ئازربایجان و ناوچەی قەفقاسی داگیرکرد.", "corrupted": "لە دەورو بەری ساڵیوەکو هێزێکی کارای سەڕبازی و سیا سی دەرکەوتن، کاتێ کە سەرکردەی بەناوبانگیان توانیهەموو هۆزەکانی مەغۆڵ یەکبخات وپاشانوڵاتانیی چین و بلادما ورا‌والنەر و خوراسان و فارس و ئازربایجان و ناوچەی قەفقاسی داگیرکرد.", "source": "لە دەورو بەری ساڵیوەکو هێزێکی کارای سەڕبازی و سیا سی دەرکەوتن، کاتێ کە سەرکردەی بەناوبانگیان توانیهەموو هۆزەکانی مەغۆڵ یەکبخات وپاشانوڵاتانیی چین و بلادما ورا‌والنەر و خوراسان و فارس و ئازربایجان و ناوچەی قەفقاسی داگیرکرد.", "target": "لە دەوروبەری ساڵی وەکو هێزێکی کارای سەربازی و سیاسی دەرکەوتن، کاتێ کە سەرکردەی بەناوبانگیان توانی هەموو هۆزەکانی مەغۆل یەکبخات و پاشان وڵاتانی چین و بلاد ما ورا‌و النەر و خوراسان و فارس و ئازربایجان و ناوچەی قەفقاسی داگیرکرد.", "errors": [{"type": "whitespace", "original": "ورا‌و النەر", "error": "ورا‌والنەر", "start": 157, "end": 168, "description": "whitespace: 'ورا‌و النەر' → 'ورا‌والنەر'"}, {"type": "whitespace", "original": "بلاد ما", "error": "بلادما", "start": 149, "end": 156, "description": "whitespace: 'بلاد ما' → 'بلادما'"}, {"type": "whitespace", "original": "وڵاتانی", "error": "وڵات انی", "start": 135, "end": 142, "description": "whitespace: 'وڵاتانی' → 'وڵات انی'"}, {"type": "whitespace", "original": "پاشان وڵاتانی", "error": "پاشانوڵاتانی", "start": 129, "end": 142, "description": "whitespace: 'پاشان وڵاتانی' → 'پاشانوڵاتانی'"}, {"type": "whitespace", "original": "و پاشان", "error": "وپاشان", "start": 127, "end": 134, "description": "whitespace: 'و پاشان' → 'وپاشان'"}, {"type": "whitespace", "original": "توانی هەموو", "error": "توانیهەموو", "start": 92, "end": 103, "description": "whitespace: 'توانی هەموو' → 'توانیهەموو'"}, {"type": "whitespace", "original": "سیاسی", "error": "سیا سی", "start": 46, "end": 51, "description": "whitespace: '