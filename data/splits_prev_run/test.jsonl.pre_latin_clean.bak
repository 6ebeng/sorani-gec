{"original": "بەم جۆرەش هەموویان لەبەردەم یاسادا یەکسانن ‌و هەمووشیان شایستەی ئەوەن ببنە خاوەنی ئەو مافانەی بۆ مرۆڤ دیاریکراون، یەکسانی مرۆڤەکانیش لە کەرامەت و مرۆڤایەتیدا پایەیەکی گەورەی مافەکانی مرۆڤە.", "corrupted": "بەم جۆرەش هەموویان لەبەردەم یاسادا یەکسانن ‌و هەمووشیان شایستەی ئەوەن ببنە خاوەنی ئەو مافانەی بۆ مرۆڤ دیاریکراون، یەکسانی مرۆڤەکانیش لە کەرامەت و مرۆڤایەتیدا پایەیەکی گەورەی مافەکانی مرۆڤە.", "source": "بەم جۆرەش هەموویان لەبەردەم یاسادا یەکسانن ‌و هەمووشیان شایستەی ئەوەن ببنە خاوەنی ئەو مافانەی بۆ مرۆڤ دیاریکراون، یەکسانی مرۆڤەکانیش لە کەرامەت و مرۆڤایەتیدا پایەیەکی گەورەی مافەکانی مرۆڤە.", "target": "بەم جۆرەش هەموویان لەبەردەم یاسادا یەکسانن ‌و هەمووشیان شایستەی ئەوەن ببنە خاوەنی ئەو مافانەی بۆ مرۆڤ دیاریکراون، یەکسانی مرۆڤەکانیش لە کەرامەت و مرۆڤایەتیدا پایەیەکی گەورەی مافەکانی مرۆڤە.", "errors": [], "source_id": "6487", "category": "islamic_studies"}
{"original": "ئەمەش لە میانەی ئەو هاوکاری و هاریکاریکردنەی کە لە نێوانیاندا هەیە لەبوارەکانی، دەست بەسەر بەرەەمەێنان و وەبازاڕخستن و نرخدانانی و دیاریکردنی سیاسەتێکی گونجاو بۆ بەرەەمەێنان ونرخدانان.", "corrupted": "ئەمەش لە میانەی ئەو هاوکاری و هاڕیکاریکردنەی کە لە نێوانیاندا هەیە لەبوارەکانی، دەست بەسەر بەرەەمەێنان و وەبازاڕخستن و نرخدانانی و دیاریکردنی سیاسەتێکی گونجاو بۆ بەرەەمەێنان ونڕخدانان.", "source": "ئەمەش لە میانەی ئەو هاوکاری و هاڕیکاریکردنەی کە لە نێوانیاندا هەیە لەبوارەکانی، دەست بەسەر بەرەەمەێنان و وەبازاڕخستن و نرخدانانی و دیاریکردنی سیاسەتێکی گونجاو بۆ بەرەەمەێنان ونڕخدانان.", "target": "ئەمەش لە میانەی ئەو هاوکاری و هاریکاریکردنەی کە لە نێوانیاندا هەیە لەبوارەکانی، دەست بەسەر بەرەەمەێنان و وەبازاڕخستن و نرخدانانی و دیاریکردنی سیاسەتێکی گونجاو بۆ بەرەەمەێنان ونرخدانان.", "errors": [{"type": "spelling_confusion", "original": "ونرخدانان.", "error": "ونڕخدانان.", "start": 174, "end": 184, "description": "spelling_confusion: 'ونرخدانان.' → 'ونڕخدانان.'"}, {"type": "spelling_confusion", "original": "هاریکاریکردنەی", "error": "هاڕیکاریکردنەی", "start": 30, "end": 44, "description": "spelling_confusion: 'هاریکاریکردنەی' → 'هاڕیکاریکردنەی'"}], "source_id": "2541", "category": "economics"}
{"original": "کوردستان بەرەەمێکی زۆری ڕۆنی زەیتون و کونجی هەبوو، ئەو بەرەەمەش بە زۆری بۆ دەرەوە دەنێران. ئەمە سەرەڕای ئەوەی کە کوردستان سەرچاوەیەکی گەورەی بەروبوومی مەڕ و ماڵات بەخێوکردن بوو.", "corrupted": "کوردستان بەرەەمێکی زۆری ڕۆنی زەیتون و کونجی هەبوو، ئەو بەرەەمەش بە زۆری بۆ دەرەوە دەنێران. ئەمە سەرەڕای ئەوەی کە کوردستان سەرچاوەیەکی گەورەی بەروبوومی مەڕ و ماڵات بەخێوکردن بوو.", "source": "کوردستان بەرەەمێکی زۆری ڕۆنی زەیتون و کونجی هەبوو، ئەو بەرەەمەش بە زۆری بۆ دەرەوە دەنێران. ئەمە سەرەڕای ئەوەی کە کوردستان سەرچاوەیەکی گەورەی بەروبوومی مەڕ و ماڵات بەخێوکردن بوو.", "target": "کوردستان بەرەەمێکی زۆری ڕۆنی زەیتون و کونجی هەبوو، ئەو بەرەەمەش بە زۆری بۆ دەرەوە دەنێران. ئەمە سەرەڕای ئەوەی کە کوردستان سەرچاوەیەکی گەورەی بەروبوومی مەڕ و ماڵات بەخێوکردن بوو.", "errors": [], "source_id": "271", "category": "history"}
