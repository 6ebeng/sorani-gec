{"original": "لەسەردەمی پاشای بابل مەرکەزیەتی دەوڵەت پەرەی سەند، کۆشکی پاشا بۆتە سەرچاوەی یەکەمی دەسەڵاتی و فەرمانبەران و کارگێڕان کارەنیان لە کۆشکدا ئەنجام دەدا. حەمورابی هەردوو دەسەڵاتی لێک جیاکردنەوە.", "corrupted": "لەسەردەمی پاشای بابل مەرکەزیە تی دەوڵەت پەرەی سەند، کۆشکی پاشا بۆتە سەرچاوەی یەکەمی دەسەڵاتی و فەرمانبەران و کا رگێڕان کارەنیان لە کۆشکدا ئەنجام دەدا. حەمورابی هەرد وو دەسەڵاتی لێک جیاکردنەوە.", "source": "لەسەردەمی پاشای بابل مەرکەزیە تی دەوڵەت پەرەی سەند، کۆشکی پاشا بۆتە سەرچاوەی یەکەمی دەسەڵاتی و فەرمانبەران و کا رگێڕان کارەنیان لە کۆشکدا ئەنجام دەدا. حەمورابی هەرد وو دەسەڵاتی لێک جیاکردنەوە.", "target": "لەسەردەمی پاشای بابل مەرکەزیەتی دەوڵەت پەرەی سەند، کۆشکی پاشا بۆتە سەرچاوەی یەکەمی دەسەڵاتی و فەرمانبەران و کارگێڕان کارەنیان لە کۆشکدا ئەنجام دەدا. حەمورابی هەردوو دەسەڵاتی لێک جیاکردنەوە.", "errors": [{"type": "whitespace", "original": "هەردوو", "error": "هەرد وو", "start": 158, "end": 164, "description": "whitespace: 'هەردوو' → 'هەرد وو'"}, {"type": "whitespace", "original": "کارگێڕان", "error": "کا رگێڕان", "start": 108, "end": 116, "description": "whitespace: 'کارگێڕان' → 'کا رگێڕان'"}, {"type": "whitespace", "original": "مەرکەزیەتی", "error": "مەرکەزیە تی", "start": 21, "end": 31, "description": "whitespace: 'مەرکەزیەتی' → 'مەرکەزیە تی'"}], "source_id": "1041", "category": "history"}
{"original": "فێرکردن لە قوتابخانە و خوێندنگە و پەیمانگە و لە زانکۆکاندا بە رێبازێکی چاکی فێرکردنی دابونەریت و یاساکان و بنچینەکانی کارتێکردن دادەنرێت و بە هۆیەوە قوتابییان لە میانەی قۆناغەکان خوێندن فێری بڕگە سەرەکییەکانی رێککاریی دەبن و پێی رادێن.", "corrupted": "فێرکردن لە قوتابخانە و خوێندنگە و پەیمانگە و لە زانکۆکاندا بە رێبازێکی چاکی فێرکردنی دابونەریت و یاساکان و بنچینەکانی کارتێکردن دادەنرێت و بە هۆیەوە قوتابییان لە میانەی قۆناغەکان خوێندن فێری بڕگە سەرەکییەکانی رێککاریی دەبن و پێی رادێن.", "source": "فێرکردن لە قوتابخانە و خوێندنگە و پەیمانگە و لە زانکۆکاندا بە رێبازێکی چاکی فێرکردنی دابونەریت و یاساکان و بنچینەکانی کارتێکردن دادەنرێت و بە هۆیەوە قوتابییان لە میانەی قۆناغەکان خوێندن فێری بڕگە سەرەکییەکانی رێککاریی دەبن و پێی رادێن.", "target": "فێرکردن لە قوتابخانە و خوێندنگە و پەیمانگە و لە زانکۆکاندا بە رێبازێکی چاکی فێرکردنی دابونەریت و یاساکان و بنچینەکانی کارتێکردن دادەنرێت و بە هۆیەوە قوتابییان لە میانەی قۆناغەکان خوێندن فێری بڕگە سەرەکییەکانی رێککاریی دەبن و پێی رادێن.", "errors": [], "source_id": "629", "category": "social_sciences"}
{"original": "ناوچەی ڕووسیش، ناوچەی باکووری رۆژەەڵاتی تورکیای، بەخۆوە دەگرت، کە بە شێوەیەکی سەرەکی هەرێمەکانی ئەرزەڕوم و تەڕابزۆن و وان و بەدلیس بەخۆوە دەگرێت کە زۆربەی کوردستانی باکوور بەخۆوە دەگرێت.", "corrupted": "ناوچەی ڕووسیش، ناوچەی باکووری رۆژەەڵاتی تورکیای، بەخۆوە دەگرت، کە بە شێوەیەکی سەرەکی هەرێمەکانیان ئەرزەڕوم و تەڕابزۆن و وان و بەدلیس بەخۆوە دەگرێت کە زۆربەی کوردستانی باکوور بەخۆوە دەگرێت.", "source": "ناوچەی ڕووسیش، ناوچەی باکووری رۆژەەڵاتی تورکیای، بەخۆوە دەگرت، کە بە شێوەیەکی سەرەکی هەرێمەکانیان ئەرزەڕوم و تەڕابزۆن و وان و بەدلیس بەخۆوە دەگرێت کە زۆربەی کوردستانی باکوور بەخۆوە دەگرێت.", "target": "ناوچەی ڕووسیش، ناوچەی باکووری رۆژەەڵاتی تورکیای، بەخۆوە دەگرت، کە بە شێوەیەکی سەرەکی هەرێمەکانی ئەرزەڕوم و تەڕابزۆن و وان و بەدلیس بەخۆوە دەگرێت کە زۆربەی کوردستانی باکوور بەخۆوە دەگرێت.", "errors": [{"type": "clitic_form", "original": "هەرێمەکانی", "error": "هەرێمەکانیان", "start": 85, "end": 95, "description": "clitic_form: 'هەرێمەکانی' → 'هەرێمەکانیان'"}], "source_id": "7379", "category": "social_sciences"}
{"original": "لە زمانی کوردیدا وێڕای ڕێگەی وشەسازی – واتە ئەو ڕێگەیەی کە نیشانە سەرەکییەکان و ئەوانی دی دەچنە سەر ژمارەی بنجی و دەیانکەنە ژمارەی پلەیی – هەروەەا ڕێگەی ڕستەسازی و وەرگرتنیش هەیە.", "corrupted": "لە زمانی کوردیدا وێڕای ڕێگەی وشەسازی – واتە ئەو ڕێگەیەی کە نیشانە سەرەکییەکان و ئەوانی دی دەچنە سەر ژمارەی بنجی و دەیانکەنە ژمارەی پلەیی – هەروەەا ڕێگەی ڕستەسازی و وەرگرتنیش هەیە.", "source": "لە زمانی کوردیدا وێڕای ڕێگەی وشەسازی – واتە ئەو ڕێگەیەی کە نیشانە سەرەکییەکان و ئەوانی دی دەچنە سەر ژمارەی بنجی و دەیانکەنە ژمارەی پلەیی – هەروەەا ڕێگەی ڕستەسازی و وەرگرتنیش هەیە.", "target": "لە زمانی کوردیدا وێڕای ڕێگەی وشەسازی – واتە ئەو ڕێگەیەی کە نیشانە سەرەکییەکان و ئەوانی دی دەچنە سەر ژمارەی بنجی و دەیانکەنە ژمارەی پلەیی – هەروەەا ڕێگەی ڕستەسازی و وەرگرتنیش هەیە.", "errors": [], "source_id": "7629", "category": "linguistics"}
