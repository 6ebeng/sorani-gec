{"original": "گژوگیاو دارو درەختەکانی لە گژوگیاو درەختی ناوچە شاخاویەکان دەچێت، ئەم جیاوازییەش چۆنێەتی ئاووەەواو بەرزی و نزمی ڕووی زەوی دەردەخەن، ئەوەتا باران لە باشووری ناوچەکە ۲۰۰ ملمە، بەرز دەبێتەوە بۆ ۴۰۰ ملم لە سنوری باکووری ناوچەکە.", "corrupted": "گژوگیاو دارو ضرەختەکانی لە گژوگیاو درەختی ناوچە شاخاویەکان دەچێت، ئەم جیاوازییەش چۆنێەتی ئاووەەواو بەرزی و نزمیان ڕووی زەوی دەردەخەن، ئەوەتا باران لە باشووری ناوچەکە ۲۰۰ ملمە، بەرز دەبێتەوە بۆ ۴۰۰ ملم ڵە سنوری باکووری ناوچەکە.", "source": "گژوگیاو دارو ضرەختەکانی لە گژوگیاو درەختی ناوچە شاخاویەکان دەچێت، ئەم جیاوازییەش چۆنێەتی ئاووەەواو بەرزی و نزمیان ڕووی زەوی دەردەخەن، ئەوەتا باران لە باشووری ناوچەکە ۲۰۰ ملمە، بەرز دەبێتەوە بۆ ۴۰۰ ملم ڵە سنوری باکووری ناوچەکە.", "target": "گژوگیاو دارو درەختەکانی لە گژوگیاو درەختی ناوچە شاخاویەکان دەچێت، ئەم جیاوازییەش چۆنێەتی ئاووەەواو بەرزی و نزمی ڕووی زەوی دەردەخەن، ئەوەتا باران لە باشووری ناوچەکە ۲۰۰ ملمە، بەرز دەبێتەوە بۆ ۴۰۰ ملم لە سنوری باکووری ناوچەکە.", "errors": [{"type": "possessive_clitic", "original": "نزمی", "error": "نزمیان", "start": 107, "end": 111, "description": "possessive_clitic: 'نزمی' → 'نزمیان'"}, {"type": "spelling_confusion", "original": "لە", "error": "ڵە", "start": 201, "end": 203, "description": "spelling_confusion: 'لە' → 'ڵە'"}, {"type": "spelling_confusion", "original": "درەختەکانی", "error": "ضرەختەکانی", "start": 13, "end": 23, "description": "spelling_confusion: 'درەختەکانی' → 'ضرەختەکانی'"}], "source_id": "4330", "category": "social_sciences"}
