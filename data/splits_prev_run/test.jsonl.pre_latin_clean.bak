{"original": "کاشیەکان پاش سەقامگیربوون ڕەوشی گشتی وڵات شارێکی نوێیان بنیاتنا تا ببێتە پایەتەختیان، ناویان ناوە بە ناوی پاشاکەیان . پاشماوەی ئەم شارە ئەمڕۆ دەکەوێتە باشووری ڕۆژئاوای شاری بەغداد بە نزیکەی ، پێی دەڵێن .", "corrupted": "کاشیەکان پاش سەقامگیربوون ڕەوشی گشطی وڵاط شارێکی نوێیان بنیاتنا تا ببێتە پایەتەختیان، ناویان ناوە بە ناوی پاشاکەیان. پاشماوەی ئەم شارە ئەمرۆ دەکەوێتە باشووری ڕۆژئاوای شاری بەغضاد بە نزیکەی، پێی دەڵێن.", "source": "کاشیەکان پاش سەقامگیربوون ڕەوشی گشطی وڵاط شارێکی نوێیان بنیاتنا تا ببێتە پایەتەختیان، ناویان ناوە بە ناوی پاشاکەیان. پاشماوەی ئەم شارە ئەمرۆ دەکەوێتە باشووری ڕۆژئاوای شاری بەغضاد بە نزیکەی، پێی دەڵێن.", "target": "کاشیەکان پاش سەقامگیربوون ڕەوشی گشتی وڵات شارێکی نوێیان بنیاتنا تا ببێتە پایەتەختیان، ناویان ناوە بە ناوی پاشاکەیان . پاشماوەی ئەم شارە ئەمڕۆ دەکەوێتە باشووری ڕۆژئاوای شاری بەغداد بە نزیکەی ، پێی دەڵێن .", "errors": [{"type": "spelling_confusion", "original": "بەغداد", "error": "بەغضاد", "start": 173, "end": 179, "description": "spelling_confusion: 'بەغداد' → 'بەغضاد'"}, {"type": "spelling_confusion", "original": "ئەمڕۆ", "error": "ئەمرۆ", "start": 136, "end": 141, "description": "spelling_confusion: 'ئەمڕۆ' → 'ئەمرۆ'"}, {"type": "spelling_confusion", "original": "وڵات", "error": "وڵاط", "start": 37, "end": 41, "description": "spelling_confusion: 'وڵات' → 'وڵاط'"}, {"type": "spelling_confusion", "original": "گشتی", "error": "گشطی", "start": 32, "end": 36, "description": "spelling_confusion: 'گشتی' → 'گشطی'"}], "source_id": "5365", "category": "history"}
