{"original": "ئەم دیوانە هەڵدەستا بەدروستکردنی پۆشاک و جلوبەرگی فەرمی خەلیفەو گەورە کاربەدەستانی دەوڵەت و نەخشاندنی ئاڵاو دروشمی تایبەت بە دەوڵەت.", "corrupted": "ئەمدیوانە هەڵدەستا بەدروست کردنی پۆشاک و جلوبە رگی فەرمی خەلیفەو گەورە کاربەدەستانی دەوڵەت و نەخشاندنی ئاڵاو دروشمی تایبەت بە دەوڵەت.", "source": "ئەمدیوانە هەڵدەستا بەدروست کردنی پۆشاک و جلوبە رگی فەرمی خەلیفەو گەورە کاربەدەستانی دەوڵەت و نەخشاندنی ئاڵاو دروشمی تایبەت بە دەوڵەت.", "target": "ئەم دیوانە هەڵدەستا بەدروستکردنی پۆشاک و جلوبەرگی فەرمی خەلیفەو گەورە کاربەدەستانی دەوڵەت و نەخشاندنی ئاڵاو دروشمی تایبەت بە دەوڵەت.", "errors": [{"type": "whitespace", "original": "جلوبەرگی", "error": "جلوبە رگی", "start": 41, "end": 49, "description": "whitespace: 'جلوبەرگی' → 'جلوبە رگی'"}, {"type": "whitespace", "original": "بەدروستکردنی", "error": "بەدروست کردنی", "start": 20, "end": 32, "description": "whitespace: 'بەدروستکردنی' → 'بەدروست کردنی'"}, {"type": "whitespace", "original": "ئەم دیوانە", "error": "ئەمدیوانە", "start": 0, "end": 10, "description": "whitespace: 'ئەم دیوانە' → 'ئەمدیوانە'"}], "source_id": "2371", "category": "history"}
{"original": "کە لافاویان بەرەو نشێوی کۆدەبنەوە و جۆگەی بچووک پەیدا دەکەن و ئەم جۆگانەش یەکدەگرنەوە و شیوەڵ و چەماویان لێ پەیدا دەبێت و نشیۆ بە نشیۆ دەڕۆن تا هەموو بەیەکدەگەن و ڕووباری گەورە دروست دەکەن.", "corrupted": "کە لافاویان بەرەو نشێوی کۆدەبنەوە و جۆگەی بچووک پەیدا دەکەن و ئەم جۆگانەش یەکدەگرنەوە و شیوەڵ و چەماویان لێ پەیدا دەبێت و نشیۆ بە نشیۆ دەڕۆن تا هەموو بەیەکدەگەن و ڕووباری گەورە دروست دەکەن.", "source": "کە لافاویان بەرەو نشێوی کۆدەبنەوە و جۆگەی بچووک پەیدا دەکەن و ئەم جۆگانەش یەکدەگرنەوە و شیوەڵ و چەماویان لێ پەیدا دەبێت و نشیۆ بە نشیۆ دەڕۆن تا هەموو بەیەکدەگەن و ڕووباری گەورە دروست دەکەن.", "target": "کە لافاویان بەرەو نشێوی کۆدەبنەوە و جۆگەی بچووک پەیدا دەکەن و ئەم جۆگانەش یەکدەگرنەوە و شیوەڵ و چەماویان لێ پەیدا دەبێت و نشیۆ بە نشیۆ دەڕۆن تا هەموو بەیەکدەگەن و ڕووباری گەورە دروست دەکەن.", "errors": [], "source_id": "1734", "category": "social_sciences"}
{"original": "ئایینی مەسیحی وەکو ئایینی ئاسمانی لە فەلەستین دەرکەوتووە و پەیامبەر و موژدەبەرو بەخشی ئایینەکە حەزرەتی بۆ ڕێگرتن لە خراپەکاری و ستەم و بێ باوەڕی و بڵاوکردنەوەی یەکتا پەرستی و تەبایی و خۆشەویستی لەنێو مرۆڤدا و هەوڵ و کۆششی بەردەوامی کردووە.", "corrupted": "ئایینی مەسیحی وەکو ئایینی ئاسمانی لە فەلەستین دەرکەوتووە و پەیامبەر و موژدەبەرو بەخشی ئایینەکە حەزرەتی بۆ ڕێگرتن لە خراپەکاری و ستەم و بێ باوەڕی و بڵاوکردنەوەی یەکتا پەرستی و تەبایی و خۆشەویستی لەنێو مرۆڤدا و هەوڵ و کۆششی بەردەوامی کردووە.", "source": "ئایینی مەسیحی وەکو ئایینی ئاسمانی لە فەلەستین دەرکەوتووە و پەیامبەر و موژدەبەرو بەخشی ئایینەکە حەزرەتی بۆ ڕێگرتن لە خراپەکاری و ستەم و بێ باوەڕی و بڵاوکردنەوەی یەکتا پەرستی و تەبایی و خۆشەویستی لەنێو مرۆڤدا و هەوڵ و کۆششی بەردەوامی کردووە.", "target": "ئایینی مەسیحی وەکو ئایینی ئاسمانی لە فەلەستین دەرکەوتووە و پەیامبەر و موژدەبەرو بەخشی ئایینەکە حەزرەتی بۆ ڕێگرتن لە خراپەکاری و ستەم و بێ باوەڕی و بڵاوکردنەوەی یەکتا پەرستی و تەبایی و خۆشەویستی لەنێو مرۆڤدا و هەوڵ و کۆششی بەردەوامی کردووە.", "errors": [], "source_id": "2455", "category": "history"}
