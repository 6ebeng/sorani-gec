{"original": "ئەوانەش کە ئازاد بوون‌و سیفەتی هاووڵاتیان هەبووە چەند مافێکیان هەبووە، وەک: مافی ژیان، مافی موڵکداری، مافی پێکەوەنانی خێزان، مافی کۆیلەداری، بەڵکو وەک نەریتێک پارێزراون‌و پێڕەو کراون، هەر بۆیە پێشێلکردنی ئەم مافانە زۆر ئاسان‌و ئاسایی بووە.", "corrupted": "ئەوانەش کە ئازاد بوون‌و سیفەتی هاووڵاتیان هەبووە چەنض مافێکیان هەبووە، وەک: مافی ژیان، مافی موڵکداڕی، مافی پێکەوەنانی خێزان، مافی کۆیلەداری، بەڵکو وەک نەڕیتێک پارێزراون‌و پێرەو کڕاون، هەر بۆیە پێشێلکردنی ئەم مافانە زۆڕ ئاسان‌و ئاسایی بووە.", "source": "ئەوانەش کە ئازاد بوون‌و سیفەتی هاووڵاتیان هەبووە چەنض مافێکیان هەبووە، وەک: مافی ژیان، مافی موڵکداڕی، مافی پێکەوەنانی خێزان، مافی کۆیلەداری، بەڵکو وەک نەڕیتێک پارێزراون‌و پێرەو کڕاون، هەر بۆیە پێشێلکردنی ئەم مافانە زۆڕ ئاسان‌و ئاسایی بووە.", "target": "ئەوانەش کە ئازاد بوون‌و سیفەتی هاووڵاتیان هەبووە چەند مافێکیان هەبووە، وەک: مافی ژیان، مافی موڵکداری، مافی پێکەوەنانی خێزان، مافی کۆیلەداری، بەڵکو وەک نەریتێک پارێزراون‌و پێڕەو کراون، هەر بۆیە پێشێلکردنی ئەم مافانە زۆر ئاسان‌و ئاسایی بووە.", "errors": [{"type": "spelling_confusion", "original": "زۆر", "error": "زۆڕ", "start": 215, "end": 218, "description": "spelling_confusion: 'زۆر' → 'زۆڕ'"}, {"type": "spelling_confusion", "original": "کراون،", "error": "کڕاون،", "start": 177, "end": 183, "description": "spelling_confusion: 'کراون،' → 'کڕاون،'"}, {"type": "spelling_confusion", "original": "پێڕەو", "error": "پێرەو", "start": 171, "end": 176, "description": "spelling_confusion: 'پێڕەو' → 'پێرەو'"}, {"type": "spelling_confusion", "original": "نەریتێک", "error": "نەڕیتێک", "start": 151, "end": 158, "description": "spelling_confusion: 'نەریتێک' → 'نەڕیتێک'"}, {"type": "spelling_confusion", "original": "موڵکداری،", "error": "موڵکداڕی،", "start": 92, "end": 101, "description": "spelling_confusion: 'موڵکداری،' → 'موڵکداڕی،'"}, {"type": "spelling_confusion", "original": "چەند", "error": "چەنض", "start": 49, "end": 53, "description": "spelling_confusion: 'چەند' → 'چەنض'"}], "source_id": "239", "category": "law"}
