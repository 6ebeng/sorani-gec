{"original": "هەندێک جاریش ئەو پارتیکڵە دەتوانێت دەربنەبڕدرێت، ئەمەش پەیوەندیی بەوەوە هەیە، کە جۆری شکانەوەی کردارەکە مەرجییە، بۆیە جێگای پارتیکڵەکە دەگرێتەوە، بڕوانە .", "corrupted": "هەندێک جاریش ئەو پارتیکڵە دەتوانێت دەربنەبردرێت، یەمەش پەیوەندیی بەوەوە هەیە، کە جۆری شکانەوەی کردارەکە مەرجییە، بۆیە جیگای پارتیکڵەکە دەگرێتەوە، بڕوانە.", "source": "هەندێک جاریش ئەو پارتیکڵە دەتوانێت دەربنەبردرێت، یەمەش پەیوەندیی بەوەوە هەیە، کە جۆری شکانەوەی کردارەکە مەرجییە، بۆیە جیگای پارتیکڵەکە دەگرێتەوە، بڕوانە.", "target": "هەندێک جاریش ئەو پارتیکڵە دەتوانێت دەربنەبڕدرێت، ئەمەش پەیوەندیی بەوەوە هەیە، کە جۆری شکانەوەی کردارەکە مەرجییە، بۆیە جێگای پارتیکڵەکە دەگرێتەوە، بڕوانە .", "errors": [{"type": "orthography", "original": "جێگای", "error": "جیگای", "start": 118, "end": 123, "description": "orthography: 'جێگای' → 'جیگای'"}, {"type": "orthography", "original": "ئەمەش", "error": "یەمەش", "start": 49, "end": 54, "description": "orthography: 'ئەمەش' → 'یەمەش'"}, {"type": "orthography", "original": "دەربنەبڕدرێت،", "error": "دەربنەبردرێت،", "start": 35, "end": 48, "description": "orthography: 'دەربنەبڕدرێت،' → 'دەربنەبردرێت،'"}], "source_id": "9721", "category": "linguistics"}
{"original": "ئا بەم جۆرە فەلسەفە لەمەڕ دیاردە ماددییەکان دەگاتە چەمکی (سروشت)و، سەبارەت بە بوونەوەرە ژیرەکانیش دەگاتە چەمکی ، سەبارەت بەدیاردەکانی گەردوونیش دەگاتە چەمکەکانی پێکەوە بەستنی هۆکارێتی سیستەم و ئامانج و گەشەسەندن.", "corrupted": "ئا بەم جۆرە فەلسەفە لەمەڕ دیاردە ماددییەکان دەگاتە چەمکی (سروشت)و، سەبارەت بە بوونەوەرە ژیرەکانیش دەگاتە چەمکی ، سەبارەت بەدیاردەکانی گەردوونیش دەگاتە چەمکەکانی پێکەوە بەستنی هۆکارێتی سیستەم و ئامانج و گەشەسەندن.", "source": "ئا بەم جۆرە فەلسەفە لەمەڕ دیاردە ماددییەکان دەگاتە چەمکی (سروشت)و، سەبارەت بە بوونەوەرە ژیرەکانیش دەگاتە چەمکی ، سەبارەت بەدیاردەکانی گەردوونیش دەگاتە چەمکەکانی پێکەوە بەستنی هۆکارێتی سیستەم و ئامانج و گەشەسەندن.", "target": "ئا بەم جۆرە فەلسەفە لەمەڕ دیاردە ماددییەکان دەگاتە چەمکی (سروشت)و، سەبارەت بە بوونەوەرە ژیرەکانیش دەگاتە چەمکی ، سەبارەت بەدیاردەکانی گەردوونیش دەگاتە چەمکەکانی پێکەوە بەستنی هۆکارێتی سیستەم و ئامانج و گەشەسەندن.", "errors": [], "source_id": "9975", "category": "social_sciences"}
