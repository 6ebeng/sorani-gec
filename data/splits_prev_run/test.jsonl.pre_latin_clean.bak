{"original": "ئەم کۆڕەوە سەرەنجی ڕای گشتی جیەانی ڕاکێشا و دوای ئەوەی هێزی پێشمەرگەی کوردستان توانی هێرشی سوپای عێراق لە بەرەکانی و ڕابگرن. نەتەوە یەکگرتوەکان بڕیاری ۶۸۸یان دەرکرد کە سنووری دانا بۆ دەستدرێژیەکانی حکومەتی عێراق بۆ سەر خەڵکی بێ چارەی کوردستان.", "corrupted": "ئەم کۆڕەوە سەرەنجی ڕایگشتی جیەانی ڕاکێشا و دوای ئەوەی هێزی پێشمەرگەی کوردستان توانی هێرشیسوپای عێراق لە بە رەکانی و ڕابگرن. نەتەوە یەکگرتوەکان بڕیاری ۶۸۸ یان دەرکردیان کە سنووری دانا بۆ دەستدرێژیەکانی حکومەتیعێراق بۆ سەر خەڵکی بێ چا رەی کو ردستان.", "source": "ئەم کۆڕەوە سەرەنجی ڕایگشتی جیەانی ڕاکێشا و دوای ئەوەی هێزی پێشمەرگەی کوردستان توانی هێرشیسوپای عێراق لە بە رەکانی و ڕابگرن. نەتەوە یەکگرتوەکان بڕیاری ۶۸۸ یان دەرکردیان کە سنووری دانا بۆ دەستدرێژیەکانی حکومەتیعێراق بۆ سەر خەڵکی بێ چا رەی کو ردستان.", "target": "ئەم کۆڕەوە سەرەنجی ڕای گشتی جیەانی ڕاکێشا و دوای ئەوەی هێزی پێشمەرگەی کوردستان توانی هێرشی سوپای عێراق لە بەرەکانی و ڕابگرن. نەتەوە یەکگرتوەکان بڕیاری ۶۸۸یان دەرکرد کە سنووری دانا بۆ دەستدرێژیەکانی حکومەتی عێراق بۆ سەر خەڵکی بێ چارەی کوردستان.", "errors": [{"type": "subject_verb_number", "original": "دەرکرد", "error": "دەرکردیان", "start": 158, "end": 164, "description": "subject_verb_number: 'دەرکرد' → 'دەرکردیان'"}, {"type": "whitespace", "original": "کوردستان.", "error": "کو ردستان.", "start": 237, "end": 246, "description": "whitespace: 'کوردستان.' → 'کو ردستان.'"}, {"type": "whitespace", "original": "چارەی", "error": "چا رەی", "start": 231, "end": 236, "description": "whitespace: 'چارەی' → 'چا رەی'"}, {"type": "whitespace", "original": "حکومەتی عێراق", "error": "حکومەتیعێراق", "start": 201, "end": 214, "description": "whitespace: 'حکومەتی عێراق' → 'حکومەتیعێراق'"}, {"type": "whitespace", "original": "۶۸۸یان", "error": "۶۸۸ یان", "start": 151, "end": 157, "description": "whitespace: '۶۸۸یان' → '۶۸۸ یان'"}, {"type": "whitespace", "original": "بەرەکانی", "error": "بە رەکانی", "start": 106, "end": 114, "description": "whitespace: 'بەرەکانی' → 'بە رەکانی'"}, {"type": "whitespace", "ori