{"original": "پلەی بەرزی پەرستش ئەوەیە خودا بپەرستی وەک ئەوەی کەبیبینی، کە تۆ ئەو نابینی ئەو تۆ دەبینێ ئاگای لێتە، ئەمە واتای راستی پەرستش و، بەمەش رەزامەندی پەروەردگار بەدەست دێنێت وە سەرکەوتوو دەبێت.", "corrupted": "پلەی بەرزی پەرستش ئەوەیە خودا بپەرستی وەک ئەوەی کەبیبینی، کە تۆ ئەو نابینی ئەو تۆ دەبینێ ئاگاەکەی لێتە، ئەمە واتای راستی پەرستش و، بەمەش رەزامەندی پەروەردگار بەدەست دێنێت وە سەرکەوتوو دەبێت.", "source": "پلەی بەرزی پەرستش ئەوەیە خودا بپەرستی وەک ئەوەی کەبیبینی، کە تۆ ئەو نابینی ئەو تۆ دەبینێ ئاگاەکەی لێتە، ئەمە واتای راستی پەرستش و، بەمەش رەزامەندی پەروەردگار بەدەست دێنێت وە سەرکەوتوو دەبێت.", "target": "پلەی بەرزی پەرستش ئەوەیە خودا بپەرستی وەک ئەوەی کەبیبینی، کە تۆ ئەو نابینی ئەو تۆ دەبینێ ئاگای لێتە، ئەمە واتای راستی پەرستش و، بەمەش رەزامەندی پەروەردگار بەدەست دێنێت وە سەرکەوتوو دەبێت.", "errors": [{"type": "noun_adjective_agreement", "original": "ئاگای لێتە،", "error": "ئاگاەکەی لێتە،", "start": 89, "end": 100, "description": "noun_adjective_agreement: 'ئاگای لێتە،' → 'ئاگاەکەی لێتە،'"}], "source_id": "2467", "category": "islamic_studies"}
