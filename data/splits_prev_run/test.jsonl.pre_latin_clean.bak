{"original": "لە ڕستەی یەکەمدا ، ، گرێیەکی ناوییە، چونکە لە هەردوو ناوی و بە یارمەتی ئامرازی دانەپاڵ پێکەاتووە. ئەرکی (بکەر)یشی بینیوە، چونکە کاری (داگیرسان)ی ئەنجامداوە، واتە کارێکی ئەنجامداوە‌و کارەکەش تەواوە.", "corrupted": "لە ڕستەی یەکەمدا،، گر ێیەکی ناوییە، چونکە لە هەردوو ناویو بە یارمەتی ئامرازی دانەپاڵ پێکەاتو وە. ئە رکی (بکەر)یشی بینیوە، چونکەکاری (داگیرسان)ی ئەنجامداوە، واتە کارێکی ئەنجامداوە‌و کارەکەش تەواوە.", "source": "لە ڕستەی یەکەمدا،، گر ێیەکی ناوییە، چونکە لە هەردوو ناویو بە یارمەتی ئامرازی دانەپاڵ پێکەاتو وە. ئە رکی (بکەر)یشی بینیوە، چونکەکاری (داگیرسان)ی ئەنجامداوە، واتە کارێکی ئەنجامداوە‌و کارەکەش تەواوە.", "target": "لە ڕستەی یەکەمدا ، ، گرێیەکی ناوییە، چونکە لە هەردوو ناوی و بە یارمەتی ئامرازی دانەپاڵ پێکەاتووە. ئەرکی (بکەر)یشی بینیوە، چونکە کاری (داگیرسان)ی ئەنجامداوە، واتە کارێکی ئەنجامداوە‌و کارەکەش تەواوە.", "errors": [{"type": "whitespace", "original": "چونکە کاری", "error": "چونکەکاری", "start": 122, "end": 132, "description": "whitespace: 'چونکە کاری' → 'چونکەکاری'"}, {"type": "whitespace", "original": "ئەرکی", "error": "ئە رکی", "start": 98, "end": 103, "description": "whitespace: 'ئەرکی' → 'ئە رکی'"}, {"type": "whitespace", "original": "پێکەاتووە.", "error": "پێکەاتو وە.", "start": 87, "end": 97, "description": "whitespace: 'پێکەاتووە.' → 'پێکەاتو وە.'"}, {"type": "whitespace", "original": "ناوی و", "error": "ناویو", "start": 53, "end": 59, "description": "whitespace: 'ناوی و' → 'ناویو'"}, {"type": "whitespace", "original": "گرێیەکی", "error": "گر ێیەکی", "start": 21, "end": 28, "description": "whitespace: 'گرێیەکی' → 'گر ێیەکی'"}], "source_id": "9564", "category": "linguistics"}
{"original": "لە جیاتی شێخ و سەرۆک عەشیرەت و دەرەبەگە گەورەکان، ئەمجاریان رۆشنبیران سەرکردایەتی ڕاپەرینەکەیان دەکرد.", "corrupted": "لە جیاتی شێخ و سەرۆک عەشیرەت و دەرەبەگە گەورەکان، ئەمجاریان رۆشنبیران سەرکردایەتی ڕاپەرینەکەیان دەکرد.", "source": "لە جیاتی شێخ و سەرۆک عەشیرەت و دەرەبەگە گەورەکان، ئەمجاریان رۆشنبیران سەرکردایەتی ڕاپەرینەکەیان دەکرد.", "target": "لە جیاتی شێخ و سەرۆک عەشیرەت و دەرەبەگە گەورەکان، ئەمجاریان رۆشنبیران سەرکردایەتی ڕاپەرینەکەیان دەکرد.", "errors": [], "source_id": "4414", "category": "history"}
