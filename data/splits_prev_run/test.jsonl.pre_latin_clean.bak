{"original": "ئەوەتا پایە سەرەکیەکانی ژیاری ئیسلامی کە کورد و عەرەب و توران و فارس بوون وەک خۆیان ماون و پێناسەی نەتەوەییان سەدان ساڵە لە دەست نەداوە.", "corrupted": "ئەوەتا پایە سەرەکیەکانی ژیاری ئیسلامی کە کورد و عەرەب و توران و فارس بوون وەک خۆیان ماون و پێناسەی نەتەوەییان سەدان ساڵە لە دەست نەداوە.", "source": "ئەوەتا پایە سەرەکیەکانی ژیاری ئیسلامی کە کورد و عەرەب و توران و فارس بوون وەک خۆیان ماون و پێناسەی نەتەوەییان سەدان ساڵە لە دەست نەداوە.", "target": "ئەوەتا پایە سەرەکیەکانی ژیاری ئیسلامی کە کورد و عەرەب و توران و فارس بوون وەک خۆیان ماون و پێناسەی نەتەوەییان سەدان ساڵە لە دەست نەداوە.", "errors": [], "source_id": "822", "category": "islamic_studies"}
{"original": "پەنابردنە بەر ئێران بۆ بەدیەێنانی ئامانجەکانیان، ئەمەش ڕێگای بۆ دەست تێوەردانی دەرەکی خۆشدەکرد.", "corrupted": "پەنابردنە بەڕ ئێران بۆ بەدیەێنانی ئامانجەکانیان، یەمەش ڕێگای بۆ دەست تێوەردان دەرەکی خۆشدەکرد.", "source": "پەنابردنە بەڕ ئێران بۆ بەدیەێنانی ئامانجەکانیان، یەمەش ڕێگای بۆ دەست تێوەردان دەرەکی خۆشدەکرد.", "target": "پەنابردنە بەر ئێران بۆ بەدیەێنانی ئامانجەکانیان، ئەمەش ڕێگای بۆ دەست تێوەردانی دەرەکی خۆشدەکرد.", "errors": [{"type": "orthography", "original": "ئەمەش", "error": "یەمەش", "start": 49, "end": 54, "description": "orthography: 'ئەمەش' → 'یەمەش'"}, {"type": "orthography", "original": "بەر", "error": "بەڕ", "start": 10, "end": 13, "description": "orthography: 'بەر' → 'بەڕ'"}, {"type": "noun_adjective_agreement", "original": "تێوەردانی دەرەکی", "error": "تێوەردان دەرەکی", "start": 69, "end": 85, "description": "noun_adjective_agreement: 'تێوەردانی دەرەکی' → 'تێوەردان دەرەکی'"}], "source_id": "403", "category": "social_sciences"}
{"original": "شەڕێکی خوێناوی و زیانێکی زۆر، میرو پاشماوەی هێزەکەی دەستگیرکران، بەم شێوەیە کۆتایی بەو جوڵانەوە ڕزگاریخوازەی کوردەات و میر ڕەوانەی ئەستەمبوڵ کرا.", "corrupted": "شە ڕێکی خوێناویوزیانێکی زۆر، میرو پاشماوەی هێزەکەی دەستگیرکران، بەم شێوەیەکۆتایی بەو جوڵانەوە ڕزگاریخوازەی کوردەات و میر ڕەوانەی ئەستەمبوڵ کرا.", "source": "شە ڕێکی خوێناویوزیانێکی زۆر، میرو پاشماوەی هێزەکەی دەستگیرکران، بەم شێوەیەکۆتایی بەو جوڵانەوە ڕزگاریخوازەی کوردەات و میر ڕەوانەی ئەستەمبوڵ کرا.", "target": "شەڕێکی خوێناوی و زیانێکی زۆر، میرو پاشماوەی هێزەکەی دەستگیرکران، بەم شێوەیە کۆتایی بەو جوڵانەوە ڕزگاریخوازەی کوردەات و میر ڕەوانەی ئەستەمبوڵ کرا.", "errors": [{"type": "whitespace", "original": "شێوەیە کۆتایی", "error": "شێوەیەکۆتایی", "start": 69, "end": 82, "description": "whitespace: 'شێوەیە کۆتایی' → 'شێوەیەکۆتایی'"}, {"type": "whitespace", "original": "و زیانێکی", "error": "وزیانێکی", "start": 15, "end": 24, "description": "whitespace: 'و زیانێکی' → 'وزیانێکی'"}, {"type": "whitespace", "original": "خوێناوی و", "error": "خوێناویو", "start": 7, "end": 16, "description": "whitespace: 'خوێناوی و' → 'خوێناویو'"}, {"type": "whitespace", "original": "شەڕێکی", "error": "شە ڕێکی", "start": 0, "end": 6, "description": "whitespace: 'شەڕێکی' → 'شە ڕێکی'"}], "source_id": "2502", "category": "history"}
{"original": "ئەم سێ هاوکێشە بەکاردێن بۆ هەژمار کردنی بڕی ئەو وزە کارەبایەی لە بەرگرەدا بۆ گەرمی دەگۆرێن و پێیان دەووترێ یاسای جوول.کاتێک بە ڤۆلت وە بە ئەمپێر وە بە چرکە یە، ئەوا واتە بڕی گەرمی پەیدا بوو بە جوول دەبێت.", "corrupted": "ئەم سێ هاوکێشە بەکاردێن بۆ هەژمار کردنیان بڕی ئەو وزە کارەبایەی لە بەرگرەدا بۆ گەرمی دەگۆرێن و پێیان دەووترێ یاسای جوول.کاتێک بە ڤۆلت وە بە ئەمپێر وە بە چرکە یە، ئەوا واتە بڕی گەرمی پەیدا بوو بە جوول دەبێت.", "source": "ئەم سێ هاوکێشە بەکاردێن بۆ هەژمار کردنیان بڕی ئەو وزە کارەبایەی لە بەرگرەدا بۆ گەرمی دەگۆرێن و پێیان دەووترێ یاسای جوول.کاتێک بە ڤۆلت وە بە ئەمپێر وە بە چرکە یە، ئەوا واتە بڕی گەرمی پەیدا بوو بە جوول دەبێت.", "target": "ئەم سێ هاوکێشە بەکاردێن بۆ هەژمار کردنی بڕی ئەو وزە کارەبایەی لە بەرگرەدا بۆ گەرمی دەگۆرێن و پێیان دەووترێ یاسای جوول.کاتێک بە ڤۆلت وە بە ئەمپێر وە بە چرکە یە، ئەوا واتە بڕی گەرمی پەیدا بوو بە جوول دەبێت.", "errors": [{"type": "clitic_form", "original": "کردنی", "error": "کردنیان", "start": 34, "end": 39, "description": "clitic_form: 'کردنی' → 'کردنیان'"}], "source_id": "8157", "category": "sciences"}
{"original": "بوول لە ساڵی ۱۸۱۵ لەدایک بووە، باوکی بازرگان بووە، لەەەمان کاتدا هەواداری خوێندن و خاوەن مێشکێکی کراوە بوو. لەخوێندنیدا گرنگی بە زانستە بیرکاریەکان و ژیربێژی داوە، بۆیە ئارەزووی ئەوەی دەکرد کە ئەم هەواداریە بۆ کوڕەکەی بگوازێتەوە.", "corrupted": "بوول لە ساڵی ۱۸۱۵ لەدایک بووە، باوکی بازرگان بوە، لەەەمان کاتدا حەواداری خووێندن و غاوەن مێشکێکی کراوە بوو. لەخوێندنیدا گرنگی بە ژانستە بیرکاریەکان و ژیربێژی داوە، بۆیە ئارەزووێ ئەوەی دەکڕد کە یەم هەواداریە بۆ کوڕەکەی بگوازێتەوە.", "source": "بوول لە ساڵی ۱۸۱۵ لەدایک بووە، باوکی بازرگان بوە، لەەەمان کاتدا حەواداری خووێندن و غاوەن مێشکێکی کراوە بوو. لەخوێندنیدا گرنگی بە ژانستە بیرکاریەکان و ژیربێژی داوە، بۆیە ئارەزووێ ئەوەی دەکڕد کە یەم هەواداریە بۆ کوڕەکەی بگوازێتەوە.", "target": "بوول لە ساڵی ۱۸۱۵ لەدایک بووە، باوکی بازرگان بووە، لەەەمان کاتدا هەواداری خوێندن و خاوەن مێشکێکی کراوە بوو. لەخوێندنیدا گرنگی بە زانستە بیرکاریەکان و ژیربێژی داوە، بۆیە ئارەزووی ئەوەی دەکرد کە ئەم هەواداریە بۆ کوڕەکەی بگوازێتەوە.", "errors": [{"type": "orthography", "original": "ئەم", "error": "یەم", "start": 193, "end": 196, "description": "orthography: 'ئەم' → 'یەم'"}, {"type": "orthography", "original": "دەکرد", "error": "دەکڕد", "start": 184, "end": 189, "description": "orthography: 'دەکرد' → 'دەکڕد'"}, {"type": "orthography", "original": "ئارەزووی", "error": "ئارەزووێ", "start": 169, "end": 177, "description": "orthography: 'ئارەزووی' → 'ئارەزووێ'"}, {"type": "orthography", "original": "زانستە", "error": "ژانستە", "start": 129, "end": 135, "description": "orthography: 'زانستە' → 'ژانستە'"}, {"type": "orthography", "original": "خاوەن", "error": "غاوەن", "start": 83, "end": 88, "description": "orthography: 'خاوەن' → 'غاوەن'"}, {"type": "orthography", "original": "خوێندن", "error": "خووێندن", "start": 74, "end": 80, "description": "orthography: 'خوێندن' → 'خووێندن'"}, {"type": "orthography", "original": "هەواداری", "error": "حەواداری", "start": 65, "end": 73, "description": "orthography: 'هەواداری' → 'حەواداری'"}, {"type": "orthogra