{"original": "لەو پێناوەشدا دووجار لە دەربەندی بازیان لە ڕووی هێزەکانی بەغدا وەستا، بەڵام بەەۆی ناپاکی خالید پاشای ئامۆزای سەرنەکەوت. لە جاری سێیەمیش لەساڵی ۱۸۱۲دا لە جەنگی کفری ڕووبەڕووی لەشکرێکی گەورەی بەغدا بۆوە، بەڵام ئەم جارەش ئاواتەکانی نەەاتەدی.", "corrupted": "لەو پێناوەشضا دووجار لە دەربەندی باژیان لە ڕووی هێزەکانی بەغدا وەستا، بەلام بەەۆی ناپاکی خالید پاشای ئامۆزای سەرنەکەوت. ڵە جاڕی سێیەمیش لەساڵی ۱۸۱۲دا لە جەنگی کفری ڕووبەڕووی لەشکرێکی گەورەی بەغدا بۆوە، بەڵام ئەم جارەش ئاواتەکانی نەەاتەدی.", "source": "لەو پێناوەشضا دووجار لە دەربەندی باژیان لە ڕووی هێزەکانی بەغدا وەستا، بەلام بەەۆی ناپاکی خالید پاشای ئامۆزای سەرنەکەوت. ڵە جاڕی سێیەمیش لەساڵی ۱۸۱۲دا لە جەنگی کفری ڕووبەڕووی لەشکرێکی گەورەی بەغدا بۆوە، بەڵام ئەم جارەش ئاواتەکانی نەەاتەدی.", "target": "لەو پێناوەشدا دووجار لە دەربەندی بازیان لە ڕووی هێزەکانی بەغدا وەستا، بەڵام بەەۆی ناپاکی خالید پاشای ئامۆزای سەرنەکەوت. لە جاری سێیەمیش لەساڵی ۱۸۱۲دا لە جەنگی کفری ڕووبەڕووی لەشکرێکی گەورەی بەغدا بۆوە، بەڵام ئەم جارەش ئاواتەکانی نەەاتەدی.", "errors": [{"type": "spelling_confusion", "original": "جاری", "error": "جاڕی", "start": 123, "end": 127, "description": "spelling_confusion: 'جاری' → 'جاڕی'"}, {"type": "spelling_confusion", "original": "لە", "error": "ڵە", "start": 120, "end": 122, "description": "spelling_confusion: 'لە' → 'ڵە'"}, {"type": "spelling_confusion", "original": "بەڵام", "error": "بەلام", "start": 70, "end": 75, "description": "spelling_confusion: 'بەڵام' → 'بەلام'"}, {"type": "spelling_confusion", "original": "بازیان", "error": "باژیان", "start": 33, "end": 39, "description": "spelling_confusion: 'بازیان' → 'باژیان'"}, {"type": "spelling_confusion", "original": "پێناوەشدا", "error": "پێناوەشضا", "start": 4, "end": 13, "description": "spelling_confusion: 'پێناوەشدا' → 'پێناوەشضا'"}], "source_id": "1172", "category": "social_sciences"}
{"original": "دۆخی شل: ماددە شلەکان قەبارەی نەگۆڕ و شێوەی گۆڕاویان هەیە. ئەمەش دەگەڕێتەوە بۆ سیفەتەکانی گەردەکانی ماددەی شل، ئەویش دووری نێوانیان زیاترە لەەی دۆخی رەق و جوولەکردنیان سەربەسترە لەجوولەی گەردەکانی ماددەی رەق. خێراییان زیاترە لەبەر زۆری وزەی ناوەکیان.", "corrupted": "دۆخی شل: ماددە شڵەکان قەبارەی نەگۆڕ و شێوەی گۆڕاویان هەیە. ئەمەش دەگەڕێتەوە بۆ سیفەتەکانی گەردەکانی ماددەی شل، ئەویش دووری نێوانیان زیاترە لەەێ دۆخی رەق و جوولەکردنیان سەربەسترە لەجوولەی گەردەکانی ماددەی رەق. خێراییان زیاترە لەبەر زۆری وزەی ناوەکیان.", "source": "دۆخی شل: ماددە شڵەکان قەبارەی نەگۆڕ و شێوەی گۆڕاویان هەیە. ئەمەش دەگەڕێتەوە بۆ سیفەتەکانی گەردەکانی ماددەی شل، ئەویش دووری نێوانیان زیاترە لەەێ دۆخی رەق و جوولەکردنیان سەربەسترە لەجوولەی گەردەکانی ماددەی رەق. خێراییان زیاترە لەبەر زۆری وزەی ناوەکیان.", "target": "دۆخی شل: ماددە شلەکان قەبارەی نەگۆڕ و شێوەی گۆڕاویان هەیە. ئەمەش دەگەڕێتەوە بۆ سیفەتەکانی گەردەکانی ماددەی شل، ئەویش دووری نێوانیان زیاترە لەەی دۆخی رەق و جوولەکردنیان سەربەسترە لەجوولەی گەردەکانی ماددەی رەق. خێراییان زیاترە لەبەر زۆری وزەی ناوەکیان.", "errors": [{"type": "orthography", "original": "لەەی", "error": "لەەێ", "start": 139, "end": 143, "description": "orthography: 'لەەی' → 'لەەێ'"}, {"type": "orthography", "original": "شلەکان", "error": "شڵەکان", "start": 15, "end": 21, "description": "orthography: 'شلەکان' → 'شڵەکان'"}], "source_id": "4927", "category": "sciences"}
