{"original": "فرمانی جەنگی فرمانێکی ترە، کە پێویستە بۆ پاراستنی ژیانی خەڵکی شارەکەو شارەکەش خۆی لەکاتی هێرش و ڕووبەرووبونەوە ئامادە بکرێت. شاری جەنگی تەنیا ئەرکی جەنگی لەسەر شانەو ئەو ئەرکەش سەرەک فرمانی شارەکەیەو ژیان‌و پەرەسەندنی شارەکەشی لەسەروەستاوە.", "corrupted": "فرمانی جەنگی فرمانێکی ترە، کە پێۆیستە بۆ پاراستنی ژیانی خەڵکێ شارەکەو شارەکەش خۆی لەکاتی هێرش و ڕووبەرووبونەوە ئامادە بکرێت. شاری جەنگی تەنیا ئەڕکی جەنگی لەسەر شانەو ئەوو ئەرکەش سەرەک فرمانی شارەکەیەوو ژیان‌و پەرەسەندنی شارەکەشی لەسەروەستاوە.", "source": "فرمانی جەنگی فرمانێکی ترە، کە پێۆیستە بۆ پاراستنی ژیانی خەڵکێ شارەکەو شارەکەش خۆی لەکاتی هێرش و ڕووبەرووبونەوە ئامادە بکرێت. شاری جەنگی تەنیا ئەڕکی جەنگی لەسەر شانەو ئەوو ئەرکەش سەرەک فرمانی شارەکەیەوو ژیان‌و پەرەسەندنی شارەکەشی لەسەروەستاوە.", "target": "فرمانی جەنگی فرمانێکی ترە، کە پێویستە بۆ پاراستنی ژیانی خەڵکی شارەکەو شارەکەش خۆی لەکاتی هێرش و ڕووبەرووبونەوە ئامادە بکرێت. شاری جەنگی تەنیا ئەرکی جەنگی لەسەر شانەو ئەو ئەرکەش سەرەک فرمانی شارەکەیەو ژیان‌و پەرەسەندنی شارەکەشی لەسەروەستاوە.", "errors": [{"type": "orthography", "original": "شارەکەیەو", "error": "شارەکەیەوو", "start": 190, "end": 199, "description": "orthography: 'شارەکەیەو' → 'شارەکەیەوو'"}, {"type": "orthography", "original": "ئەو", "error": "ئەوو", "start": 166, "end": 169, "description": "orthography: 'ئەو' → 'ئەوو'"}, {"type": "orthography", "original": "ئەرکی", "error": "ئەڕکی", "start": 142, "end": 147, "description": "orthography: 'ئەرکی' → 'ئەڕکی'"}, {"type": "orthography", "original": "خەڵکی", "error": "خەڵکێ", "start": 56, "end": 61, "description": "orthography: 'خەڵکی' → 'خەڵکێ'"}, {"type": "orthography", "original": "پێویستە", "error": "پێۆیستە", "start": 30, "end": 37, "description": "orthography: 'پێویستە' → 'پێۆیستە'"}], "source_id": "4281", "category": "social_sciences"}
{"original": "بەڵام بەەۆی هاتنی هەندێک میری لاوازو بێ توانا و ناکۆکی ناوخۆ بەرەو لاوازی چوون و، لەدوای ئەوە هەندێک جار بەو هۆیەوە سەر بە دەوڵەتی ئێران بوون و تا ساڵی بە تەواوی لەناوچووە.", "corrupted": "بەڵام بەەۆی هاتنی هەندێک میری لاوازو بێ توانا و ناکۆکی ناوخۆ بەرەو لاوازی چوون و، لەدوای ئەوە هەندێک جار بەو هۆیەوە سەر بە دەوڵەتی ئێران بوون و تا ساڵی بە تەواوی لەناوچووە.", "source": "بەڵام بەەۆی هاتنی هەندێک میری لاوازو بێ توانا و ناکۆکی ناوخۆ بەرەو لاوازی چوون و، لەدوای ئەوە هەندێک جار بەو هۆیەوە سەر بە دەوڵەتی ئێران بوون و تا ساڵی بە تەواوی لەناوچووە.", "target": "بەڵام بەەۆی هاتنی هەندێک میری لاوازو بێ توانا و ناکۆکی ناوخۆ بەرەو لاوازی چوون و، لەدوای ئەوە هەندێک جار بەو هۆیەوە سەر بە دەوڵەتی ئێران بوون و تا ساڵی بە تەواوی لەناوچووە.", "errors": [], "source_id": "4558", "category": "history"}
