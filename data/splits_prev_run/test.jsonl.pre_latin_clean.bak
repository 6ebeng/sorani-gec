{"original": "بەو پێیەی جیاوازییەکی ئاشکرا لەو ئاووەەوای ڕووی زەوی هەرێمدا هەیە، جیاوازییەکی هاوتاش لەڕووەکی سروشتدا بەدی دەکرێت، ئەم جیاوازییەش لەنێوان دارستانی چیاکان و کورتەگیای دەشتەکان بەڕوونی دیارە.", "corrupted": "بەو پێیەی جیاوازییەکی ئاشکرا لەو ئاووەەوای ڕووی زەوی هەرێمدا هەیە، جیاوازییەکی هاوتاش لەڕووەکی سروشتدا بەدی دەکرێت، ئەم جیاوازییەش لەنێوان دارستانی چیاکان و کورتەگیای دەشتەکان بەڕوونی دیارە.", "source": "بەو پێیەی جیاوازییەکی ئاشکرا لەو ئاووەەوای ڕووی زەوی هەرێمدا هەیە، جیاوازییەکی هاوتاش لەڕووەکی سروشتدا بەدی دەکرێت، ئەم جیاوازییەش لەنێوان دارستانی چیاکان و کورتەگیای دەشتەکان بەڕوونی دیارە.", "target": "بەو پێیەی جیاوازییەکی ئاشکرا لەو ئاووەەوای ڕووی زەوی هەرێمدا هەیە، جیاوازییەکی هاوتاش لەڕووەکی سروشتدا بەدی دەکرێت، ئەم جیاوازییەش لەنێوان دارستانی چیاکان و کورتەگیای دەشتەکان بەڕوونی دیارە.", "errors": [], "source_id": "2911", "category": "social_sciences"}
{"original": "بۆ پێکانی ئەو مەبەستە، باسەکە کراوەتە دوو بەش: لە بەشی یەکەمدا، کێشەی بزوێنەکان و لە بەشی دووەمدا، کێشەی نەبزوێنەکان، تاوتوێکراوە و لە هەر بەشێکدا، دەنگە کێشەدارەکان خراونەتە بەر تیشکی لێکۆڵینەوە و چارەسەریان پێشنیارکراوە.", "corrupted": "بۆ پێکانی ئەو مەبەس تە، باسەکە کراوەتە دوو بەش: لە بەشی یەکەم دا، کێش ەی بزوێنەکان و لە بەشی دووەمدا، کێشەی نەبزوێنەک ان، تاوتوێکراوە و لە هەربەشێکدا، دەنگە کێشەدارەکان خراونەتە بەر تیشکی لێکۆڵینەوە و چارەسەریان پێشنیارکراوە.", "source": "بۆ پێکانی ئەو مەبەس تە، باسەکە کراوەتە دوو بەش: لە بەشی یەکەم دا، کێش ەی بزوێنەکان و لە بەشی دووەمدا، کێشەی نەبزوێنەک ان، تاوتوێکراوە و لە هەربەشێکدا، دەنگە کێشەدارەکان خراونەتە بەر تیشکی لێکۆڵینەوە و چارەسەریان پێشنیارکراوە.", "target": "بۆ پێکانی ئەو مەبەستە، باسەکە کراوەتە دوو بەش: لە بەشی یەکەمدا، کێشەی بزوێنەکان و لە بەشی دووەمدا، کێشەی نەبزوێنەکان، تاوتوێکراوە و لە هەر بەشێکدا، دەنگە کێشەدارەکان خراونەتە بەر تیشکی لێکۆڵینەوە و چارەسەریان پێشنیارکراوە.", "errors": [{"type": "whitespace", "original": "هەر بەشێکدا،", "error": "هەربەشێکدا،", "start": 135, "end": 147, "description": "whitespace: 'هەر بەشێکدا،' → 'هەربەشێکدا،'"}, {"type": "whitespace", "original": "نەبزوێنەکان،", "error": "نەبزوێنەک ان،", "start": 105, "end": 117, "description": "whitespace: 'نەبزوێنەکان،' → 'نەبزوێنەک ان،'"}, {"type": "whitespace", "original": "کێشەی", "error": "کێش ەی", "start": 64, "end": 69, "description": "whitespace: 'کێشەی' → 'کێش ەی'"}, {"type": "whitespace", "original": "یەکەمدا،", "error": "یەکەم دا،", "start": 55, "end": 63, "description": "whitespace: 'یەکەمدا،' → 'یەکەم دا،'"}, {"type": "whitespace", "original": "مەبەستە،", "error": "مەبەس تە،", "start": 14, "end": 22, "description": "whitespace: 'مەبەستە،' → 'مەبەس تە،'"}], "source_id": "4082", "category": "linguistics"}
