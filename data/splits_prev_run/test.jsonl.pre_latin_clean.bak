{"original": "ئامێرەکە بەرگی کارایەکی زیندووی وەرگرتووە، بەم پێیە بەردەکە کارایەکی خوازراوە و هەموو ڕستەکە خوازە دەردەچێ.", "corrupted": "ئامێرەکە بەرگی کارایەکی زیندووی وە رگرتووە، بەم پێیەبەردەکە کارایەکی خوازراوە و هەم وو ڕستەکە خوازە دەردەچێ.", "source": "ئامێرەکە بەرگی کارایەکی زیندووی وە رگرتووە، بەم پێیەبەردەکە کارایەکی خوازراوە و هەم وو ڕستەکە خوازە دەردەچێ.", "target": "ئامێرەکە بەرگی کارایەکی زیندووی وەرگرتووە، بەم پێیە بەردەکە کارایەکی خوازراوە و هەموو ڕستەکە خوازە دەردەچێ.", "errors": [{"type": "whitespace", "original": "هەموو", "error": "هەم وو", "start": 80, "end": 85, "description": "whitespace: 'هەموو' → 'هەم وو'"}, {"type": "whitespace", "original": "پێیە بەردەکە", "error": "پێیەبەردەکە", "start": 47, "end": 59, "description": "whitespace: 'پێیە بەردەکە' → 'پێیەبەردەکە'"}, {"type": "whitespace", "original": "وەرگرتووە،", "error": "وە رگرتووە،", "start": 32, "end": 42, "description": "whitespace: 'وەرگرتووە،' → 'وە رگرتووە،'"}], "source_id": "2601", "category": "linguistics"}
{"original": "محەمەد و هاوڕێیانی دەبێ ئەم ساڵ بگەڕێنەوەو نەکەن بەڵکو لە ساڵی داەاتوو دا بۆیان هەیە کە بێنە ناو مەککەو ماوەی سێ ڕۆژ تیایدا بمێننەوە، و جگە لە شمشێری ناو کالان هیچی تریان پێ نەبێت.", "corrupted": "محەمەد و هاوڕێیانی دەبێ ئەم ساڵ بگەڕێنەوەو نەکەن بەڵکو لە ساڵی داەاتوو دا بۆیان هەیە کە بێنە ناو مەککەو ماوەی سێ ڕۆژ تیایدا بمێننەوە، و جگە لە شمشێری ناو کالان هیچی تریان پێ نەبێت.", "source": "محەمەد و هاوڕێیانی دەبێ ئەم ساڵ بگەڕێنەوەو نەکەن بەڵکو لە ساڵی داەاتوو دا بۆیان هەیە کە بێنە ناو مەککەو ماوەی سێ ڕۆژ تیایدا بمێننەوە، و جگە لە شمشێری ناو کالان هیچی تریان پێ نەبێت.", "target": "محەمەد و هاوڕێیانی دەبێ ئەم ساڵ بگەڕێنەوەو نەکەن بەڵکو لە ساڵی داەاتوو دا بۆیان هەیە کە بێنە ناو مەککەو ماوەی سێ ڕۆژ تیایدا بمێننەوە، و جگە لە شمشێری ناو کالان هیچی تریان پێ نەبێت.", "errors": [], "source_id": "5767", "category": "social_sciences"}
{"original": "لێرەدا لەکاتی هەڵاوسان بانکی مەرکەزی هەڵدەستێت بە بەرزکردنەوەی ڕێژەیی یەدەگەکە بۆ ئەوەی قەبارەی پارەی ماوە لەلای بانکە بازرگانییەکان کەم بکاتەوە، بەمەش کار دەکاتە سەر قەبارەی قەرزدان و خستنەڕووی پارە لە گەڵیدا بەەای پارەکەش بەرز دەبێتەوە.", "corrupted": "لێرەدا لەکاتی هەڵا وسان بانکی مەرکەزی هەڵدەستێت بە بەرزکردنەوەی ڕێژەیی یەدەگەکەبۆ ئەوەیقەبارەیپارەی ماوەلەلای بانکە بازرگانییەکان کەم بکاتەوە، بەمەش کار دەکاتە سەر قەبارەی قەرزدانو خستنەڕووی پارە لە گەڵیدا بەە ای پارەکەش بەرز دەبێتەوە.", "source": "لێرەدا لەکاتی هەڵا وسان بانکی مەرکەزی هەڵدەستێت بە بەرزکردنەوەی ڕێژەیی یەدەگەکەبۆ ئەوەیقەبارەیپارەی ماوەلەلای بانکە بازرگانییەکان کەم بکاتەوە، بەمەش کار دەکاتە سەر قەبارەی قەرزدانو خستنەڕووی پارە لە گەڵیدا بەە ای پارەکەش بەرز دەبێتەوە.", "target": "لێرەدا لەکاتی هەڵاوسان بانکی مەرکەزی هەڵدەستێت بە بەرزکردنەوەی ڕێژەیی یەدەگەکە بۆ ئەوەی قەبارەی پارەی ماوە لەلای بانکە بازرگانییەکان کەم بکاتەوە، بەمەش کار دەکاتە سەر قەبارەی قەرزدان و خستنەڕووی پارە لە گەڵیدا بەەای پارەکەش بەرز دەبێتەوە.", "errors": [{"type": "whitespace", "original": "بەەای", "error": "بەە ای", "start": 210, "end": 215, "description": "whitespace: 'بەەای' → 'بەە ای'"}, {"type": "whitespace", "original": "قەرزدان و", "error": "قەرزدانو", "start": 175, "end": 184, "description": "whitespace: 'قەرزدان و' → 'قەرزدانو'"}, {"type": "whitespace", "original": "ماوە لەلای", "error": "ماوەلەلای", "start": 102, "end": 112, "description": "whitespace: 'ماوە لەلای' → 'ماوەلەلای'"}, {"type": "whitespace", "original": "قەبارەی پارەی", "error": "قەبارەیپارەی", "start": 88, "end": 101, "description": "whitespace: 'قەبارەی پارەی' → 'قەبارەیپارەی'"}, {"type": "whitespace", "original": "ئەوەی قەبارەی", "error": "ئەوەیقەبارەی", "start": 82, "end": 95, "description": "whitespace: 'ئەوەی قەبارەی' → 'ئەوەیقەبارەی'"}, {"type": "whitespace", "original": "یەدەگەکە بۆ", "error": "یەدەگەکەبۆ", "start": 70, "end": 81, "description": "whitespace: 'یەدەگەکە بۆ' → 'یەدەگەکەبۆ'"}, {"type": "whitespace", "original": "هەڵاوسان", "