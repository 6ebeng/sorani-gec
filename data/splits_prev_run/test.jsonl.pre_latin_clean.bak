{"original": "ئیلەام دەستی هەڵبڕی لە جیاتی گروپەکەی خۆی کە ناوی (تیمی فریاکەوتن)ە، بۆ ئەوەی وەڵامی پرسیاری دووەم بداتەوە، گوتی: بە هاوکاری‌و هاوسۆزی لە نێوانماندا کارەکەمان ئەنجام دا‌و ئەمەش وای کرد ئەرکەکە بە ماوەیەکی کورت ئەنجام بدەین.", "corrupted": "ئیلەام دەستی هەڵبڕی ڵە جیاتی گروپەکەی خۆی کە ناوی (طیمی فریاکەوتن)ە، بۆ ئەوەی وەڵامی پرسیاری دووەم بداطەوە، گوتی: بە هاوکاری‌و هاوسۆزی لە نێوانماندا کارەکەمان ئەنجام دا‌و ئەمەش وای کرد ئەرکەکە بە ماوەیەکی کورت ئەنجام بدەین.", "source": "ئیلەام دەستی هەڵبڕی ڵە جیاتی گروپەکەی خۆی کە ناوی (طیمی فریاکەوتن)ە، بۆ ئەوەی وەڵامی پرسیاری دووەم بداطەوە، گوتی: بە هاوکاری‌و هاوسۆزی لە نێوانماندا کارەکەمان ئەنجام دا‌و ئەمەش وای کرد ئەرکەکە بە ماوەیەکی کورت ئەنجام بدەین.", "target": "ئیلەام دەستی هەڵبڕی لە جیاتی گروپەکەی خۆی کە ناوی (تیمی فریاکەوتن)ە، بۆ ئەوەی وەڵامی پرسیاری دووەم بداتەوە، گوتی: بە هاوکاری‌و هاوسۆزی لە نێوانماندا کارەکەمان ئەنجام دا‌و ئەمەش وای کرد ئەرکەکە بە ماوەیەکی کورت ئەنجام بدەین.", "errors": [{"type": "spelling_confusion", "original": "بداتەوە،", "error": "بداطەوە،", "start": 99, "end": 107, "description": "spelling_confusion: 'بداتەوە،' → 'بداطەوە،'"}, {"type": "spelling_confusion", "original": "(تیمی", "error": "(طیمی", "start": 50, "end": 55, "description": "spelling_confusion: '(تیمی' → '(طیمی'"}, {"type": "spelling_confusion", "original": "لە", "error": "ڵە", "start": 20, "end": 22, "description": "spelling_confusion: 'لە' → 'ڵە'"}], "source_id": "8820", "category": "islamic_studies"}
{"original": "هەندێک لە ڕووداوەکان بۆ دانیشتوانی ئەم سەردەمە وەکو ڕوودانی سەرچاوەی رەشبینی بوون، هەر کاتێک هەستی بە مەترسیەکی وا دەکرد، یەکسەر دەبوایە لەبەر چاوان ون بکرێت، بۆ ماوەی مانگێک تا ۳ مانگ. لەم ماوەیە جێگرێکیان بۆ دادەنا.", "corrupted": "هەندێک لە ڕووداوەکان بۆ دانیشتوانی ئەم سەردەمە وەکو ڕوودانی سەرچاوەی رەشبینی بوون، هەر کاتێک هەستی بە مەترسیەکی وا دەکرد، یەکسەر دەبوایە لەبەر چاوان ون بکرێت، بۆ ماوەی مانگێک تا ۳ مانگ. لەم ماوەیە جێگرێکیان بۆ دادەنا.", "source": "هەندێک لە ڕووداوەکان بۆ دانیشتوانی ئەم سەردەمە وەکو ڕوودانی سەرچاوەی رەشبینی بوون، هەر کاتێک هەستی بە مەترسیەکی وا دەکرد، یەکسەر دەبوایە لەبەر چاوان ون بکرێت، بۆ ماوەی مانگێک تا ۳ مانگ. لەم ماوەیە جێگرێکیان بۆ دادەنا.", "target": "هەندێک لە ڕووداوەکان بۆ دانیشتوانی ئەم سەردەمە وەکو ڕوودانی سەرچاوەی رەشبینی بوون، هەر کاتێک هەستی بە مەترسیەکی وا دەکرد، یەکسەر دەبوایە لەبەر چاوان ون بکرێت، بۆ ماوەی مانگێک تا ۳ مانگ. لەم ماوەیە جێگرێکیان بۆ دادەنا.", "errors": [], "source_id": "5414", "category": "history"}
