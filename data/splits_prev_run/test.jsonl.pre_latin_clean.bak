{"original": "پێغەمبەر لە ڕێگەی کۆچکردن بۆ مەدینە، کاتێک کە نزیک بوو لەم شارەو گەیشتە دێی کە دوو فەرسەخ لە مەدینەوە دوورە، لەوێدا لەگەڵ لایان داو چوار ڕۆژ تیایدا مانەوە، سەرەتا مزگەوتێکی دروست کرد کە بە مزگەوتی ناسراوە.", "corrupted": "پێغەمبەر لە ڕێگەی کۆچکردن بۆ مەدینە، کاتێک کە نزیک بوو لەم شارەو گەیشتە دێی کە دوو فەرسەخ لە مەدینەوە دوورە، لەوێدا لەگەڵ لایان داو چوار ڕۆژ تیایدا مانەوە، سەرەتا مزگەوتێکی دروسی کرد کە بە مزگەوتی ناسراوە.", "source": "پێغەمبەر لە ڕێگەی کۆچکردن بۆ مەدینە، کاتێک کە نزیک بوو لەم شارەو گەیشتە دێی کە دوو فەرسەخ لە مەدینەوە دوورە، لەوێدا لەگەڵ لایان داو چوار ڕۆژ تیایدا مانەوە، سەرەتا مزگەوتێکی دروسی کرد کە بە مزگەوتی ناسراوە.", "target": "پێغەمبەر لە ڕێگەی کۆچکردن بۆ مەدینە، کاتێک کە نزیک بوو لەم شارەو گەیشتە دێی کە دوو فەرسەخ لە مەدینەوە دوورە، لەوێدا لەگەڵ لایان داو چوار ڕۆژ تیایدا مانەوە، سەرەتا مزگەوتێکی دروست کرد کە بە مزگەوتی ناسراوە.", "errors": [{"type": "clitic_form", "original": "دروست", "error": "دروسی", "start": 173, "end": 178, "description": "clitic_form: 'دروست' → 'دروسی'"}], "source_id": "5226", "category": "social_sciences"}
